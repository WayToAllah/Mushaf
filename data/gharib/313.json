{"20:14":[[11,1,"لِذِكْرِي","لِتَذْكُرَنِي فِيهَا."]],"20:15":[[4,2,"أَكَادُ أُخْفِيهَا","أَقْرُبُ أَنْ أَسْتُرَهَا مِنْ نَفْسِي."]],"20:16":[[10,1,"فَتَرْدَى","فَتَهْلِكَ."]],"20:18":[[4,2,"أَتَوَكَّأُ عَلَيْهَا","أَعْتَمِدُ عَلَيْهَا فِي المَشْيِ."],[6,4,"وَأَهُشُّ بِهَا عَلَى غَنَمِي","أَهُزُّ بِهَا الشَّجَرَ؛ لِتَرْعَى غَنَمِي مَا يَتَسَاقَطُ مِنْ وَرَقِهِ."],[12,1,"مَآرِبُ","مَنَافِعُ، وَحَاجَاتٌ."]],"20:20":[[5,1,"تَسْعَى","تَمْشِي بِسُرْعَةٍ وَخِفَّةٍ."]],"20:21":[[6,1,"سِيرَتَهَا","حَالَتَهَا."]],"20:22":[[4,1,"جَنَاحِكَ","جَنْبِكَ تَحْتَ العَضُدِ."],[9,1,"سُوءٍ","بَرَصٍ."]],"20:27":[[1,2,"وَاحْلُلْ عُقْدَةً","أَطْلِقْ لِسَانِي بِفَصِيحِ المَنْطِقِ."]],"20:31":[[1,3,"اشْدُدْ بِهِ أَزْرِي","قَوِّنِي بِهِ، وَشُدَّ بِهِ ظَهْرِي."]],"20:32":[[3,1,"أَمْرِي","النُّبُوَّةِ."]]}