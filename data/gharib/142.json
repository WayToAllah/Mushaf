{"6:111":[[8,1,"وَحَشَرْنَا","جَمَعْنَا."],[12,1,"قُبُلًا","مُوَاجَهَةً."]],"6:112":[[13,2,"زُخْرُفَ الْقَوْلِ","القَوْلَ البَاطِلَ الَّذِي زَيَّنَهُ قَائِلُوهُ."],[15,1,"غُرُورًا","خِدَاعًا."],[23,1,"يَفْتَرُونَ","يَخْتَلِقُونَ مِنْ كَذِبٍ وَزُورٍ."]],"6:113":[[1,1,"وَلِتَصْغَى","لِتَمِيلَ."],[9,1,"وَلِيَقْتَرِفُوا","لِيَكْتَسِبُوا."]],"6:114":[[23,1,"الْمُمْتَرِينَ","الشَّاكِّينَ."]],"6:115":[[4,1,"صِدْقًا","فِي الأَخْبَارِ."],[5,1,"وَعَدْلًا","فِي الأَحْكَامِ."]],"6:116":[[18,1,"يَخْرُصُونَ","يَظُنُّونَ وَيَكْذِبُونَ."]]}