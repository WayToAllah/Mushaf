{"29:64":[[12,1,"الْحَيَوَانُ","الحَيَاةُ الحَقِيقِيَّةُ الكَامِلَةُ الدَّائِمَةُ."]],"29:65":[[4,1,"الْفُلْكِ","السُّفُنِ."]],"29:67":[[5,2,"حَرَمًا آمِنًا","هِيَ: مَكَّةُ."],[7,2,"وَيُتَخَطَّفُ النَّاسُ","يُسْتَلَبُونَ بِسُرْعَةٍ قَتْلًا وَأَسْرًا."]],"29:68":[[16,1,"مَثْوًى","مَسْكَنٌ وَمُسْتَقَرٌّ."]],"30:2":[[1,2,"غُلِبَتِ الرُّومُ","هَزَمَتْ فَارِسُ الرُّومَ."]],"30:3":[[2,2,"أَدْنَى الْأَرْضِ","أَقْرَبِ أَرْضِ الشَّامِ إِلَى فَارِسَ."],[7,1,"غَلَبِهِمْ","كَوْنِهِمْ مَغْلُوبِينَ."]],"30:4":[[2,2,"بِضْعِ سِنِينَ","البِضْعُ: مُدَّةٌ لَا تَزِيدُ عَلَى عَشْرِ سَنَوَاتٍ، وَلَا تَنْقُصُ عَنْ ثَلَاثٍ."]]}