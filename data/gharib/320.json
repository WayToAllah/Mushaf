{"20:114":[[1,1,"فَتَعَالَى","فَتَنَزَّهَ، وَارْتَفَعَ، وَتَقَدَّسَ عَنْ كُلِّ نَقْصٍ."]],"20:115":[[2,1,"عَهِدْنَا","وَصَّيْنَا."],[11,1,"عَزْمًا","حِفْظًا لِمَا أُمِرَ بِهِ."]],"20:118":[[6,2,"وَلَا تَعْرَى","لَا يُصِيبُكَ العُرْيُ."]],"20:119":[[5,2,"وَلَا تَضْحَى","لَا يُصِيبُكَ حَرُّ الشَّمْسِ."]],"20:120":[[12,2,"لَّا يَبْلَى","لَا يَنْقَضِي، وَلَا يَنْقَطِعُ."]],"20:121":[[5,1,"سَوْآتُهُمَا","عَوْرَاتُهُمَا."],[6,1,"وَطَفِقَا","أَخَذَا."],[7,1,"يَخْصِفَانِ","يُلْصِقَانِ."]],"20:122":[[2,1,"اجْتَبَاهُ","اصْطَفَاهُ."]],"20:124":[[8,1,"ضَنْكًا","ضَيِّقَةً شَاقَّةً."]]}