{"61:6":[[13,3,"لِّمَا بَيْنَ يَدَيَّ","لِمَا جَاءَ قَبْلِي."],[27,1,"بِالْبَيِّنَاتِ","بِالآيَاتِ الوَاضِحَاتِ."]],"61:7":[[1,2,"وَمَنْ أَظْلَمُ","لَا أَحَدَ أَشَدُّ ظُلْمًا، وَعُدْوَانًا."],[4,1,"افْتَرَى","اخْتَلَقَ."],[9,3,"يُدْعَى إِلَى الْإِسْلَامِ","يُدْعَى إِلَى الدُّخُولِ فِي الإِسْلَامِ."]],"61:8":[[3,2,"نُورَ اللَّهِ","الحَقَّ الَّذِي جَاءَ بِهِ الرَّسُولُ - صلى الله عليه وسلم -."],[5,1,"بِأَفْوَاهِهِمْ","بِأَقْوَالِهِمُ الكَاذِبَةِ."],[7,2,"مُتِمُّ نُورِهِ","مُظْهِرٌ الحَقَّ بِإِتْمَامِ دِينِهِ."]],"61:9":[[8,1,"لِيُظْهِرَهُ","لِيُعْلِيَهُ."],[10,2,"الدِّينِ كُلِّهِ","الأَدْيَانِ المُخَالِفَةِ كُلِّهَا."]],"61:13":[[1,1,"وَأُخْرَى","وَنِعْمَةٌ أُخْرَى لَكُمْ."]],"61:14":[[12,1,"لِلْحَوَارِيِّينَ","أَصْفِيَاءِ عِيسَى - عليه السلام -، وَخَوَاصِّهِ."],[29,1,"فَأَيَّدْنَا","قَوَّيْنَا، وَنَصَرْنَا."],[35,1,"ظَاهِرِينَ","غَالِبِينَ."]]}