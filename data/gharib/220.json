{"10:98":[[1,1,"فَلَوْلَا","فَهَلَّا."],[15,1,"الخِزْيِ","الذُّلِّ وَالهَوَانِ."]],"10:100":[[10,1,"الرِّجْسَ","العَذَابَ."]],"10:101":[[7,2,"وَمَا تُغْنِي","لَا تَنْفَعُ."]],"10:102":[[7,1,"خَلَوْا","مَضَوْا."]],"10:105":[[2,3,"أَقِمْ وَجْهَكَ لِلدِّينِ","أَقِمْ نَفْسَكَ عَلَى الإِسْلَامِ مُسْتَقِيمًا عَلَيْهِ."],[5,1,"حَنِيفًا","مَائِلًا عَنِ الشِّرْكِ إِلَى التَّوْحِيدِ."]]}