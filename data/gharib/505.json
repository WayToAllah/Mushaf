{"46:21":[[2,2,"أَخَا عَادٍ","هُوَ: هُودٌ - عليه السلام -."],[7,1,"بِالْأَحْقَافِ","اسْمُ مَوْقِعِهِمْ؛ وَهُوَ فِي جَنُوبِ جَزِيرَةِ العَرَبِ."],[9,2,"خَلَتِ النُّذُرُ","مَضَتِ الرُّسُلُ."]],"46:22":[[3,1,"لِتَافِكَنَا","لِتَصْرِفَنَا."]],"46:24":[[3,1,"عَارِضًا","سَحَابًا عَرَضًا فِي أُفُقِ السَّمَاءِ."]],"46:25":[[1,1,"تُدَمِّرُ","تُهْلِكُ."],[2,2,"كُلَّ شَيْءٍ","مَرَّتْ بِهِ مِمَّا أُرْسِلَتْ بِهَلَاكِهِ."]],"46:26":[[2,1,"مَكَّنَّاهُمْ","أَقْدَرْنَاهُمْ، وَبَسَطْنَا لَهُمْ."],[3,4,"فِيمَا إِن مَّكَّنَّاكُمْ فِيهِ","فيِ الَّذِي لَمْ نُمَكِّنْكُمْ فِيهِ."],[27,1,"وَحَاقَ","نَزَلَ."]],"46:27":[[7,2,"وَصَرَّفْنَا الْآيَاتِ","بَيَّنًا لَهُمْ أَنْوَاعَ الحُجَجِ، وَكَرَّرْنَاهَا لَهُمْ."]],"46:28":[[1,1,"فَلَوْلَا","هَلَّا."],[8,1,"قُرْبَانًا","يَتَقَرَّبُونَ بِهَا إِلَى رَبِّهِمْ."],[14,1,"إِفْكُهُمْ","كَذِبُهُمْ."],[17,1,"يَفْتَرُونَ","يَكْذِبُونَ."]]}