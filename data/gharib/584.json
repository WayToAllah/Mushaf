{"79:18":[[6,1,"تَزَكَّى","تَتَطَهَّرَ مِنَ الكُفْرِ، وَتَتَحَلَّى بِالإِيمَانِ."]],"79:19":[[1,1,"وَأَهْدِيَكَ","أُرْشِدَكَ."]],"79:20":[[2,2,"الْآيَةَ الْكُبْرَى","مُعْجِزَةَ العَصَا، وَاليَدَ البَيْضَاءَ."]],"79:22":[[3,1,"يَسْعَى","يَجْتَهِدُ فِي مُعَارَضَةِ مُوسَى - عليه السلام -."]],"79:23":[[1,1,"فَحَشَرَ","جَمَعَ أَهْلَ مَمْلَكَتِهِ."]],"79:25":[[3,1,"نَكَالَ","عُقُوبَةَ."]],"79:28":[[1,2,"رَفَعَ سَمْكَهَا","أَعْلَى سَقْفَهَا."]],"79:29":[[1,2,"وَأَغْطَشَ لَيْلَهَا","أَظْلَمَ لَيْلَهَا بِغُرُوبِ شَمْسِهَا."],[3,2,"وَأَخْرَجَ ضُحَاهَا","أَبْرَزَ نَهَارَهَا بِشُرُوقِ شَمْسِهَا."]],"79:30":[[4,1,"دَحَاهَا","بَسَطَهَا، وَأَوْدَعَ فِيهَا مَنَافِعَهَا."]],"79:31":[[4,1,"وَمَرْعَاهَا","مَا يُرْعَى مِنَ النَّبَاتِ."]],"79:32":[[2,1,"أَرْسَاهَا","أَثْبَتَهَا عَلَى الأَرْضِ؛ كَالْأَوْتَادِ."]],"79:34":[[3,1,"الطَّامَّةُ","القِيَامَةُ، وَهِيَ النَّفْخَةُ الثَّانِيَةُ."]],"79:36":[[1,1,"وَبُرِّزَتِ","أُظْهِرَتْ إِظْهَارًا بَيِّنًا."]],"79:39":[[4,1,"الْمَاوَى","المَصِيرُ."]],"79:40":[[4,2,"مَقَامَ رَبِّهِ","القِيَامَ بَيْنَ يَدَيْ رَبِّهِ لِلْحِسَابِ."]],"79:42":[[4,2,"أَيَّانَ مُرْسَاهَا","مَتَى وَقْتُ حُلُولِهَا؟"]],"79:43":[[1,4,"فِيمَ أَنتَ مِن ذِكْرَاهَا","لَيْسَ عِنْدَكَ عِلْمُهَا؛ حَتَّى تَذْكُرَهَا."]],"79:46":[[7,1,"عَشِيَّةً","مَا بَيْنَ الظُّهْرِ إِلَى غُرُوبِ الشَّمْسِ."],[9,1,"ضُحَاهَا","مَا بَيْنَ طُلُوعِ الشَّمْسِ إِلَى نِصْفِ النَّهَارِ."]]}