{"21:45":[[3,1,"أُنذِرُكُم","أُخَوِّفُكُمْ."]],"21:46":[[3,1,"نَفْحَةٌ","نَصِيبٌ يَسِير."]],"21:47":[[3,1,"الْقِسْطَ","ذَوَاتِ العَدْلِ."],[12,2,"مِثْقَالَ حَبَّةٍ","العَادِلَ أَوْ وَزْنَ ذَرَّةٍ."]],"21:48":[[5,1,"الْفُرْقَانَ","التَّوْرَاةَ الفَارِقَةَ بَيْنَ الحَقِّ وَالبَاطِلِ."]],"21:51":[[4,1,"رُشْدَهُ","هُدَاهُ."]],"21:52":[[7,1,"التَّمَاثِيلُ","الأَصْنَامُ الَّتِي صَنَعْتُمُوهَا."],[11,1,"عَاكِفُونَ","مُقِيمُونَ عَلَى عِبَادَتِهَا، مُلَازِمُونَ لَهَا."]],"21:56":[[8,1,"فَطَرَهُنَّ","خَلَقَهُنَّ."]],"21:57":[[2,1,"لَأَكِيدَنَّ","لَأَمْكُرَنَّ، وَأُكَسِّرَنَّ."],[7,1,"مُدْبِرِينَ","ذَاهِبِينَ."]]}