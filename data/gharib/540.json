{"57:19":[[7,1,"الصِّدِّيقُونَ","المُبَالِغُونَ فِي التَّصْدِيقِ."],[8,1,"وَالشُّهَدَاءُ","الَّذِينَ قُتِلُوا فِي سَبِيلِ اللهِ."]],"57:20":[[5,1,"لَعِبٌ","تَلْعَبُ بِهَا الأَبْدَانُ."],[6,1,"وَلَهْوٌ","تَلْهُو بِهَا القُلُوبُ."],[17,1,"الْكُفَّارَ","الزُّرَّاعَ، سُمُّوا بِذَلِكَ؛ لِأَنَّهُمْ يَسْتُرُونَ الحَبَّ فيِ التُّرَابِ."],[20,1,"يَهِيجُ","يَيْبَسُ."],[25,1,"حُطَامًا","فُتَاتًا مُتَهَشِّمًا."]],"57:21":[[1,1,"سَابِقُوا","سَارِعُوا مُسَارَعَةَ المُتَسَابِقِينَ فيِ المِضْمَارِ."]],"57:22":[[12,1,"كِتَابٍ","هُوَ: اللَّوْحُ المَحْفُوظُ."],[16,1,"نَّبْرَأَهَا","نَخْلُقَ هَذِهِ المَخْلُوقَاتِ."]],"57:23":[[2,1,"تَاسَوْا","تَحْزَنُوا."],[7,1,"تَفْرَحُوا","فَرَحَ بَطَرٍ، وَاخْتِيَالٍ."],[14,1,"مُخْتَالٍ","مُتَكَبِّرٍ."],[15,1,"فَخُورٍ","مُتَطَاوِلٍ بِهِ يَفْخَرُ عَلَى النَّاسِ."]],"57:24":[[12,1,"الْحَمِيدُ","المَحْمُودُ عَلَى كَمَالِ صِفَاتِهِ، وَجَمِيلِ فِعَالِهِ."]]}