{"39:48":[[6,1,"وَحَاقَ","أَحَاطَ بِهِمْ مِنْ كُلِّ جَانِبٍ."]],"39:49":[[8,1,"خَوَّلْنَاهُ","أَعْطَيْنَاهُ، وَمَنَحْنَاهُ."],[18,1,"فِتْنَةٌ","ابْتِلَاءٌ وَاخْتِبَارٌ."]],"39:51":[[15,1,"بِمُعْجِزِينَ","بِفَائِتِينَ اللهَ، وَلَا سَابِقِيهِ."]],"39:52":[[5,1,"يَبْسُطُ","يُوسِعُ."],[9,1,"وَيَقْدِرُ","يُضَيِّقُ."]],"39:53":[[4,1,"أَسْرَفُوا","تَجَاوَزُوا الحَدَّ فِي المَعَاصِي."],[7,2,"لَا تَقْنَطُوا","لَا تَيْئَسُوا."]],"39:54":[[1,1,"وَأَنِيبُوا","ارْجِعُوا إِلَى اللهِ بِالتَّوْبَةِ، وَالطَّاعَةِ."],[4,1,"وَأَسْلِمُوا","اخْضَعُوا، وَانْقَادُوا."]],"39:55":[[13,1,"بَغْتَةً","فَجْأَةً."]],"39:56":[[4,2,"يَا حَسْرَتَى","يَا نَدَامَتِي."],[7,1,"فَرَّطتُ","ضَيَّعْتُ."],[9,2,"جَنبِ اللَّهِ","طَاعَتِهِ، وَحَقِّهِ."],[14,1,"السَّاخِرِينَ","المُسْتَهْزِئِينَ."]]}