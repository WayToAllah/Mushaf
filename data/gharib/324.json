{"21:30":[[9,1,"رَتْقًا","مُلْتَصِقَتَيْنِ."],[10,1,"فَفَتَقْنَاهُمَا","فَفَصَلْنَاهُمَا بِقُدْرَتِنَا."]],"21:31":[[4,1,"رَوَاسِيَ","جِبَالًا تُثَبِّتُهَا."],[5,2,"أَن تَمِيدَ","لِئَلَّا تَضْطَرِبَ."],[10,2,"فِجَاجًا سُبُلًا","طُرُقًا وَاسِعَةً مَسْلْوكَةً."]],"21:32":[[3,2,"سَقْفًا مَّحْفُوظًا","لَا تَسْقُطُ، وَلَا تَخْتَرِقُهَا الشَّيَاطِينُ."]],"21:33":[[9,3,"فِي فَلَكٍ يَسْبَحُونَ","فِي مَدَارٍ يَجْرِي فِيهِ لَا يَحِيدُ عَنْهُ."]],"21:35":[[5,1,"وَنَبْلُوكُم","نَخْتَبِرُكُمْ مَعَ عِلْمِنَا بِحَالِكُمْ."]]}