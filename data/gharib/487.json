{"42:32":[[3,1,"الْجَوَارِ","السُّفُنُ الجَارِيَةُ."],[6,1,"كَالْأَعْلَامِ","كَالجِبَالِ فِي عِظَمِهَا."]],"42:33":[[5,1,"فَيَظْلَلْنَ","يَصِرْنَ وَيَبْقَيْنَ."],[6,1,"رَوَاكِدَ","ثَوَابِتَ لَا تَجْرِي."]],"42:34":[[2,1,"يُوبِقْهُنَّ","يُهْلِكِ السُّفُنَ بِالغَرَقِ."]],"42:35":[[9,1,"مَّحِيصٍ","مَهْرَبٍ، وَمَلْجَأٍ."]],"42:37":[[5,1,"وَالْفَوَاحِشَ","مَا عَظُمَ قُبْحُهُ مِنَ المَعَاصِي."]],"42:39":[[4,1,"الْبَغْيُ","الظُّلْمُ، وَالعُدْوَانُ."],[6,1,"يَنتَصِرُونَ","يَنْتَقِمُونَ مِمَّنْ بَغَى عَلَيْهِمْ؛ لِشَجَاعَتِهِمْ، وَلَا يَعْتَدُونَ."]],"42:40":[[7,1,"وَأَصْلَحَ","وَضَعَ عَفْوَهُ فِيمَنْ يُصْلِحُهُ العَفْوُ."]],"42:41":[[9,1,"سَبِيلٍ","مُؤَاخَذَةٍ."]],"42:42":[[2,1,"السَّبِيلُ","المُؤَاخَذَةُ."],[7,1,"وَيَبْغُونَ","يَعْتَدُونَ."]],"42:43":[[7,2,"عَزْمِ الْأُمُورِ","الأَفْعَالِ الحَمِيدَةِ، وَالخِصَالِ المَشْكُورَةِ."]],"42:44":[[2,2,"يُضْلِلِ اللَّهُ","يَصْرِفْهُ عَنِ الهُدَى."],[18,1,"مَرَدٍّ","مَرْجِعٍ إِلَى الدُّنْيَا."],[20,1,"سَبِيلٍ","طَرِيقٍ."]]}