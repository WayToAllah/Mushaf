{"52:32":[[3,1,"أَحْلَامُهُم","عُقُولُهُمْ."],[8,1,"طَاغُونَ","مُتَجَاوِزُونَ الحَدَّ فِي العِصْيَانِ."]],"52:33":[[3,1,"تَقَوَّلَهُ","اخْتَلَقَ القُرْآنَ مِنْ عِنْدِ نَفْسِهِ."]],"52:37":[[3,2,"خَزَائِنُ رَبِّكَ","خَزَائِنُ رِزْقِهِ وَرَحْمَتِهِ."],[7,1,"الْمُصَيْطِرُونَ","المُتَسَلِّطُونَ، الجَبَّارُونَ."]],"52:38":[[3,1,"سُلَّمٌ","مِصْعَدٌ إِلَى السَّمَاءِ."],[8,2,"بِسُلْطَانٍ مُّبِينٍ","بِحُجَّةٍ بَيِّنَةٍ تُصَدِّقُ دَعْوَاهُ."]],"52:40":[[5,2,"مِّن مَّغْرَمٍ","مِنِ الْتِزَامِ غَرَامَةٍ تَطْلُبُهَا مِنْهُمْ."],[7,1,"مُّثْقَلُونَ","مُتْعَبُونَ، مُجْهَدُونَ."]],"52:42":[[3,1,"كَيْدًا","مَكْرًا."],[7,1,"الْمَكِيدُونَ","يَرْجِعُ مَكْرُهُمْ عَلَى أَنْفُسِهِمْ."]],"52:44":[[3,1,"كِسْفًا","قِطَعًا."],[9,1,"مَّرْكُومٌ","مُتَرَاكِمٌ بَعْضُهُ فَوْقَ بَعْضٍ."]],"52:45":[[7,1,"يُصْعَقُونَ","يُهْلَكُونَ."]],"52:46":[[2,3,"لَا يُغْنِي عَنْهُمْ","لَا يَدْفَعُ عَنْهُمْ."]],"52:47":[[5,2,"دُونَ ذَلِكَ","قَبْلَ ذَلِكَ يَقَعُ فِي الدُّنْيَا عَلَيْهِمْ."]],"52:48":[[5,1,"بِأَعْيُنِنَا","بِمَرْأًى مِنَّا، وَحِفْظٍ، وَاعْتِنَاءٍ؛ وَفِيهِ: إِثْبَاتُ صِفَةِ العَيْنَيْنِ للهِ؛ كَمَا يَلِيقُ بِهِ؛ بِلَا تَكْيِيفٍ، وَلَا تَمْثِيلٍ، وَجَاءَتْ بِصِيغَةِ الجَمْعِ لِلتَّعْظِيمِ."],[6,3,"وَسَبِّحْ بِحَمْدِ رَبِّكَ","نَزِّه رَبَّكَ، حَامِدًا لَهُ."],[9,2,"حِينَ تَقُومُ","لِلصَّلَاةِ، وَمِنْ نَوْمِكَ."]],"52:49":[[3,1,"فَسَبِّحْهُ","نَزِّهْهُ، وَعَظِّمْهُ، وَصَلِّ لَهُ."],[4,2,"وَإِدْبَارَ النُّجُومِ","نَزِّهْهُ، وَصَلِّ لَهُ صَلَاةَ الصُّبْحِ وَقْتَ غَيْبَةِ النُّجُومِ."]]}