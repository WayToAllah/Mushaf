{"20:39":[[7,1,"الْيَمِّ","نَهْرِ النِّيلِ."]],"20:40":[[9,1,"يَكْفُلُهُ","يُرَبِّيهِ، وَيُرْضِعُهُ."],[14,2,"تَقَرَّ عَيْنُهَا","تَطِيبُ نَفْسُهَا."],[23,2,"وَفَتَنَّاكَ فُتُونًا","ابْتَلَيْنَاكَ ابْتِلَاءً."],[32,2,"عَلَى قَدَرٍ","عَلَى وَفْقِ الوَقْتِ المُقَدَّرِ لِإرْسَالِكَ."]],"20:41":[[1,2,"وَاصْطَنَعْتُكَ لِنَفْسِي","اصْطَفَيْتُكَ لِرِسَالَتِي."]],"20:42":[[5,2,"وَلَا تَنِيَا","لَا تَفْتُرَا وَلَا تَضْعُفَا."]],"20:45":[[6,2,"يَفْرُطَ عَلَيْنَا","يُعَاجِلَنَا بِالعُقُوبَةِ."]],"20:50":[[7,1,"خَلْقَهُ","صُورَتَهُ اللَّائِقَةَ بِخَاصَّتِهِ وَمَنْفَعَتِهِ."]],"20:51":[[4,2,"الْقُرُونِ الْأُولَى","الأُمَمِ المَاضِيَةِ."]]}