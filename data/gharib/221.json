{"11:1":[[6,1,"فُصِّلَتْ","بُيِّنَتْ بِالأَمْرِ وَالنَّهْيِ."]],"11:3":[[5,1,"تُوبُوا","ارْجِعُوا إِلَيْهِ نَادِمِينَ."]],"11:5":[[3,2,"يَثْنُونَ صُدُورَهُمْ","يُضْمِرُونَ فِي صُدُورِهِمُ الكُفْرَ."],[5,2,"لِيَسْتَخْفُوا مِنْهُ","لِيَسْتَتِرُوا مِنَ اللهِ."],[9,2,"يَسْتَغْشُونَ ثِيَابَهُمْ","يَتَغَطَّوْنَ بِثِيَابِهِمْ."]]}