{"15:91":[[4,1,"عِضِينَ","أَجْزَاءَ، فَقَالَ بَعْضُهُمْ: سِحْرٌ، وَقَالَ بَعْضُهُمْ: كِهَانَةٌ، وَغَيْرَ ذَلِكَ."]],"15:94":[[1,1,"فَاصْدَعْ","فَاجْهَرْ."]],"15:98":[[6,1,"السَّاجِدِينَ","العَابِدِينَ، المُصَلِّينَ."]],"15:99":[[5,1,"الْيَقِينُ","المَوْتُ."]],"16:1":[[2,2,"أَمْرُ اللهِ","قِيَامُ السَّاعَةِ."]],"16:2":[[3,1,"بِالْرُّوحِ","بِالوَحْيِ."]],"16:4":[[7,1,"خَصِيمٌ","شَدِيدُ الخُصُومَةِ."]],"16:6":[[5,1,"تُرِيحُونَ","تَرُدُّونَهَا إِلَى مَبَارِكِهَا وَحَظَائِرِهَا فِي المَسَاءِ."],[7,1,"تَسْرَحُونَ","تُخْرِجُونَهَا لِلْمَرْعَى فِي الصَّبَاحِ."]]}