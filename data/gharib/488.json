{"42:45":[[4,1,"خَاشِعِينَ","خَاضِعِينَ مُتَضَائِلِينَ."],[7,4,"يَنظُرُونَ مِن طَرْفٍ خَفِيٍّ","يُسَارِقُونَ النَّظَرَ، وَلَا يَنْظُرُونَ بِمِلْءِ أَعْيُنِهمْ."]],"42:46":[[13,4,"فَمَا لَهُ مِن سَبِيلٍ","مَا لَهُ مِنْ طَرِيقٍ يَصِلُ بِهِ إِلَى الحَقِّ فِي الدُّنْيَا."]],"42:47":[[8,3,"لَّا مَرَدَّ لَهُ","لَا يُمْكِنُ رَدُّهُ."],[21,1,"نَّكِيرٍ","لَا تُنْكِرُونَ ذُنُوبَكُمْ، وَلَيْسَ لَكُمْ مَكَانٌ تَسْتَخْفُونَ وَتَتَنَكَّرُونَ فِيهِ."]],"42:48":[[6,1,"حَفِيظًا","حَافِظًا لِأَعْمَالِهِمْ."],[27,1,"كَفُورٌ","جَحُودٌ؛ يُعَدِّدُ المَصَائِبَ، وَيَنْسَى النِّعَمَ."]],"42:50":[[2,1,"يُزَوِّجُهُمْ","يَجْمَعُ لَهُ النَّوْعَيْنِ."],[8,1,"عَقِيمًا","لَا يُولَدُ لَهُ."]],"42:51":[[8,1,"وَحْيًا","إِعْلَامًا فِي المَنَام، أَوْ بِالإِلْهَامِ."],[10,3,"مِن وَرَاءِ حِجَابٍ","كَمَا كَلَّمَ مُوسَى - عليه السلام -."],[15,1,"رَسُولًا","هُوَ: جِبْرِيلُ - عليه السلام -."]]}