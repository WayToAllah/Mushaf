{"29:53":[[4,2,"أَجَلٌ مُّسَمًّى","وَقْتُ عَذَابِهِمُ المُقَدَّرُ عِنْدَ اللهِ."],[9,1,"بَغْتَةً","فَجْأَةً."]],"29:55":[[2,1,"يَغْشَاهُمُ","يُحِيطُ بِهِمْ وَيَعْلُوهُمْ."]],"29:58":[[5,1,"لَنُبَوِّئَنَّهُم","لِنُنْزِلَنَّهُمْ."],[8,1,"غُرَفًا","مَنَازِلَ عَالِيَةً."]],"29:60":[[1,2,"وَكَأَيِّن مِّن","وَكَمْ مِنْ؟"],[4,3,"لَا تَحْمِلُ رِزْقَهَا","لَا تَدَّخِرُهُ لِغَدٍ."]],"29:61":[[12,2,"فَأَنَّى يُؤْفَكُونَ","فَكَيْفَ يُصْرَفُونَ عَنِ الإِيمَانِ؟"]],"29:62":[[2,1,"يَبْسُطُ","يُوَسِّعُ."],[8,1,"وَيَقْدِرُ","يُضَيِّقُ."]]}