{"6:95":[[3,2,"فَالِقُ الْحَبِّ","الَّذِي يَشُقُّ الْحَبَّ، فَيَخْرُجُ الزَّرْعُ مِنْهُ."],[17,1,"تُؤْفَكُونَ","تُصْرَفُونَ عَنِ الْحَقِّ."]],"6:96":[[1,2,"فَالِقُ الإِصْبَاحِ","الَّذِي يَشُقُّ ضِيَاءَ الصُّبْحِ."],[8,1,"حُسْبَانًا","بِحِسَابٍ مُقَدَّرٍ."]],"6:98":[[7,1,"فَمُسْتَقَرٌّ","رَحِمُ المَرْأَةِ، تَسْتَقِرُّ فِيهِ النُّطْفَةُ."],[8,1,"وَمُسْتَوْدَعٌ","صُلْبُ الرَّجُلِ، تُحْفَظُ فِيهِ النُّطْفَةُ."]],"6:99":[[14,1,"خَضِرًا","زَرْعًا، وَشَجَرًا أَخْضَرَ."],[18,1,"مُّتَرَاكِبًا","يَرْكَبُ بَعْضُهُ فَوْقَ بَعْضٍ."],[22,1,"طَلْعِهَا","مَا تَنْشَأُ فِيهِ عُذُوقُ الرُّطَبِ."],[23,2,"قِنْوَانٌ دَانِيَةٌ","عُذُوقٌ قَرِيبَةُ التَّنَاوُلِ."],[38,1,"وَيَنْعِهِ","نُضْجِهِ، وَبُلُوغِهِ حِينَ يَبْلُغُ."]],"6:100":[[6,1,"وَخَرَقُوا","اخْتَلَقُوا وَافْتَرَوْا لَهُ سُبْحَانَهُ."]],"6:101":[[1,1,"بَدِيعُ","خَالِقُ، وَمُبْدِعُ."]]}