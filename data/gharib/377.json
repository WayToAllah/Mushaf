{"27:4":[[10,1,"يَعْمَهُونَ","يَتَرَدَّدُونَ فِي أَعْمَالِهِمُ القَبِيحَةِ مُتَحَيِّرِينَ."]],"27:6":[[2,1,"لَتُلَقَّى","لَتَتَلَقَّى."],[4,2,"مِن لَّدُنْ","من عِنْدِ."]],"27:7":[[6,1,"آنَسْتُ","أَبْصَرْتُ."],[13,2,"بِشِهَابٍ قَبَسٍ","بِشُعْلَةِ نَارٍ."],[16,1,"تَصْطَلُونَ","تَسْتَدْفِئُونَ بِهَا مِنَ البَرْدِ."]],"27:8":[[5,1,"بُورِكَ","قُدِّسَ وَطُهِّرَ."],[11,2,"وَسُبْحَانَ اللَّهِ","تَنْزِيهًا للِه عَمَّا لَا يَلِيقُ بِهِ."]],"27:10":[[5,1,"تَهْتَزُّ","تَتَحَرَّكُ فِي خِفَّةٍ."],[7,1,"جَانٌّ","حَيَّةٌ خَفِيفَةٌ."],[9,1,"مُدْبِرًا","هَارِبًا."],[11,1,"يُعَقِّبْ","يَرْجِعْ عَلَى عَقِبِهِ."]],"27:11":[[1,3,"إِلَّا مَنْ ظَلَمَ","لَكِنْ مَنْ ظَلَمَ نَفْسَهُ."]],"27:12":[[4,1,"جَيْبِكَ","فَتْحَةِ القَمِيصِ الَّتِي يَدْخُلُ مِنْهَا الرَّاسُ."],[7,3,"مِنْ غَيْرِ سُوءٍ","مِنْ غَيْرِ بَرَصٍ وَلَا مَرَضٍ."]],"27:13":[[3,1,"آيَاتُنَا","مُعْجِزَاتُنَا."],[4,1,"مُبْصِرَةً","ظَاهِرَةً بَيِّنَةً."],[8,1,"مُّبِينٌ","وَاضِحٌ بَيِّنٌ."]]}