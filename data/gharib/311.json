{"19:77":[[1,1,"أَفَرَأَيْتَ","أَعَلِمْتَ؟"]],"19:79":[[5,2,"وَنَمُدُّ لَهُ","نَزِيدُ لَهُ."]],"19:81":[[8,1,"عِزًّا","شُفَعَاءَ، وَأَنْصَارًا."]],"19:83":[[8,2,"تَؤُزُّهُمْ أَزًّا","تَدْفَعُهُمْ عَنِ الطَّاعَةِ، وَتُغْرِيهِمْ بِالمَعْصِيَةِ."]],"19:85":[[2,1,"نَحْشُرُ","نَجْمَعُ."],[6,1,"وَفْدًا","وُفُودًا مُكْرَمِينَ عَلَى الرِّكَابِ وَالرَّوَاحِلِ."]],"19:86":[[5,1,"وِرْدًا","مُشِاةً عِطَاشًا."]],"19:89":[[4,1,"إِدًّا","شَيْئًا عَظِيمًا مُنْكَرًا."]],"19:90":[[3,1,"يَتَفَطَّرْنَ","يَتَشَقَّقْنَ."],[7,3,"وَتَخِرُّ الْجِبَالُ هَدًّا","تَسْقُطُ سُقُوطًا شَدِيدًا."]],"19:92":[[1,2,"وَمَا يَنبَغِي","مَا يَلِيقُ، وَمَا يَصْلُحُ."]]}