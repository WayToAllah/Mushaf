{"43:61":[[2,2,"لَعِلْمٌ لِّلسَّاعَةِ","إِنَّ نُزُولَ عِيسَى - عليه السلام - لَدَلِيلٌ عَلَى قُرْبِ وُقُوعِ السَّاعَةِ."],[4,2,"فَلَا تَمْتَرُنَّ","لَا تَشُكُّوا."],[9,2,"صِرَاطٌ مُّسْتَقِيمٌ","طَرِيقٌ قَوِيمٌ إِلَى الجَنَّةِ لَا عِوَجَ فِيهِ."]],"43:63":[[8,1,"بِالْحِكْمَةِ","بِالنُّبُوَّةِ."]],"43:65":[[2,1,"الْأَحْزَابُ","الفِرَقُ."],[5,1,"فَوَيْلٌ","هَلَاكٌ، وَدَمَارٌ."]],"43:66":[[2,1,"يَنظُرُونَ","يَنْتَظِرُونَ."],[7,1,"بَغْتَةً","فَجْأَةً."]],"43:67":[[1,1,"الْأَخِلَّاءُ","الأَصْدِقَاءُ، وَالأَحْبَابُ."]],"43:70":[[5,1,"تُحْبَرُونَ","تُنْعَّمُونَ، وَتُسَرُّونَ."]],"43:71":[[3,1,"بِصِحَافٍ","بِأَوَانٍ."]]}