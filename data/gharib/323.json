{"21:11":[[1,2,"وَكَمْ قَصَمْنَا","كَثِيرًا أَهْلَكْنَا."]],"21:12":[[2,1,"أَحَسُّوا","رَأَوْا."],[3,1,"بَاسَنَا","عَذَابَنَا."],[7,1,"يَرْكُضُونَ","يُسِرِعُونَ هَارِبِينَ مِنَ العَذَابِ."]],"21:13":[[6,1,"أُتْرِفْتُمْ","نُعِّمْتُمْ فِيهِ فَبَطِرْتُمْ وَاسْتَكْبَرْتُمْ."]],"21:14":[[2,2,"يَا وَيْلَنَا","يَا هَلَاكَنَا."]],"21:15":[[7,1,"حَصِيدًا","كَالزَّرْعِ المَحْصُودِ."],[8,1,"خَامِدِينَ","مَيِّتِينَ."]],"21:18":[[2,2,"نَقْذِفُ بِالْحَقِّ","نَرْمِي بِهِ، وَنُبَيِّنُهُ فَنَرُدُّ بِهِ البَاطِلَ."],[6,1,"فَيَدْمَغُهُ","يَمْحَقُهُ، وَيَدْحَضُهُ."],[9,1,"زَاهِقٌ","ذَاهِبٌ، مُضْمَحِلٌّ."],[11,1,"الْوَيْلُ","العَذَابُ."]],"21:19":[[12,2,"وَلَا يَسْتَحْسِرُونَ","لَا يَمَلُّونَ."]],"21:20":[[4,2,"لَا يَفْتُرُونَ","لَا يَضْعُفُونَ، وَلَا يَسْأَمُونَ."]],"21:21":[[6,2,"هُمْ يُنشِرُونَ","هُمْ يُحْيُونَ المَوْتَى؟ كَلَّا!"]],"21:22":[[5,3,"إِلَّا اللَّهُ لَفَسَدَتَا","غَيْرُ اللهِ لَاخْتَلَّ نِظَامُهُمَا، وخَرِبَتَا؛ لِحُصُولِ التَّنَازُع."],[8,2,"فَسُبْحَانَ اللَّهِ","تَنَزَّهَ، وَتَقَدَّسَ."]],"21:24":[[10,3,"ذِكْرُ مَن مَّعِيَ","القُرْآنُ."],[13,3,"وَذِكْرُ مَن قَبْلِي","الكُتُبُ السَّابِقَةُ."]]}