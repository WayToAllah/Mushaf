{"19:26":[[3,2,"وَقَرِّي عَيْنًا","وَطِيبِي نَفْسًا."]],"19:27":[[10,1,"فَرِيًّا","أَمْرًا عَظِيمًا مُفْتَرًى."]],"19:28":[[11,1,"بَغِيًّا","زَانِيَةً."]],"19:31":[[2,1,"مُبَارَكًا","عَظِيمَ الخَيْرِ وَالنَّفْعِ."]],"19:34":[[9,1,"يَمْتَرُونَ","يَشُكُّونَ."]],"19:37":[[2,1,"الْأَحْزَابُ","الفِرَقُ مِنْ أَهْلِ الكِتَابِ."],[5,1,"فَوَيْلٌ","فَهَلَاكٌ."],[9,1,"مَّشْهَدِ","شُهُودِ."]],"19:38":[[1,3,"أَسْمِعْ بِهِمْ وَأَبْصِرْ","مَا أَشَدَّ سَمْعَهُمْ وَبَصَرَهُمْ!"]]}