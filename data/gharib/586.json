{"80:41":[[1,1,"تَرْهَقُهَا","تَغْشَاهَا."],[2,1,"قَتَرَةٌ","ذِلَّةٌ، وَظُلْمَةٌ."]],"80:42":[[3,1,"الْكَفَرَةُ","الجَاحِدُونَ بِقُلُوبِهِمْ."],[4,1,"الْفَجَرَةُ","العُصَاةُ بِأَعْمَالِهِمْ."]],"81:1":[[3,1,"كُوِّرَتْ","لُفَّتْ، وَذَهَبَ ضَوْؤُهَا."]],"81:2":[[3,1,"انكَدَرَتْ","تَنَاثَرَتْ، وَذَهَبَ نُورُهَا."]],"81:3":[[3,1,"سُيِّرَتْ","أُزِيلَتْ عَنْ وَجْهِ الأَرْضِ؛ فَصَارَتْ هَبَاءً مَنْثُورًا."]],"81:4":[[2,1,"الْعِشَارُ","النُّوقُ الحَوَامِلُ."],[3,1,"عُطِّلَتْ","أُهْمِلَتْ، وَتُرِكَتْ."]],"81:5":[[3,1,"حُشِرَتْ","جُمِعَتْ، وَاخْتَلَطَتْ؛ لِيُقْتَصَّ لِبَعْضِهَا مِنْ بَعْضٍ."]],"81:6":[[3,1,"سُجِّرَتْ","مُلِئَتْ حَتَّى خَاضَتْ، فَانْفَجَرَت، ثُمَّ اتَّقَدَتْ نِيرَانًا."]],"81:7":[[3,1,"زُوِّجَتْ","قُرِنَتْ بِأَمْثَالِهَا وَنَظَائِرِهَا."]],"81:8":[[2,1,"الْمَوْؤُودَةُ","الطِّفْلَةُ المَدْفُونَةُ حَيَّةً."]],"81:10":[[2,1,"الصُّحُفُ","صُحُفُ الأَعْمَالِ."],[3,1,"نُشِرَتْ","فُتِحَتْ، وَبُسِطَتْ."]],"81:11":[[3,1,"كُشِطَتْ","قُلِعَتْ، وَأُزِيلَتْ."]],"81:12":[[3,1,"سُعِّرَتْ","أُوقِدَتْ، فَأُضْرِمَتْ."]],"81:13":[[3,1,"أُزْلِفَتْ","قُرِّبَتْ مِنْ أَهْلِهَا."]],"81:14":[[4,1,"أَحْضَرَتْ","قَدَّمَتْ مِنْ خَيْرٍ أَوْ شَرٍّ."]],"81:15":[[1,2,"فَلَا أُقْسِمُ","أُقْسِمُ، وَ (لَا) : لِتَاكِيدِ الْقَسَمِ."],[3,1,"بِالْخُنَّسِ","النُّجُومِ المُخْتَفِيَةِ أَنْوَارُهَا نَهَارًا."]],"81:16":[[1,1,"الْجَوَارِ","النُّجُومِ الجَارِيَةِ فيِ أَفْلَاكِهَا."],[2,1,"الْكُنَّسِ","النُّجُومِ المُسْتَتِرَةِ فِي أَبْرَاجِهِا."]],"81:17":[[3,1,"عَسْعَسَ","أَقْبَلَ بِظَلَامِهِ، وَأَدْبَرَ."]],"81:18":[[3,1,"تَنَفَّسَ","ظَهَرَ ضِيَاؤْهُ، وَامْتَدَّ."]],"81:19":[[3,2,"رَسُولٍ كَرِيمٍ","هُوَ: جِبْرِيلُ - عليه السلام -."]],"81:20":[[6,1,"مَكِينٍ","ذِي مَكَانَةٍ رَفِيعَةٍ عِنْدَ اللهِ."]],"81:21":[[2,1,"ثَمَّ","هُنَاكَ فيِ السَّموَاتِ."]],"81:23":[[2,2,"رَآهُ بِالْأُفُقِ","رَأَى نَبِيُّنَا مُحَمَّدٌ - صلى الله عليه وسلم - جِبْرِيلَ - عليه السلام - فيِ الأُفُقِ عَلَى صُورَتِهِ الَّتِي خُلِقَ عَلَيْهَا."]],"81:24":[[5,1,"بِضَنِينٍ","بِبَخِيلٍ فِي تَبْلِيغِ الوَحْيِ، وَفِي قِرَاءَةٍ: (بِظَنِينٍ) ، أَيْ: مُتَّهَمٍ عَلَى الْوَحْيِ."]],"81:25":[[5,1,"رَجِيمٍ","مَرْجُومٍ، مَطْرُودٍ مِنْ رَحْمَةِ اللهِ."]],"81:27":[[1,2,"إِنْ هُوَ","مَا هُوَ."],[5,1,"لِّلْعَالَمِينَ","الإِنْسِ، وَالجِنِّ."]],"81:29":[[7,2,"رَبُّ الْعَالَمِينَ","رَبُّ الخَلَائِقِ أَجْمَعِينَ."]]}