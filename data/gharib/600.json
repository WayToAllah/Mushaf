{"100:6":[[4,1,"لَكَنُودٌ","لَجَحُودٌ."]],"100:7":[[4,1,"لَشَهِيدٌ","لَمُقِرٌّ عَلَى جُحُودِهِ."]],"100:8":[[3,1,"الْخَيْرِ","المَالِ."]],"100:9":[[4,1,"بُعْثِرَ","أُثِيرَ، وَأُخْرِجَ."]],"100:10":[[1,1,"وَحُصِّلَ","اُسْتُخْرِجَ، وَأُبْرِزَ."]],"101:1":[[1,1,"الْقَارِعَةُ","القِيَامَةُ الَّتِي تَقْرَعُ القُلُوبَ بِأَهْوَالِهَا."]],"101:4":[[5,1,"الْمَبْثُوثِ","المُنْتَشِرِ."]],"101:5":[[3,1,"كَالْعِهْنِ","كَالصُّوفِ المَصْبُوغِ بِأَلْوَانٍ مُخْتَلِفَةٍ."],[4,1,"الْمَنفُوشِ","الَّذِي مُزِّقَ، وَنُفِشَ، فَتَفَرَّقَتْ أَجْزَاؤُهُ."]],"101:6":[[3,2,"ثَقُلَتْ مَوَازِينُهُ","رَجَحَتْ مَوَازِينُ حَسَنَاتِهِ."]],"101:9":[[1,2,"فَأُمُّهُ هَاوِيَةٌ","مَاوَاهُ إِلَى جَهَنَّمَ يَهْوِي عَلَى رَاسِهِ."]],"101:11":[[2,1,"حَامِيَةٌ","حَارَّةٌ قَدِ اشْتَدَّ إِيقَادُهَا."]],"102:1":[[1,1,"أَلْهَاكُمُ","شَغَلَكُمْ عَنْ طَاعَةِ اللهِ."],[2,1,"التَّكَاثُرُ","التَّفَاخُرُ بِكَثْرَةِ الأَمْوَالِ وَالأَوْلَادِ وَالمَتَاعِ."]],"102:2":[[2,2,"زُرْتُمُ الْمَقَابِرَ","دُفِنْتُمْ فِي القُبُورِ."]],"102:5":[[4,2,"عِلْمَ الْيَقِينِ","حَقَّ العِلْم."]],"102:7":[[3,2,"عَيْنَ الْيَقِينِ","لَتُبْصِرُنَّ جَهَنَّمَ يَقِينًا بِلَا رَيْبٍ."]],"102:8":[[5,1,"النَّعِيمِ","كُلِّ أَنْوَاعِ النِّعَمِ مِنَ الأَمْنِ، وَالأَهْلِ، وَالمَطْعَمِ، وَنَحْوِهَا."]]}