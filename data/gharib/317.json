{"20:77":[[6,1,"أَسْرِ","اُخْرُجْ لَيْلًا."],[8,1,"فَاضْرِبْ","فَاتَّخِذْ."],[13,1,"يَبَسًا","يَابِسًا."],[16,1,"دَرَكًا","إِدْرَاكًا."]],"20:78":[[4,1,"فَغَشِيَهُمْ","فَغَمَرَهُمْ، وَغَطَّاهُمْ."],[6,1,"الْيَمِّ","البَحْرِ."]],"20:80":[[8,2,"جَانِبَ الطُّورِ","جَانِبِ جَبَلِ الطُّورِ."],[13,1,"الْمَنَّ","طَعَامًا؛ كَالعَسَلِ."],[14,1,"وَالسَّلْوَى","طَيْرًا؛ كَالسُّمَانَى."]],"20:81":[[6,3,"وَلَا تَطْغَوْا فِيهِ","لَا تَعْتَدُوا بِأَنْ يَظْلِمَ بَعْضُكُمْ بَعْضًا."],[9,1,"فَيَحِلَّ","فَيَنْزِلَ."],[17,1,"هَوَى","خَسِرَ، وَهَلَكَ."]],"20:84":[[3,1,"أُولَاءِ","هَؤُلاءِ."],[4,2,"عَلَى أَثَرِي","خَلْفِي سَوْفَ يَلْحَقُونَ بِي."]],"20:86":[[6,1,"أَسِفًا","حَزِينًا."],[12,2,"وَعْدًا حَسَنًا","الوَعْدَ بِإِنْزَالِ التَّوْرَاةِ."]],"20:87":[[5,1,"بِمَلْكِنَا","بِاخْتِيَارِنَا وَقُدْرَتِنَا."],[8,1,"أَوْزَارًا","أَثْقَالًا."],[9,3,"مِّن زِينَةِ الْقَوْمِ","مِنْ حُلِيِّ قَوْمِ فِرْعَوْنَ."],[12,1,"فَقَذَفْنَاهَا","أَلْقَيْنَاهَا فِي حُفْرَةٍ فِيهَا نَارٌ."]]}