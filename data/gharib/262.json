{"15:2":[[1,1,"رُّبَمَا","رُبَّمَا."]],"15:3":[[4,2,"وَيُلْهِهِمُ الأَمَلُ","يَشْغَلُهُمُ الطَّمَعُ فِي الُّدنْيَا، وَطُولُ البَقَاءِ فِيهَا."]],"15:4":[[7,2,"كِتَابٌ مَّعْلُومٌ","أَجَلٌ مُقَدَّرٌ."]],"15:7":[[1,2,"لَّوْ مَا","هَلَّا."]],"15:8":[[9,1,"مُّنظَرِينَ","مُمْهَلِينَ، وَمُؤَخَّرِينَ."]],"15:10":[[6,2,"شِيَعِ الأَوَّلِينَ","فِرَقِ الأُمَمِ السَّابِقِينَ."]],"15:12":[[2,1,"نَسْلُكُهُ","نُدْخِلُ الكُفْرَ."]],"15:13":[[5,1,"خَلَتْ","مَضَتْ."]],"15:14":[[7,1,"فَظَلُّوا","فَاسْتَمَرُّوا."],[9,1,"يَعْرُجُونَ","يَصْعَدُونَ."]],"15:15":[[3,1,"سُكِّرَتْ","سُحِرَتْ."]]}