{"48:1":[[4,2,"فَتْحًا مُّبِينًا","هُوَ: صُلْحُ الحُدَيْبِيَةِ عَامَ سِتٍّ مِنَ الهِجْرَةِ."]],"48:2":[[14,2,"صِرَاطًا مُّسْتَقِيمًا","طَرِيقًّا، وَدِينًا لَا عِوَجَ فِيهِ."]],"48:3":[[4,1,"عَزِيزًا","قَوِيًّا لَا ضَعْفَ فِيهِ."]],"48:4":[[4,1,"السَّكِينَةَ","الطُّمَانِينَةَ، وَالثَّبَاتَ."]],"48:5":[[11,1,"وَيُكَفِّرَ","يَمْحُوَ."]],"48:6":[[8,2,"ظَنَّ السَّوْءِ","الظَّنَّ السَّيِّئَ؛ وَهُوَ: الظَّنُّ بِأَنْ لَنْ يَنْصُرَ اللهُ دِينَهُ."],[10,3,"عَلَيْهِمْ دَائِرَةُ السَّوْءِ","دُعَاءٌ عَلَيْهِمْ بِأَنْ تَدُورَ عَلَيْهِمْ دَائِرَةُ العَذَابِ، وَكُلُّ مَا يَسُوءُ."],[21,1,"مَصِيرًا","مَنْزِلًا يَصِيرُونَ إِلَيْهِ."]],"48:9":[[4,1,"وَتُعَزِّرُوهُ","تَنْصُرُوا اللهَ."],[5,1,"وَتُوَقِّرُوهُ","تُعَظِّمُوا اللهَ."],[7,2,"بُكْرَةً وَأَصِيلًا","أَوَّلَ النَّهَارِ، وَآخِرَهُ."]]}