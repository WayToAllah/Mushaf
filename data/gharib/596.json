{"92:10":[[2,1,"لِلْعُسْرَى","لِكُلِّ عُسْرٍ، وَشَقَاوَةٍ."]],"92:11":[[1,2,"وَمَا يُغْنِي","لَا يَنْفَعُهُ."],[6,1,"تَرَدَّى","وَقَعَ فِي النَّارِ."]],"92:12":[[1,3,"إِنَّ عَلَيْنَا لَلْهُدَى","عَلَيْنَا أَنْ نُبَيِّنَ طَرِيقَ الهُدَى؛ فَضْلًا مِنَّا وَرَحْمَةً."]],"92:14":[[3,1,"تَلَظَّى","تَتَوَهَّجُ."]],"92:15":[[1,2,"لَا يَصْلَاهَا","لَا يَدْخُلُهَا، وَيُقَاسِي حَرَّهَا."]],"92:17":[[1,1,"وَسَيُجَنَّبُهَا","سَيُبْعَدُ عَنْهَا."]],"92:19":[[6,1,"تُجْزَى","تُكَافَأُ؛ فَلَيْسَ إِنْفَاقُهُ مُكَافَأَةً لِمَنْ أَحْسَنَ إِلَيْهِ."]],"93:1":[[1,1,"وَالضُّحَى","قَسَمٌ بِأَوَّلِ النَّهَارِ، أَوْ كُلِّهِ."]],"93:2":[[3,1,"سَجَى","غَطَّى الكَوْنَ بِظَلَامِهِ، وَسَكَنَ."]],"93:3":[[1,2,"مَا وَدَّعَكَ","مَا تَرَكَكَ."],[4,2,"وَمَا قَلَى","مَا أَبْغَضَكَ عِنْدَمَا أَبْطَأَ عَلَيْكَ الوَحْيَ."]],"93:6":[[4,1,"فَآوَى","فَآوَاكَ، وَرَعَاكَ."]],"93:7":[[2,1,"ضَالًّا","لَا تَدْرِي الوَحْيَ، وَلَا تَعْلَمُ القُرْآنَ."]],"93:8":[[2,1,"عَائِلًا","فَقِيرًا."]],"93:9":[[3,2,"فَلَا تَقْهَرْ","لَا تُسِئْ مُعَامَلَتَهُ، وَتَاخُذْ مَالَهُ."]],"93:10":[[2,1,"السَّائِلَ","الفَقِيرَ الَّذِي يَسْأَلُ، وَطَالِبَ العِلْمِ."],[3,2,"فَلَا تَنْهَرْ","لَا تَزْجُرْ."]],"94:1":[[1,2,"أَلَمْ نَشْرَحْ","قَدْ وَسَّعْنَا بِنُورِ الإِسْلَامِ بَعْدَ الحَيْرَةِ وَالضِّيقِ."]],"94:2":[[1,1,"وَوَضَعْنَا","حَطَطْنَا، وَغَفَرْنَا."],[3,1,"وِزْرَكَ","ذَنْبَكَ."]]}