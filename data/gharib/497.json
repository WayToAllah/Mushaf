{"44:19":[[1,3,"وَأَنْ لَّا تَعْلُوا","أَلَّا تَتَكَبَّرُوا."],[8,1,"بِسُلْطَانٍ","بِبُرْهَانٍ، وَحُجَّةٍ."]],"44:20":[[2,1,"عُذْتُ","اسْتَجَرْتُ."],[5,2,"أَن تَرْجُمُونِ","أَنْ تَقْتُلُونِي رَجْمًا بِالحِجَارَةِ."]],"44:24":[[3,1,"رَهْوًا","سَاكِنًا غَيْرَ مُضْطَرِبٍ."]],"44:26":[[2,2,"وَمَقَامٍ كَرِيمٍ","مَنَازِلَ جَمِيلَةٍ."]],"44:27":[[1,1,"وَنَعْمَةٍ","عِيشَةٍ، وَتَنَعُّمٍ."],[4,1,"فَاكِهِينَ","نَاعِمِينَ مُتْرَفِينَ."]],"44:28":[[3,2,"قَوْمًا آخَرِينَ","هُمْ: بَنُو إِسْرَائِيلَ؛ خَلَفُوا الأَقْبَاطَ عَلَى بِلَادِهِمْ."]],"44:29":[[8,1,"مُنظَرِينَ","مُؤَخَّرِينَ عَنِ العُقُوبَةِ."]],"44:30":[[6,2,"الْعَذَابِ الْمُهِينِ","المُذِلِّ؛ وَهُوَ قَتْلُ أَبْنَائِهِمْ، وَاسْتِخْدَامُ نِسَائِهِمْ."]],"44:31":[[5,1,"عَالِيًا","مُتَكَبِّرًا جَبَّارًا."]],"44:32":[[2,1,"اخْتَرْنَاهُمْ","اصْطَفَيْنَاهُمْ."],[5,2,"عَلَى الْعَالَمِينَ","عَالَمِي زَمَانِهِمْ."]],"44:33":[[6,2,"بَلَاءٌ مُّبِينٌ","اخْتِبَارٌ بَيْنَ الرَّخَاءِ، وَالشِّدَّةِ."]],"44:35":[[8,1,"بِمُنشَرِينَ","بِمَبْعُوثِينَ."]]}