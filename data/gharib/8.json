{"2:49":[[6,1,"يَسُومُونَكُمْ","يُذِيقُونَكُمْ."],[15,1,"بَلاءٌ","اخْتِبَارٌ أو نِعْمَةٌ."]],"2:50":[[2,1,"فَرَقْنَا","فَصَلْنَا."]],"2:53":[[5,1,"وَالْفُرْقَانَ","الَّذِي يَفْصِلُ بَيْنَ الْحَقِّ وَالْبَاطِلِ؛ وَهُوَ التَّوْرَاةُ."]],"2:54":[[13,1,"بَارِئِكُمْ","خَالِقِكُمْ."]],"2:55":[[12,1,"الصَّاعِقَةُ","نَارٌ مِنَ السَّمَاءَ."]],"2:57":[[1,1,"وَظَلَّلْنَا","جَعَلْنَاهُ ظِلًّا مِنْ حَرِّ الشَّمْسِ."],[3,1,"الْغَمَامَ","السَّحَابَ."],[6,1,"الْمَنَّ","شَيْئًا يُشْبِهُ الصَّمْغَ كَالْعَسَلِ."],[7,1,"وَالسَّلْوَى","طَيْرًا يُشْبِهُ السُّمَانَى."]]}