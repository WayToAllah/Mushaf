{"72:14":[[5,1,"الْقَاسِطُونَ","الجَائِرُونَ، الظَّالِمُونَ الَّذِينَ حَادُوا عَنِ الحَقِّ."],[9,2,"تَحَرَّوْا رَشَدًا","قَصَدُوا طَرِيقَ الحَقِّ، وَاجْتَهَدُوا فِي اخْتِيَارِهِ."]],"72:16":[[1,2,"وَأَلَّوِ اسْتَقَامُوا","وَأَنَّهُ لَوِ اسْتَقَامَ الكُفَّارُ."],[4,1,"الطَّرِيقَةِ","دِينِ الإِسْلَامِ."],[7,1,"غَدَقًا","كَثِيرًا."]],"72:17":[[1,2,"لِنَفْتِنَهُمْ فِيهِ","لِنَخْتَبِرَهُمْ كَيْفَ يَشْكُرُونَ نِعَمَ اللهِ عَلَيْهِمْ."],[8,1,"يَسْلُكْهُ","يُدْخِلْهُ."],[10,1,"صَعَدًا","شَدِيدًا شَاقًّا."]],"72:19":[[6,1,"يَدْعُوهُ","يَعْبُدُ رَبَّهُ."],[7,1,"كَادُوا","قَارَبَ الجِنُّ."],[10,1,"لِبَدًا","جَمَاعَاتٍ مُتَرَاكِبَةً بَعْضُهَا فَوْقَ بَعْضٍ، مِنْ شِدَّةِ ازْدِحَامِهِمْ لِسَمَاعِ القُرْآنِ مِنْهُ."]],"72:21":[[8,1,"رَشَدًا","نَفْعًا."]],"72:22":[[4,1,"يُجِيرَنِي","يُنْقِذَنِي."],[12,1,"مُلْتَحَدًا","مَلْجَأً أَفِرُّ إِلَيْهِ مِنْ عَذَابِهِ."]],"72:23":[[1,2,"إِلَّا بَلَاغًا","لَكِنْ أَمْلِكُ أَنْ أُبَلِّغَكُمْ."]],"72:25":[[2,2,"إِنْ أَدْرِي","مَا أَدْرِي."],[5,2,"مَّا تُوعَدُونَ","العَذَابُ الَّذِي وُعِدْتُّمْ بِهِ."],[11,1,"أَمَدًا","مُدَّةً طَوِيلَةً."]],"72:27":[[7,1,"يَسْلُكُ","يُرْسِلُ."],[13,1,"رَصَدًا","مَلَائِكَةً يَحْفَظُونَهُ، وَيَحْرُسُونَهُ."]]}