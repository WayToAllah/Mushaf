{"73:1":[[2,1,"الْمُزَّمِّلُ","أَصْلُهَا: المُتَزَمِّلُ، أَيِ: المُتَلَفِّفُ بِثِيَابِهِ."]],"73:4":[[4,1,"وَرَتِّلِ","اقْرَا بِتُؤَدَةٍ وَتَمَهَّلٍ؛ مُبَيِّنًا الحُرُوفَ وَالوُقُوفَ."]],"73:5":[[5,1,"ثَقِيلًا","عَظِيمًا، مُشْتَمِلًا عَلَى الأَوَامِرِ وَالنَّوَاهِي."]],"73:6":[[2,2,"نَاشِئَةَ اللَّيْلِ","العِبَادَةَ الَّتِي تَنْشَأُ فِي جَوْفِ اللَّيْلِ بَعْدَ النَّوْمِ."],[4,3,"هِيَ أَشَدُّ وَطْئًا","أَشَدُّ تَاثِيرًا فِي القَلْبِ."],[7,2,"وَأَقْوَمُ قِيلًا","أَبْيَنُ قَوْلًا؛ لِحُضُورِ القَلْبِ، وَقِلَّةِ الشَّوَاغِلِ."]],"73:7":[[5,1,"سَبْحًا","تَصّرُّفًا، وَتَقَلُّبًا فِي مَصَالِحِكَ."]],"73:8":[[4,1,"وَتَبَتَّلْ","انْقَطِعْ لِعِبَادَتِهِ."]],"73:9":[[9,1,"وَكِيلًا","تُفَوِّضُ أُمُورَكَ إِلَيْهِ، وَتَعْتَمِدُ عَلَيْهِ."]],"73:10":[[6,2,"هَجْرًا جَمِيلًا","أَعْرِضْ عَنْهُمْ؛ تَارِكًا الاِنْتِقَامَ مْنْهُمْ."]],"73:11":[[3,2,"أُولِي النَّعْمَةِ","أَصْحَابَ النَّعِيمِ وَالتَّرَفِ."],[5,2,"وَمَهِّلْهُمْ قَلِيلًا","أَجِّلْهُمْ زَمَنًا قَلِيلًا بِتَاخِيرِ العَذَابِ عَنْهُمْ."]],"73:12":[[3,1,"أَنكَالًا","قُيُودًا ثَقِيلَةً."]],"73:13":[[2,2,"ذَا غُصَّةٍ","يَنْشَبُ فِي الحُلُوقِ، لَا يُسْتَسَاغُ؛ لِكَرَاهَتِهِ."]],"73:14":[[2,1,"تَرْجُفُ","تَضْطَرِبُ."],[7,1,"كَثِيبًا","رَمْلًا مُجْتَمِعًا."],[8,1,"مَّهِيلًا","سَائِلًا مُتَنَاثِرًا."]],"73:16":[[6,1,"وَبِيلًا","شَدِيدًا."]],"73:18":[[2,2,"مُنفَطِرٌ بِهِ","مُتَصَدِّعَةٌ فِي يَوْمِ القِيَامَةِ."],[6,1,"مَفْعُولًا","وَاقِعًا لَا مَحَالَةَ."]],"73:19":[[9,1,"سَبِيلًا","طَرِيقًا بِالطَّاعَةِ."]]}