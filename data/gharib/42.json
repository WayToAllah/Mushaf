{"2:253":[[19,1,"وَأَيَّدْنَاهُ","قَوَّيْنَاهُ."],[20,2,"بِرُوحِ الْقُدُسِ","جِبْرِيلَ - عليه السلام -."]],"2:254":[[16,1,"خُلَّةٌ","صَدَاقَةٌ."]],"2:255":[[7,1,"الْقَيُّومُ","القَائِمُ عَلَى كُلِّ شَيءٍ."],[10,1,"سِنَةٌ","نُعَاسٌ."],[42,1,"كُرْسِيُّهُ","مَوْضِعُ قَدَمَيِ الرَّبِّ سُبْحَانَهُ."],[46,1,"يَؤُودُهُ","يُثْقِلُهُ."]],"2:256":[[12,1,"بِالطَّاغُوتِ","كُلِّ مَا عُبِدَ مِنْ دُونِ اللهِ."],[17,2,"بِالْعُرْوَةِ الْوُثْقَىَ","بالعَقْدِ المُحْكَمِ."]]}