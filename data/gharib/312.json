{"19:96":[[9,1,"وُدًّا","مَحَبَّةً فِي قُلُوبِ عِبَادِهِ."]],"19:97":[[10,1,"لُّدًّا","شَدِيدِي الخُصُومَةِ بِالبَاطِلِ."]],"19:98":[[5,1,"قَرْنٍ","أُمَّةٍ."],[7,1,"تُحِسُّ","تَرَى، وَتَجِدُ."],[14,1,"رِكْزًا","صَوْتًا خَفِيًّا."]],"20:5":[[4,1,"اسْتَوَى","ارْتَفَعَ، وَعَلَا عَلى الْعَرْشِ، اسْتِوَاءً يَلِيقُ بِجَلَالِهِ وَعَظَمَتِهِ."]],"20:6":[[12,1,"الثَّرَى","التُّرَابِ النَّدِيِّ؛ وَالمُرَادُ: الأَرَضُونَ السَّبْعُ؛ لِأَنَّهَا تَحْتَهُ."]],"20:10":[[8,1,"آنَسْتُ","أَبْصَرْتُ."],[13,1,"بِقَبَسٍ","بِشُعْلَةٍ تَسْتَدْفِئُونَ بِهَا."],[18,1,"هُدًى","هَادِيًا يَدُلُّنَا الطَّرِيقَ."]],"20:12":[[8,1,"الْمُقَدَّسِ","المُبَارَكِ المُطَهَّرِ."]]}