{"37:28":[[5,2,"عَنِ الْيَمِينِ","مِنْ قِبَلِ الحَقِّ وَالدِّينِ."]],"37:30":[[6,1,"سُلْطَانٍ","حُجَّةٍ، أَوْ قُوَّةٍ."],[10,1,"طَاغِينَ","مُجَاوِزِينَ الحَدَّ فيِ العِصْيَانِ."]],"37:31":[[1,2,"فَحَقَّ عَلَيْنَا","وَجَبَ عَلَيْنَا."]],"37:40":[[4,1,"الْمُخْلَصِينَ","الَّذِينَ أَخْلَصُوا فِي عِبَادَةِ اللهِ؛ فَأَخْلَصَهُمْ، وَاخْتَصَّهُمْ بِرَحْمَتِهِ."]],"37:45":[[3,1,"بِكَاسٍ","بِخَمْرٍ."],[4,2,"مِن مَّعِينٍ","مِنْ أَنْهَارٍ جَارِيَةٍ لَا يَخَافُونَ انْقِطَاعَهَا."]],"37:47":[[1,3,"لَا فِيهَا غَوْلٌ","لَيْسَ فِيهَا مَا يَغْتَالُ عُقُولَهُمْ."],[4,4,"وَلَا هُمْ عَنْهَا يُنزَفُونَ","لَا يَسْكَرُونَ، وَلَا تَضُرُّ أَبْدَانَهُمْ."]],"37:48":[[2,2,"قَاصِرَاتُ الطَّرْفِ","عَفِيفاتٌ لَا يَنْظُرْنَ إِلَى غَيْرِ أَزْوَاجِهِنَّ."],[4,1,"عِينٌ","حِسَانُ الأَعْيُنِ."]],"37:49":[[3,1,"مَّكْنُونٌ","لَمْ تَمَسَّهُ الأَيْدِي."]],"37:51":[[7,1,"قَرِينٌ","صَاحِبٌ مُلَازِمٌ لِي."]]}