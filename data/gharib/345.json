{"23:43":[[5,1,"أَجَلَهَا","مَوْعِدُ هَلَاكِهَا المُحَدَّدُ."]],"23:44":[[4,1,"تَتْرَا","يَتْبَعُ بَعْضُهُمْ بَعْضًا."],[15,1,"أَحَادِيثَ","أَخْبَارًا لِمَنْ بَعْدَهُمْ."]],"23:45":[[6,1,"بِآيَاتِنَا","وَهِيَ تِسْعٌ: العَصَا، وَاليَدُ، وَالجَرَادُ، وَالقُمَّلُ، وَالضَّفَادِعُ، وَالدَّمُ، وَالطُّوفَانُ، وَالسِّنُونَ، وَنَقْصُ الثَّمَرَاتِ."]],"23:46":[[7,1,"عَالِينَ","مُتَكَبِّرِينَ مُتَطَاوِلِينَ عَلَى النَّاسِ."]],"23:47":[[7,1,"عَابِدُونَ","مُتَذَلِّلُونَ مُطِيعُونَ."]],"23:50":[[6,1,"وَآوَيْنَاهُمَا","جَعَلْنَا لَهُمَا مَاوًى وَمَسْكَنًا."],[8,1,"رَبْوَةٍ","مَكَانٍ مُرْتَفِعٍ مِنَ الأَرْضِ."],[9,2,"ذَاتِ قَرَارٍ","مُسْتَوٍ لِلاِسْتِقْرَارِ عَلَيْهِ."],[11,1,"وَمَعِينٍ","مَاءٍ جَارٍ ظَاهِرٍ لِلْعُيُونِ."]],"23:52":[[3,1,"أُمَّتُكُمْ","دِينُكُمْ يَا مَعْشَرَ الأَنْبِيَاءِ."],[4,2,"أُمَّةً وَاحِدَةً","دِينًا وَاحِدًا هُوَ: الإِسْلَامُ."]],"23:53":[[1,2,"فَتَقَطَّعُوا أَمْرَهُم","فَتَفَرَّقَ الأَتْبَاعُ فِي الدِّينِ."],[4,1,"زُبُرًا","شِيَعًا، وَأَحْزَابًا."]],"23:54":[[3,1,"غَمْرَتِهِمْ","ضَلَالَتِهِمْ، وَجَهْلِهِمْ."],[4,2,"حَتَّى حِينٍ","إِلَى وَقْتِ نُزُولِ العَذَابِ بِهِمْ."]],"23:57":[[7,1,"مُّشْفِقُونَ","وَجِلُونَ."]]}