{"77:20":[[4,2,"مَّاءٍ مَّهِينٍ","ضَعِيفٍ حَقِيرٍ؛ وَهُوَ النُّطْفَةُ."]],"77:21":[[3,2,"قَرَارٍ مَّكِينٍ","مَكَانٍ حَصِينٍ مُتَمَكِّنٍ."]],"77:22":[[2,1,"قَدَرٍ","وَقْتٍ."]],"77:25":[[4,1,"كِفَاتًا","وِعَاءً تَضُمُّ الأَحْيَاءَ وَالأَمْوَاتَ."]],"77:27":[[3,2,"رَوَاسِيَ شَامِخَاتٍ","جِبَالًا ثَوَابِتَ، مُرْتَفِعَاتٍ."],[7,1,"فُرَاتًا","عَذْبًا، سَائِغًا."]],"77:30":[[3,1,"ظِلٍّ","هُوَ دُخَانُ جَهَنَّمَ."],[4,3,"ذِي ثَلَاثِ شُعَبٍ","يَتَفَرَّعُ مِنْهُ ثَلَاثُ قِطَعٍ."]],"77:31":[[1,2,"لَا ظَلِيلٍ","لَا يُظِلُّ مِنْ حَرِّ ذَلِكَ اليَوْمِ."],[3,2,"وَلَا يُغْنِي","لَا يَدْفَعُ، وَلَا يَقِي."]],"77:32":[[3,1,"بِشَرَرٍ","الشَّرَارَةُ: مَا يَتَطَايَرُ مِنَ النَّارِ."],[4,1,"كَالْقَصْرِ","كَالبِنَاءِ المُشَيَّدِ فِي العِظَمِ وَالاِرْتِفَاعِ."]],"77:33":[[2,2,"جِمَالَتٌ صُفْرٌ","كَأَنَّ الشَّرَرَ إِبِلٌ سُودٌ يَمِيلُ لَوْنُهَا إِلَى الصُّفْرَةِ."]],"77:39":[[4,1,"كَيْدٌ","حِيلَةٌ فِي الخَلَاصِ مِنَ العَذَابِ."]],"77:41":[[4,1,"ظِلَالٍ","ظِلِّ الأَشْجَارِ الوَارِفَةِ."]],"77:43":[[3,1,"هَنِيئًا","مُتَهَنِّئِينَ مِنْ غَيْرِ تَنْغِيصٍ، وَلَا كَدَرٍ."]],"77:50":[[2,2,"حَدِيثٍ بَعْدَهُ","كِتَابٍ وَكَلَامٍ بَعْدَ القُرْآنِ."]]}