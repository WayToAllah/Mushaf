{"46:8":[[3,1,"افْتَرَاهُ","اخْتَلَقَهُ."],[16,2,"تُفِيضُونَ فِيهِ","تَقُولُونَ فيِ القُرْآنِ."]],"46:9":[[4,3,"بِدْعًا مِّنْ الرُّسُلِ","أَوَّلَ رُسُلِ اللهِ إِلَى خَلْقِهِ."]],"46:10":[[2,1,"أَرَأَيْتُمْ","أَخْبِرُونِي."],[10,2,"وَشَهِدَ شَاهِدٌ","كَعَبْدِ اللهِ بْنِ سَلَامٍ - رضي الله عنه -."]],"46:11":[[18,2,"إِفْكٌ قَدِيمٌ","كَذِبٌ مَاثُورٌ عَنِ النَّاسِ الأَقْدَمِينَ."]],"46:12":[[5,1,"إِمَامًا","هَادِيًا يَاتَمُّونَ بِهِ، وَيَعْمَلُونَ."],[9,1,"مُّصَدِّقٌ","لِكُتُبٍ قَبْلَهُ."]],"46:13":[[7,1,"اسْتَقَامُوا","ثَبَتُوا عَلَى الإِيمَانِ وَالطَّاعَةِ."]]}