{"47:12":[[21,1,"مَثْوًى","مَاوًى، وَمسْكَنٌ."]],"47:13":[[1,3,"وَكَأَيِّن مِّن قَرْيَةٍ","كَثِيرٌ مِنَ القُرَى."]],"47:15":[[1,1,"مَثَلُ","صِفَةُ."],[10,2,"غَيْرِ آسِنٍ","غَيْرِ مُتَغَيِّرٍ، وَلَا مُنْتِنٍ."],[42,1,"حَمِيمًا","بَالِغَ الغَايَةِ فِي الحَرَارَةِ."]],"47:16":[[1,1,"وَمِنْهُم","مِنَ المُنَافِقِينَ."],[16,1,"آنِفًا","الآنَ."]],"47:18":[[2,1,"يَنظُرُونَ","يَنْتَظِرُونَ."],[7,1,"بَغْتَةً","فَجْأَةً."],[9,2,"جَاءَ أَشْرَاطُهَا","ظَهَرَتْ عَلَامَاتُهَا."],[11,1,"فَأَنَّى","مِنْ أَيْنَ لَهُمْ؟!"],[15,1,"ذِكْرَاهُمْ","تَذَكُّرُهُمْ."]],"47:19":[[13,1,"مُتَقَلَّبَكُمْ","تَصَرُّفَكُمْ فِي يَقَظَتِكُمْ نَهَارًا."],[14,1,"وَمَثْوَاكُمْ","مُسْتَقَرَّكُمْ فيِ نَوْمِكُمْ لَيْلًا."]]}