{"16:96":[[3,1,"يَنفَدُ","يَذْهَبُ وَيَفْنَى."]],"16:98":[[8,1,"الرَّجِيمِ","المَطْرُودِ مِنْ رَحْمَةِ اللهِ."]],"16:99":[[4,1,"سُلْطَانٌ","تَسَلُّطٌ."]],"16:100":[[5,1,"يَتَوَلَّوْنَهُ","يَتَّخِذُونَهُ وَلِيًّا مُطَاعًا."]],"16:101":[[13,1,"مُفْتَرٍ","كَاذِبٌ، مُخْتَلِقٌ عَلَى اللهِ."]],"16:102":[[3,2,"رُوحُ الْقُدُسِ","الرُّوحُ المُطَهَّرُ: جِبْرِيلُ - عليه السلام -."]]}