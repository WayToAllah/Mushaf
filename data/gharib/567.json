{"69:9":[[5,1,"وَالْمُؤْتَفِكَاتُ","أَهْلُ قُرَى قَوْمِ لُوطٍ الَّذِينَ انْقَلَبَتْ بِهِمْ دِيَارُهُمْ."],[6,1,"بِالْخَاطِئَةِ","بِالفَعَلَاتِ ذَاتِ الخَطَإِ الجَسِيمِ."]],"69:10":[[6,1,"رَّابِيَةً","بَالِغَةً فِي الشِّدَّةِ."]],"69:11":[[3,2,"طَغَى الْمَاءُ","جَاوَزَ المَاءُ حَدَّهُ، وَارْتَفَعَ فَوْقَ كُلِّ شَيْءٍ."],[7,1,"الْجَارِيَةِ","السَّفِينَةِ الَّتِي صَنَعَهَا نُوحٌ - عليه السلام -، تَجْرِي فِي المَاءِ."]],"69:12":[[4,1,"وَتَعِيَهَا","تَحْفَظَهَا."]],"69:13":[[4,1,"الصُّورِ","القَرْنِ الَّذِي يَنْفُخُ فِيهِ إِسْرَافِيلُ - عليه السلام -."],[5,2,"نَفْخَةٌ وَاحِدَةٌ","هِيَ: النَّفْخَةُ الأُولَى الَّتِي يَكُونُ بِهَا هَلَاكُ العَالَمِ."]],"69:14":[[1,1,"وَحُمِلَتِ","رُفِعَتْ مِنْ أَمَاكِنِهَا."],[4,1,"فَدُكَّتَا","دُقَّتَا، وَكُسِّرَتَا."]],"69:15":[[2,2,"وَقَعَتِ الْوَاقِعَةُ","قَامَتِ القِيَامَةُ."]],"69:16":[[5,1,"وَاهِيَةٌ","ضَعِيفَةٌ، مُسْتَرْخِيَةٌ."]],"69:17":[[1,1,"وَالْمَلَكُ","المَلَائِكَةُ."],[3,1,"أَرْجَائِهَا","جَوَانِبِهَا، وَأَطْرَافِهَا."]],"69:18":[[2,1,"تُعْرَضُونَ","عَلَى اللهِ لِلْجَزَاءِ وَالحِسَابِ."]],"69:19":[[7,1,"هَاؤُمُ","خُذُوا."]],"69:20":[[2,1,"ظَنَنتُ","أَيْقَنْتُ."]],"69:21":[[4,1,"رَّاضِيَةٍ","هَنِيْئَةٍ مَرْضِيَّةٍ."]],"69:23":[[1,1,"قُطُوفُهَا","ثِمَارُهَا."],[2,1,"دَانِيَةٌ","قَرِيبَةٌ يَتَنَاوَلُهَا القَاعِدُ وَالمُضْطَجِعُ."]],"69:24":[[3,1,"هَنِيئًا","غَيْرَ مُنْغَّصٍ، وَلَا مُكَدَّرٍ."],[5,1,"أَسْلَفْتُمْ","قَدَّمْتُمْ."]],"69:26":[[3,2,"مَا حِسَابِيهْ","مَا جَزَائِي؟"]],"69:27":[[2,2,"كَانَتِ الْقَاضِيَةَ","المَوْتَةَ القَاطِعَةَ لِأَمْرِي، وَلَمْ أُبْعَثْ."]],"69:28":[[1,2,"مَا أَغْنَى","مَا نَفَعَنِي."]],"69:29":[[1,2,"هَلَكَ عَنِّي","ذَهَبَ عَنِّي."],[3,1,"سُلْطَانِيهْ","حُجَّتِي، وَقُوَّتِي."]],"69:30":[[2,1,"فَغُلُّوهُ","اجْمَعُوا يَدَيْهِ إِلَى عُنُقِهِ بِالأَغْلَالِ."]],"69:31":[[3,1,"صَلُّوهُ","أَدْخِلُوهُ، وَأَحْرِقُوهُ بِهَا."]],"69:32":[[4,1,"ذَرْعُهَا","طُولُهَا بِذِرَاعِ المَلَكِ."],[7,1,"فَاسْلُكُوهُ","فَأَدْخِلُوهُ فِيهَا."]],"69:35":[[5,1,"حَمِيمٌ","قَرِيبٌ يَحْمِيهِ مِنَ العَذَابِ."]]}