{"50:36":[[1,2,"وَكَمْ أَهْلَكْنَا","كَثِيرًا أَهْلَكْنَا."],[5,1,"قَرْنٍ","أُمَمٍ."],[9,1,"بَطْشًا","قُوَّةً، وَسَطْوَةً."],[10,1,"فَنَقَّبُوا","طَوَّفُوا."],[15,1,"مَّحِيصٍ","مَهْرَبٍ."]],"50:37":[[10,2,"أَلْقَى السَّمْعَ","أَصْغَى السَّمْعِ."],[12,2,"وَهُوَ شَهِيدٌ","هُوَ حَاضِرٌ بِقَلْبِهِ، غَيْرُ غَافِلٍ وَلَا لَاهٍ."]],"50:38":[[13,1,"لُّغُوبٍ","تَعَبٍ، وَنَصَبٍ."]],"50:39":[[5,3,"وَسَبِّحْ بِحَمْدِ رَبِّكَ","صَلِّ حَامِدًا لَهُ."],[8,3,"قَبْلَ طُلُوعِ الشَّمْسِ","صَلَاةَ الفَجْرِ."],[11,2,"وَقَبْلَ الْغُرُوبِ","صَلَاةَ العَصْرِ."]],"50:40":[[4,2,"وَأَدْبَارَ السُّجُودِ","سَبِّحْ عَقِبَ الصَّلَوَاتِ، أَوْ صَلِّ النَّوَافِلَ بَعْدَ الفَرَائِضِ."]],"50:41":[[4,1,"الْمُنَادِ","المَلَكُ المُوكَلُ بِالنَّفْخِ فيِ الصُّورِ؛ وَهُوَ: إِسْرَافِيلُ - عليه السلام -."]],"50:42":[[3,1,"الصَّيْحَةَ","نَفْخَةَ البَعْثِ."],[6,2,"يَوْمُ الْخُرُوجِ","مِنَ القُبُورِ."]],"50:43":[[6,1,"الْمَصِيرُ","المَرْجعُ، وَالمَآلُ."]],"50:44":[[2,2,"تَشَقَّقُ الْأَرْضُ","تَتَصَدَّعُ."],[5,1,"سِرَاعًا","يَخْرُجُونَ مُسْرِعِينَ."]],"50:45":[[8,1,"بِجَبَّارٍ","بِمُسَلَّطٍ تُجْبِرُهُمْ عَلَى الإِيمَانِ."],[12,2,"يَخَافُ وَعِيدِ","يَخْشَى وَعِيدِي."]],"51:1":[[1,1,"وَالذَّارِيَاتِ","قَسَمٌ بِالرِّيَاحِ، المُثِيرَاتِ لِلتُّرَابِ."]],"51:2":[[1,2,"فَالْحَامِلَاتِ وِقْرًا","فَالسُّحُبِ الحَامِلَاتِ ثِقَلًا عَظِيمًا مِنَ المَاءِ."]],"51:3":[[1,2,"فَالْجَارِيَاتِ يُسْرًا","فَالسُّفُنِ الَّتِي تَجْرِي فِي البِحَارِ بِيُسْرٍ."]],"51:4":[[1,2,"فَالْمُقَسِّمَاتِ أَمْرًا","فَالمَلَائِكَةِ الَّتِي تُقَسِّمُ أَمْرَ اللهِ فِي خَلْقِهِ."]],"51:6":[[2,1,"الدِّينَ","الحِسَابَ، وَالجَزَاءَ."]]}