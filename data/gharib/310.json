{"19:65":[[7,1,"وَاصْطَبِرْ","الْزَمِ الصَّبْرَ."],[12,1,"سَمِيًّا","مَثِيلًا، وَمُضَاهِيًا، فِي ذَاتِهِ، وَصِفَاتِهِ."]],"19:68":[[8,1,"جِثِيًّا","بَارِكِينَ عَلَى رُكَبِهِمْ مِنَ الهَوْلِ."]],"19:69":[[5,1,"شِيعَةٍ","طَائِفَةٍ."],[10,1,"عِتِيًّا","تَمَرُّدًا وَعِصْيَانًا."]],"19:70":[[8,1,"صِلِيًّا","دُخُولًا، وَمُقَاسَاةً لِحَرِّهَا."]],"19:71":[[4,1,"وَارِدُهَا","مَارًّا بِالصِّرَاطِ المَنْصُوبِ عَلَى مَتْنِ جَهَنَّمَ."],[8,1,"حَتْمًا","مَحْتُومًا لَازِمًا."]],"19:72":[[8,1,"جِثِيًّا","بَارِكِينَ عَلَى رُكَبِهِمْ."]],"19:73":[[14,1,"مَّقَامًا","مَنْزِلًا."],[16,1,"نَدِيًّا","مَجْلِسًا."]],"19:74":[[5,1,"قَرْنٍ","أُمَّةٍ."],[8,1,"أَثَاثًا","مَتَاعًا."],[9,1,"وَرِئْيًا","مَنْظَرًا، وَمَرْأًى."]],"19:75":[[6,1,"فَلْيَمْدُدْ","فَلْيُمْهِلْهُ، وَلْيُمْلِ لَهُ؛ اسْتِدْرَاجًا."]],"19:76":[[6,1,"وَالْبَاقِيَاتُ","الأَعْمَالُ الصَّالِحَاتُ."],[13,1,"مَّرَدًّا","مَرْجِعًا، وَعَاقِبَةً."]]}