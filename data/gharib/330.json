{"21:91":[[2,2,"أَحْصَنَتْ فَرْجَهَا","حَفِظَتْهُ مِنَ الفَوَاحِشِ."],[4,1,"فَنَفَخْنَا","نَفَخَ جِبْرِيلُ - عليه السلام - فيِ جَيْبِ قَمِيصِهَا، فَوَصَلَتِ النَّفْخَةُ إِلَى رَحِمِهَا."],[6,2,"مِن رُّوحِنَا","مِنْ جِهَةِ رُوحِنَا، وَهُوَ: جِبْرِيلُ - عليه السلام -."],[10,1,"آيَةً","عَلَامَةً عَلَى قُدْرَةِ اللهِ."]],"21:92":[[3,3,"أُمَّتُكُمْ أُمَّةً وَاحِدَةً","مِلَّتُكُمْ مِلَّةً وَاحِدَةً، وَهِيَ: الإِسْلَامُ."]],"21:93":[[1,2,"وَتَقَطَّعُوا أَمْرَهُم","اخْتَلَفُوا عَلَى رُسُلِهِمْ، وَتَفَرَّقُوا."]],"21:94":[[7,3,"فَلَا كُفْرَانَ لِسَعْيِهِ","فَلَا جُحُودَ لِعَمَلِهِ."]],"21:95":[[1,1,"وَحَرَامٌ","مُمْتَنِعٌ."],[6,2,"لَا يَرْجِعُونَ","أَيْ: إِلَى الدُّنْيَا؛ لِيَسْتَدْرِكُوا مَا فَرَّطُوا فِيهِ."]],"21:96":[[3,2,"فُتِحَتْ يَاجُوجُ","أَيْ: سَدُّ يَاجُوجَ."],[9,1,"حَدَبٍ","مُرْتَفِعٍ مِنَ الأَرْضِ."],[10,1,"يَنسِلُونَ","يُسْرِعُونَ."]],"21:97":[[2,2,"الْوَعْدُ الْحَقُّ","يَوْمُ القِيَامَةِ."],[6,1,"شَاخِصَةٌ","مَفْتُوحَةٌ لَا تَكَادُ تَطْرِفُ."]],"21:98":[[7,2,"حَصَبُ جَهَنَّمَ","وَقُودُهَا، وَحَطَبُهَا."],[11,1,"وَارِدُونَ","دَاخِلُونَ."]],"21:100":[[3,1,"زَفِيرٌ","تَنَفُّسٌ شَدِيدٌ تَنْتَفِخُ مِنْهُ الضُّلُوعُ يَدُلُّ عَلَى شِدَّةِ عَذَابِهِمْ."]]}