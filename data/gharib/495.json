{"43:75":[[1,3,"لَا يُفَتَّرُ عَنْهُمْ","لَا يُخَفَّفُ عَنْهُمْ."],[6,1,"مُبْلِسُونَ","آيِسُونَ مِنْ رَحْمَةِ اللهِ."]],"43:77":[[2,2,"يَا مَالِكُ","هُوَ: خَازِنُ جَهَنَّمَ."],[3,1,"لِيَقْضِ","لِيُمِتْنَا."]],"43:79":[[1,3,"أَمْ أَبْرَمُوا أَمْرًا","أَحْكَمُوا أَمْرًا فِي كَيْدِ نَبِيِّنَا مُحَمَّدٍ - صلى الله عليه وسلم -."]],"43:80":[[2,1,"يَحْسَبُونَ","يَظُنُّونَ."],[7,1,"وَنَجْوَاهُم","مَا تَكَلَّمُوا فِيهِ فِيمَا بَيْنَهُمْ."],[9,1,"وَرُسُلُنَا","مَلَائِكَتُنَا الكِرَامُ الحَفَظَةُ."]],"43:82":[[7,2,"عَمَّا يَصِفُونَ","عَمَّا يَصِفُونَ اللهَ بِهِ؛ مِنَ الصَّاحِبَةِ، وَالوَلَدِ."]],"43:83":[[1,1,"فَذَرْهُمْ","اتْرُكْهُمْ."],[2,1,"يَخُوضُوا","يَتَكَلَّمُوا بِبَاطِلِهِمْ."]],"43:84":[[5,1,"إِلَهٌ","مَعْبُودٌ بِحَقٍّ."]],"43:85":[[1,1,"وَتَبَارَكَ","تَكَاثَرَتْ بَرَكَةُ اللهِ، وَكَثُرَ خَيْرُهُ."]],"43:86":[[10,2,"شَهِدَ بِالْحَقِّ","أَقَرَّ بِتَوْحِيدِ اللهِ، وَنُبُوَّةِ نَبِيِّنَا مُحَمَّدٍ - صلى الله عليه وسلم -."]],"43:87":[[7,2,"فَأَنَّى يُؤْفَكُونَ","كَيْفَ يَنْصَرِفُونَ عَنْ عِبَادَةِ اللهِ؟!"]],"43:88":[[1,1,"وَقِيلِهِ","وَقَوْلِ مُحَمَّدٍ فِي شَكْوَاهُ."]],"43:89":[[1,1,"فَاصْفَحْ","أَعْرِضْ عَنْ أَذَاهُمْ."]]}