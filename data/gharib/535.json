{"56:17":[[3,2,"وِلْدَانٌ مُّخَلَّدُونَ","غِلْمَانٌ لِلْخِدْمَةِ لَا يَهْرَمُونَ، وَلَا يَمُوتُونَ."]],"56:18":[[1,1,"بِأَكْوَابٍ","أَقْدَاحٍ لَا عُرَى لَهَا، وَلَا خَرَاطِيمَ."],[2,1,"وَأَبَارِيقَ","أَوَانٍ لَهَا عُرًى، وَخَرَاطِيمُ."],[3,1,"وَكَاسٍ","خَمْرٍ، أَوْ قَدَحٍ فِيهِ خَمْرٌ."],[4,2,"مِّن مَّعِينٍ","خَمْرٍ جَارِيَةٍ فِي الجَنَّةِ."]],"56:19":[[1,3,"لَا يُصَدَّعُونَ عَنْهَا","لَا تُصَدَّعُ مِنْهَا رُؤُوسُهُمْ."],[4,2,"وَلَا يُنزِفُونَ","لَا تَذْهَبُ بِعُقُولِهِمْ."]],"56:22":[[1,2,"وَحُورٌ عِينٌ","نِسَاءٌ بِيضٌ وَاسِعَاتُ الأَعْيُنِ حِسَانُهَا."]],"56:23":[[3,1,"الْمَكْنُونِ","المَصُونِ فيِ أَصْدَافِهِ مِنْ صَفَائِهِنَّ، وَجَمَالِهِنَّ."]],"56:25":[[4,1,"لَغْوًا","بَاطِلًا، وَكَلَامًا لَا خَيْرَ فِيهِ."],[6,1,"تَاثِيمًا","مَا يَتَأَثَّمُونَ بِسَمَاعِهِ."]],"56:26":[[2,1,"قِيلًا","قَوْلًا."],[3,1,"سَلَامًا","إِلَّا قَوْلًا سَالِمًا مِنْ هَذِهِ العُيُوبِ، وَإِلَّا تَسْلِيمَ بَعْضِهِمْ عَلَى بَعْضٍ."]],"56:28":[[2,2,"سِدْرٍ مَّخْضُودٍ","شَجَرٍ النَّبِقِ لَا شَوْكَ فِيهِ."]],"56:29":[[1,2,"وَطَلْحٍ مَّنضُودٍ","مَوْزٍ مُتَرَاكِبٍ بَعْضُهُ عَلَى بَعْضٍ، أَوْ هُوَ شَجَرُ الطَّلْحِ المَعْرُوفُ، وَهُوَ أَعْظَمُ أَشْجَارِ العَرَبِ."]],"56:30":[[1,2,"وَظِلٍّ مَّمْدُودٍ","ظِلٍّ دَائِمٍ لَا يَزُولُ."]],"56:31":[[2,1,"مَّسْكُوبٍ","جَارٍ لَا يَنْقَطِعُ."]],"56:34":[[2,1,"مَّرْفُوعَةٍ","مَرْفُوعَةٍ عَلَى السُّرُرِ."]],"56:35":[[2,2,"أَنشَانَاهُنَّ إِنشَاءً","خَلَقْنَا نِسَاءَ أَهْلِ الجَنَّةِ نَشْأَةً كَامِلَةً لَا تَقْبَلُ الفَنَاءَ."]],"56:37":[[1,1,"عُرُبًا","مُتَحَبِّبَاتٍ لِأَزْوَاجِهِنَّ."],[2,1,"أَتْرَابًا","فِي سِنٍّ وَاحِدَةٍ."]],"56:42":[[2,1,"سَمُومٍ","رِيحٍ حَارَّةٍ مِنْ حَرِّ نَارِ جَهَنَّمَ، تَاخُذُ بِأَنْفَاسِهِمْ."],[3,1,"وَحَمِيمٍ","مَاءٍ حَارٍّ يَغْلِي."]],"56:43":[[3,1,"يَحْمُومٍ","دُخَانٍ شَدِيدِ السَّوَادِ."]],"56:44":[[1,4,"لَّا بَارِدٍ وَلَا كَرِيمٍ","لَا بَارِدِ المَنْزِلِ، وَلَا طَيِّبِ المَنْظَرِ."]],"56:45":[[5,1,"مُتْرَفِينَ","مُتَنَعِّمِينَ مُنْهَمِكِينَ فيِ الشَّهَوَاتِ."]],"56:46":[[4,2,"الْحِنثِ الْعَظِيمِ","الذَّنْبِ العَظِيمِ؛ وَهُوَ الشِّرْكُ بِاللهِ."]],"56:48":[[1,2,"أَوَ آبَاؤُنَا","أَنُبْعَثُ نَحْنُ، وَآبَاؤُنَا؟!"]]}