{"20:99":[[11,2,"مِن لَّدُنَّا","مِنْ عِنْدِنَا."]],"20:100":[[8,1,"وِزْرًا","إِثْمًا عَظِيمًا."]],"20:102":[[4,1,"الصُّورِ","القَرْنِ الَّذِي يَنْفُخُ فِيهِ إِسْرَافِيلُ - عليه السلام -."],[5,1,"وَنَحْشُرُ","نَسُوقُ."],[8,1,"زُرْقًا","زُرْقَ العُيُونِ مَعَ سَوَادِ وُجُوهِهِمْ."]],"20:103":[[1,1,"يَتَخَافَتُونَ","يَتَسَارُّونَ، وَيَتَهَامَسُونَ."]],"20:104":[[7,2,"أَمْثَلُهُمْ طَرِيقَةً","أَعْلَمُهُمْ، وَأَوْفَاهُمْ عَقْلًا."]],"20:105":[[5,1,"يَنسِفُهَا","يُزِيلُهَا عَنْ أَمَاكِنِهَا."],[7,1,"نَسْفًا","يَجْعَلُهَا هَبَاءً مُنْبَثًّا."]],"20:106":[[1,1,"فَيَذَرُهَا","فَيَتْرُكُهَا."],[2,1,"قَاعًا","أَرْضًا مَلْسَاءَ لَا نَبَاتَ بِهَا."],[3,1,"صَفْصَفًا","مُسْتَوِيَةً."]],"20:107":[[4,1,"عِوَجًا","انْخِفَاضًا."],[6,1,"أَمْتًا","ارْتِفَاعًا."]],"20:108":[[4,3,"لَا عِوَجَ لَهُ","لَا مَحِيدَ عَنْ دَعْوَةِ الدَّاعِي."],[7,1,"وَخَشَعَتْ","سَكَنَتْ خُضُوعًا."]],"20:111":[[1,1,"وَعَنَتِ","خَضَعَتْ، وَذَلَّتْ."],[4,1,"الْقَيُّومِ","القَائِمِ عَلَى شُؤُونِ خَلْقِهِ."],[9,1,"ظُلْمًا","زِيَادَةً فِي سَيِّئَاتِهِ."]],"20:112":[[11,1,"هَضْمًا","نَقْصًا مِنْ حَسَنَاتِهِ."]],"20:113":[[5,1,"وَصَرَّفْنَا","فَصَّلْنَا فِيهِ أَنْوَاعًا مِنَ الوَعِيدِ."],[14,1,"ذِكْرًا","تَذْكِرَةً، وَعِظَةً."]]}