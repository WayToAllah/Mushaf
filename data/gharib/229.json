{"11:63":[[3,1,"أَرَأَيْتُمْ","أَخْبِرُونِي."],[22,1,"تَخْسِيرٍ","تَضْلِيلٍ، وَإِبْعَادٍ عَنِ الخَيْرِ."]],"11:64":[[6,1,"آيَةً","عَلَامَةً عَلَى صِدْقِي."],[14,1,"بِسُوءٍ","بِنَحْرٍ أَوْ ضَرْبٍ."]],"11:65":[[1,1,"فَعَقَرُوهَا","فَنَحَرُوهَا."],[3,3,"تَمَتَّعُوا فِي دَارِكُمْ","اسْتَمْتِعُوا بِحَيَاتِكُمْ فِي بَلَدِكُمْ."]],"11:66":[[12,2,"خِزْيِ يَوْمِئِذٍ","هَوَانِ ذَلِكَ اليَوْمِ، وَذِلَّتِهِ."]],"11:67":[[4,1,"الصَّيْحَةُ","صَوْتٌ عَظِيمٌ مُهْلِكٌ مِنَ السَّمَاءِ."],[8,1,"جَاثِمِينَ","هَامِدِينَ، سَاقِطِينَ عَلَى وُجُوهِهِمْ."]],"11:68":[[2,2,"لَّمْ يَغْنَوْا","لَمْ يَعِيشُوا، وَيُقِيمُوا."],[11,1,"بُعْدًا","هَلَاكًا، وَطَرْدًا."]],"11:69":[[15,1,"حَنِيذٍ","مَشْوِيٍّ بِالحِجَارَةِ المُحْمَاةِ."]],"11:70":[[7,1,"نَكِرَهُمْ","أَنْكَرَ ذَلِكَ مِنْهُمْ."],[8,3,"وَأَوْجَسَ مِنْهُمْ خِيفَةً","أَحَسَّ فيِ نَفْسِهِ خَوْفًا مِنْهُمْ."]],"11:71":[[6,2,"وَمِن وَرَاءِ","وَمِنْ بَعْدِ."]]}