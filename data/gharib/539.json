{"57:13":[[7,1,"انظُرُونَا","انْتَظِرُونَا."],[8,1,"نَقْتَبِسْ","نَاخُذْ، وَنُصِبْ."],[21,1,"بَاطِنُهُ","مِمَّا يَلِي المُؤْمِنِينَ."],[24,1,"وَظَاهِرُهُ","مِمَّا يَلِي المُنَافِقِينَ."]],"57:14":[[8,1,"فَتَنتُمْ","أَهْلَكْتُمْ."],[10,1,"وَتَرَبَّصْتُمْ","تَرَقَّبْتُمْ حُصُولَ النَّوَائِبِ لِلنَّبِيِّ - صلى الله عليه وسلم -، وَالمُؤْمِنِينَ مَعَهُ."],[11,1,"وَارْتَبْتُمْ","شَكَكْتُمْ فيِ البَعْثِ."],[12,2,"وَغَرَّتْكُمُ الْأَمَانِيُّ","خَدَعَتْكُمُ الأَبَاطِيلُ."],[16,2,"أَمْرُ اللَّهِ","المَوْتُ."],[20,1,"الْغَرُورُ","الشَّيْطَانُ."]],"57:15":[[5,1,"فِدْيَةٌ","عِوَضٌ لِيُفْتَدَى بِهِ مِنْ عَذَابِ اللهِ."],[10,1,"مَاوَاكُمُ","مَصِيرُكُمْ."],[13,1,"مَوْلَاكُمْ","أَوْلَى بِكُمْ."],[15,1,"الْمَصِيرُ","المَرْجِعُ."]],"57:16":[[1,2,"أَلَمْ يَانِ","أَلَمْ يَحِنْ وَيَجِئِ الوَقْتُ؟!"],[6,1,"تَخْشَعَ","تَخْضَعَ، وَتَرِقَّ، وَتَلِينَ."],[23,1,"الْأَمَدُ","الزَّمَانُ."]],"57:18":[[2,1,"الْمُصَّدِّقِينَ","المُتَصَدِّقِينَ."],[6,2,"قَرْضًا حَسَنًا","مُحْتَسِبِينَ فِي نَفَقَاتِهِمْ بِلَا مَنٍّ، وَلَا أَذًى."]]}