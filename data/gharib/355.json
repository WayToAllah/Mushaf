{"24:37":[[15,4,"يَوْمًا تَتَقَلَّبُ فِيهِ الْقُلُوبُ","أَيْ: بَيْنَ الرَّجَاءِ، وَالخَوْفِ."]],"24:38":[[13,2,"بِغَيْرِ حِسَابٍ","بِلَا عَدٍّ، وَيُعْطَى مِنَ الأَجْرِ مَا لَا يَبْلُغُهُ عَمَلُ العَامِلِ."]],"24:39":[[4,1,"كَسَرَابٍ","هُوَ مَا يُشَاهَدُ كَالمَاءِ عَلَى الأَرْضِ المُسْتَوِيَةِ فِي الظَّهِيرَةِ."],[5,1,"بِقِيعَةٍ","الأَرْضُ المُنْخَفِضَةُ المُسْتَوِيَةُ."]],"24:40":[[5,1,"لُّجِّيٍّ","عَمِيقٍ."],[6,1,"يَغْشَاهُ","يَعْلُوهُ."]],"24:41":[[12,1,"صَافَّاتٍ","بَاسِطَاتٍ أَجْنِحَتَهُنَّ فِي الهَوَاءِ."]],"24:43":[[5,1,"يُزْجِي","يَسُوقُ."],[8,1,"يُؤَلِّفُ","يَجْمَعُ."],[12,1,"رُكَامًا","مُتَرَاكِمًا."],[14,1,"الْوَدْقَ","المَطَرَ."],[16,2,"مِنْ خِلَالِهِ","مِنْ بَيْنِهِ."],[35,2,"سَنَا بَرْقِهِ","ضَوْءُ البَرْقِ."]]}