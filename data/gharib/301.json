{"18:62":[[12,1,"نَصَبًا","تَعَبًا."]],"18:63":[[2,1,"أَرَأَيْتَ","أَتَذْكُرُ؟"],[4,1,"أَوَيْنَا","لَجَانَا."]],"18:64":[[5,1,"نَبْغِ","نَطْلُبُ."],[6,1,"فَارْتَدَّا","فَرَجَعَا."],[7,3,"عَلَى آثَارِهِمَا قَصَصًا","يَتَتَبَّعَانِ آثَارَ مَشْيِهِمَا."]],"18:65":[[1,2,"فَوَجَدَا عَبْدًا","هُوَ الخِضْرُ - عليه السلام -."],[10,2,"مِن لَّدُنَّا","مِنْ عِنْدِنَا."]],"18:68":[[4,5,"مَا لَمْ تُحِطْ بِهِ خُبْرًا","مَا يَخْفَى عَلَيْكِ عِلْمُهُ."]],"18:71":[[7,1,"خَرَقَهَا","قَلَعَ لَوْحًا مِنْ أَلْوَاحِهَا."],[15,1,"إِمْرًا","أَمْرًا مُنْكَرًا."]],"18:73":[[6,2,"وَلَا تُرْهِقْنِي","لَا تُكَلِّفْنِي."]],"18:74":[[10,1,"زَكِيَّةً","طَاهِرَةً لَمْ تَبْلُغْ حَدَّ التَّكْلِيفِ."],[16,1,"نُّكْرًا","مُنْكَرًا عَظِيمًا."]]}