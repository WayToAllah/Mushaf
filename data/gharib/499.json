{"45:4":[[4,1,"يَبُثُّ","يَنْشُرُ، وَيُفَرِّقُ."]],"45:5":[[16,2,"وَتَصْرِيفِ الرِّيَاحِ","تَقْلِيبِهَا فيِ مَهَابِّهَا لِمَنْفَعَتِكُمْ."]],"45:7":[[1,1,"وَيْلٌ","هَلَاكٌ، وَدَمَارٌ."],[3,1,"أَفَّاكٍ","كَذَّابٍ."],[4,1,"أَثِيمٍ","كَثِيرِ الإِثْمِ."]],"45:9":[[7,1,"هُزُوًا","سُخْرِيَةً."]],"45:12":[[7,1,"الْفُلْكُ","السُّفُنُ."]]}