{"16:56":[[12,1,"تَفْتَرُونَ","تَخْتَلِقُونَ مِنَ الكَذِبِ."]],"16:58":[[9,1,"كَظِيمٌ","مُمْتَلِئٌ غَمًّا وَحُزْنًا."]],"16:59":[[1,1,"يَتَوَارَى","يَسْتَخْفِي."],[9,1,"أَيُمْسِكُهُ","أَيُبْقِيهِ؟"],[11,1,"هُونٍ","ذُلٍّ، وَهَوَانٍ."],[13,1,"يَدُسُّهُ","يَدْفِنُهُ."]],"16:60":[[5,2,"مَثَلُ السَّوْءِ","الصِّفَةُ القَبِيحَةُ."],[8,2,"الْمَثَلُ الأَعْلَىَ","الصِّفَاتُ العُلْيَا."]],"16:62":[[5,1,"وَتَصِفُ","تَقُولُ."],[10,1,"الْحُسْنَى","حُسْنُ العَاقِبَةِ."],[11,2,"لَا جَرَمَ","حَقًّا."],[17,1,"مُّفْرَطُونَ","مَتْرُوكُونَ فِي النَّارِ، مَنْسِيُّونَ."]]}