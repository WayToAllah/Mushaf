{"20:126":[[5,1,"فَنَسِيتَهَا","أَعْرَضْتَ عَنْهَا."]],"20:128":[[8,1,"الْقُرُونِ","الأُمَمِ المُكَذِّبَةِ."],[16,2,"لِّأُوْلِي النُّهَى","لِذَوِي العُقُولِ."]],"20:129":[[6,2,"لَكَانَ لِزَامًا","لَكَانَ الهَلَاكُ عَاجِلًا لَازِمًا."]],"20:130":[[14,1,"آنَاءَ","سَاعَاتِ."]],"20:131":[[1,2,"وَلَا تَمُدَّنَّ","لَا تَنْظُرْ، وَلَا تَلْتَفِتْ وَتُعْجَبْ."],[8,1,"أَزْوَاجًا","أَصْنَافًا مِنَ المُشْرِكِينَ."]],"20:133":[[2,1,"لَوْلَا","هَلَّا."]],"20:135":[[3,1,"مُّتَرَبِّصٌ","مُنْتَظِرٌ."],[9,1,"السَّوِيِّ","المُسْتَقِيمِ."]]}