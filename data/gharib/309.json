{"19:52":[[4,1,"الطُّورِ","جَبَلٌ بِسَيْنَاءَ."],[7,1,"نَجِيًّا","مُنَاجِيًا لَنَا."]],"19:58":[[18,1,"وَإِسْرَائِيلَ","يَعْقُوبَ - عليه السلام -."],[21,1,"وَاجْتَبَيْنَا","اصْطَفَيْنَا."]],"19:59":[[4,1,"خَلْفٌ","أَتْبَاعُ سُوءٍ."],[11,1,"غَيًّا","شَرًّا وَخَيْبَةً فِي جَهَنَّمَ."]],"19:61":[[11,1,"مَاتِيًّا","آتِيًا لَا مَحَالَةَ."]],"19:62":[[4,1,"لَغْوًا","بَاطِلًا."]],"19:63":[[4,1,"نُورِثُ","نُعْطِي."]]}