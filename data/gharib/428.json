{"34:2":[[3,1,"يَلِجُ","يَدْخُلُ."],[14,1,"يَعْرُجُ","يَصْعَدُ."]],"34:3":[[13,2,"لَا يَعْزُبُ","لَا يَغِيبُ."],[16,2,"مِثْقَالُ ذَرَّةٍ","وَزْنُ نَمْلَةٍ صَغِيرَةٍ."]],"34:5":[[5,1,"مُعَاجِزِينَ","مُشَاقِّينَ اللهَ، مُغَالِبِينَ أَمْرَهُ."],[8,4,"عَذَابٌ مِّن رِّجْزٍ أَلِيمٌ","أَسْوَأُ العَذَابِ، وَأَشَدُّهُ أَلَمًا."]],"34:6":[[14,1,"صِرَاطِ","طَرِيقِ."]],"34:7":[[10,1,"مُزِّقْتُمْ","مُتُّمْ، وَتَفَرَّقَتْ أَجْسَادُكُمْ فيِ الأَرْضِ."]]}