{"43:35":[[1,1,"وَزُخْرُفًا","ذَهَبًا."],[2,4,"وَإِن كُلُّ ذَلِكَ لَمَّا","مَا كُلُّ ذَلِكَ إِلَّا."]],"43:36":[[2,1,"يَعْشُ","يُعْرِضْ."],[6,1,"نُقَيِّضْ","نُهَيِّئْ، وَنُيَسِّرْ."],[11,1,"قَرِينٌ","مُلَازِمٌ، وَمُصَاحِبٌ."]],"43:38":[[8,2,"بُعْدَ الْمَشْرِقَيْنِ","مِثْلَ تَبَاعُدِ مَا بَيْنَ المَشْرِقِ، وَالمَغْرِبِ."]],"43:44":[[2,1,"لَذِكْرٌ","لَشَرَفٌ؛ لِأَنَّهُ أُنْزِلَ بِلُغَتِهِمْ."]],"43:46":[[7,1,"وَمَلَئِهِ","أَشْرَافُ قَوْمِهِ."]]}