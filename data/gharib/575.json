{"73:20":[[5,1,"تَقُومُ","تُصَلِّي مُتَهَجِّدًا مِنَ اللَّيْلِ."],[6,1,"أَدْنَى","أَقَلَّ."],[22,2,"لَّن تُحْصُوهُ","لَنْ يُمْكِنَكُمْ قِيَامُ اللَّيْلِ كُلِّهِ."],[24,2,"فَتَابَ عَلَيْكُمْ","خَفَّفَ عَلَيْكُمْ."],[40,1,"يَبْتَغُونَ","يَطْلُبُونَ بِالتَّنَقُّلِ فِي الأَرْضِ."],[42,2,"فَضْلِ اللَّهِ","رِزْقِ اللهِ."],[57,1,"وَأَقْرِضُوا","تَصَدَّقُوا."],[59,2,"قَرْضًا حَسَنًا","صَدَقَةً بِاخْلَاصٍ، وَطِيبِ نَفْسٍ."]],"74:1":[[2,1,"الْمُدَّثِّرُ","أَصْلُهُ: المُتَدَثِّرُ، وَهُوَ المُتَغَطِّيِ بِثِيَابِهِ."]],"74:3":[[1,2,"وَرَبَّكَ فَكَبِّرْ","اخْصُصْ رَبَّكَ بِالتَّكْبِيرِ وَالتَّعْظِيمِ."]],"74:4":[[1,2,"وَثِيَابَكَ فَطَهِّرْ","طَهِّرْ نَفْسَكَ مِنَ المَعَاصِي وَالآثَامِ."]],"74:5":[[1,1,"وَالرُّجْزَ","الأَصْنَامَ، وَأَعْمَالَ الشِّرْكِ."]],"74:6":[[1,3,"وَلَا تَمْنُن تَسْتَكْثِرُ","لَا تُعْطِ العَطِيَّةَ، كَيْ تَلْتَمِسَ أَكْثَرَ مِنْهَا."]],"74:8":[[2,3,"نُقِرَ فِي النَّاقُورِ","نُفِخَ فِي الصُّورِ نَفْخَةُ البَعْثِ."]],"74:11":[[4,1,"وَحِيدًا","فَرِيدًا لَا مَالَ لَهُ، وَلَا وَلَدَ، وَالمُرَادُ بِهِ: (الوَلِيدُ بْنُ المَغيرَةِ) ."]],"74:12":[[4,1,"مَّمْدُودًا","مَبْسُوطًا وَاسِعًا."]],"74:13":[[2,1,"شُهُودًا","حُضُورًا مَعَهُ فِي مَكَّةَ لَا يَغِيبُونَ عَنْهُ."]],"74:14":[[1,3,"وَمَهَّدتُّ لَهُ تَمْهِيدًا","يَسَّرْتُ لَهُ سُبُلَ العَيْشِ تَيْسِيرًا."]],"74:17":[[1,2,"سَأُرْهِقُهُ صَعُودًا","سَأُكَلِّفُهُ عَذَابًا شَاقًّا لَا رَاحَةَ لَهُ فِيهِ."]],"74:18":[[3,1,"وَقَدَّرَ","هَيَّأَ مَا يَقُولُهُ فِي الطَّعْنِ فِي القُرْآنِ، وَمَنْ جَاءَ بِهِ."]]}