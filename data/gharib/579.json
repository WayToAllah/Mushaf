{"76:6":[[2,2,"يَشْرَبُ بِهَا","يَشْرَبُونَ مُتَلَذِّذِينَ بِهَا."],[6,1,"يُفَجِّرُونَهَا","يُجْرُونَهَا إِجْرَاءً سَهْلًا حَيْثُ شَاؤُوا."]],"76:7":[[2,1,"بِالنَّذْرِ","بِمَا أَوْجَبُوا عَلَى أَنْفُسِهِمْ مِنَ الطَّاعَاتِ."],[7,1,"مُسْتَطِيرًا","فَاشِيًا مُنْتَشِرًا عَلَى النَّاسِ."]],"76:8":[[6,1,"وَيَتِيمًا","طِفْلًا مَاتَ وَالِدُهُ قَبْلَ بُلُوغِهِ، وَلَا مَالَ لَهُ."],[7,1,"وَأَسِيرًا","المَاخُوذَ فِي الحَرْبِ."]],"76:10":[[6,1,"عَبُوسًا","تَكْلَحُ فِيهِ الوُجُوهُ لِهَوْلِهِ."],[7,1,"قَمْطَرِيرًا","شَدِيدَ العُبُوسِ."]],"76:11":[[6,1,"وَلَقَّاهُمْ","أَعْطَاهُمْ."],[7,1,"نَضْرَةً","حُسْنًا وَنُورًا."]],"76:13":[[4,1,"الْأَرَائِكِ","الأَسِرَّةِ المُزَيَّنَةِ بِفَاخِرِ الثِّيَابِ، وَالسُّتُورِ."],[10,1,"زَمْهَرِيرًا","شِدَّةَ بَرْدٍ."]],"76:14":[[1,1,"وَدَانِيَةً","قَرِيبَةً أَشْجَارُهَا."],[4,2,"وَذُلِّلَتْ قُطُوفُهَا","سُهِّلَ لَهُمْ أَخْذُ ثِمَارِهَا."]],"76:15":[[8,1,"قَوَارِيرَا","مِنَ الزُّجَاجِ."]],"76:16":[[4,1,"قَدَّرُوهَا","قَدَّرَهَا السُّقَاةُ عَلَى مِقْدَارِ مَا يَشْتَهِي الشَّارِبُونَ."]],"76:17":[[3,1,"كَاسًا","إِنَاءً مَمْلُوءًا خَمْرًا."]],"76:18":[[3,2,"تُسَمَّى سَلْسَبِيلًا","سُمِّيَتْ بِذَلِكَ؛ لِسَلَاسَةِ شُرْبِهَا، وَسُهُولَةِ مَسَاغِهِ."]],"76:19":[[3,2,"وِلْدَانٌ مُّخَلَّدُونَ","غِلْمَانٌ لِلْخِدْمَةِ دَائِمُونَ عَلَى حَالِهِمْ."],[8,1,"لُؤْلُؤًا","كَاللُّؤْلُؤِ المُفَرَّقِ المُضِيءِ؛ لِحُسْنِهِمْ، وَصَفَاءِ أَلْوَانِهِمْ."]],"76:20":[[1,3,"وَإِذَا رَأَيْتَ ثَمَّ","وَإِذَا أَبْصَرْتَ أَيَّ مَكَانٍ فِي الجَنَّةِ."]],"76:21":[[1,1,"عَالِيَهُمْ","يَعْلُوهُمْ."],[2,2,"ثِيَابُ سُندُسٍ","الحَرِيرُ الرَّقِيقُ الأَخْضَرُ؛ وَهَذَا بَاطِنُ الثِّيَابِ."],[5,1,"وَإِسْتَبْرَقٌ","الحَرِيرُ الغَلِيظُ؛ وَهَذَا ظَاهِرُ الثُيَابِ."],[13,1,"طَهُورًا","لَا رِجْسَ فِيهِ، وَلَا دَنَسَ."]],"76:22":[[7,1,"سَعْيُكُم","عَمَلُكُمُ الصَّالِحُ فِي الدُّنْيَا."]],"76:24":[[2,2,"لِحُكْمِ رَبِّكَ","لِأَمْرِهِ القَدَرِيِّ فَتَقْبَلُهُ، وَلَأَمْرِهِ الشَّرْعِيِّ فَتَمْضِي عَلَيْهِ."]],"76:25":[[4,2,"بُكْرَةً وَأَصِيلًا","أَوَّلَ النَّهَارِ، وَآخِرَهُ."]]}