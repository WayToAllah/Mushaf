{"2:191":[[3,1,"ثَقِفْتُمُوهُمْ","وَجَدتُّمُوهُم."],[8,1,"وَالْفِتْنَةُ","أَذًى لِلْمُسلِمِينَ، أَوْ شِرْكٌ بِاللهِ."]],"2:195":[[5,3,"وَلَا تُلْقُوا بِأَيْدِيكُمْ","لَا تُوقِعُوا أَنْفُسَكُمْ."],[9,1,"التَّهْلُكَةِ","الهَلَاكِ بِتَرْكِ الجِهَادِ، وَالإِنْفَاقِ فِيهِ."]],"2:196":[[6,1,"أُحْصِرْتُمْ","مُنِعْتُمْ لِمَرَضٍ، أَوْ عَدُوٍّ."],[10,1,"الْهَدْيِ","مَا يُهْدَى إِلَى البَيْتِ مِنَ الأَنْعَامِ."],[33,1,"نُسُكٍ","ذَبِيحَةٍ: شَاةٍ تُذْبَحُ لِفُقَرَاءِ الحَرَمِ."],[64,1,"حَاضِرِي","سَاكِنِي."]]}