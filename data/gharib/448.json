{"37:53":[[7,1,"لَمَدِينُونَ","لَمَجْزِيُّونَ، وَمُحَاسَبُونَ."]],"37:56":[[3,2,"إِنْ كِدتَّ","إِنَّكَ قَارَبْتَ."],[5,1,"لَتُرْدِينِ","لَتُهْلِكُنِي بِضَلَالِكَ، وَإِغْوَائِكَ."]],"37:57":[[6,1,"الْمُحْضَرِينَ","مَنْ أُحْضِرُوا فِي العَذَابِ مَعَكَ."]],"37:62":[[3,1,"نُّزُلًا","ضِيَافَةً."],[5,2,"شَجَرَةُ الزَّقُّومِ","شَجَرَةٌ خَبِيثَةٌ، مَلْعُونَةٌ، مِنْ طَعَامِ أَهْلِ النَّارِ."]],"37:63":[[3,1,"فِتْنَةً","ابْتِلَاءً لَهُمْ؛ حَيْثُ كَذَّبُوا بِوُجُودِ شَجَرَةٍ فيِ النَّارِ."]],"37:64":[[5,2,"أَصْلِ الْجَحِيمِ","قَعْرِ جَهَنَّمَ."]],"37:65":[[1,1,"طَلْعُهَا","ثَمَرُهَا."]],"37:67":[[5,1,"لَشَوْبًا","لَخَلْطًا، وَمِزَاجًا."],[7,1,"حَمِيمٍ","مِنْ مَاءٍ حَارٍّ بَالِغِ الحَرَارَةِ."]],"37:69":[[2,1,"أَلْفَوْا","وَجَدُوا."]],"37:70":[[4,1,"يُهْرَعُونَ","يُسْرِعُونَ فِي مُتَابَعَتِهِمْ عَلَى الضَّلَالِ."]]}