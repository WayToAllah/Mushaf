{"51:7":[[2,2,"ذَاتِ الْحُبُكِ","ذَاتِ الخَلْقِ الحَسَنِ، وَذَاتِ الطُّرُقِ الَّتِي تَسِيُر فِيهَا الكَوَاكِبُ."]],"51:8":[[3,2,"قَوْلٍ مُّخْتَلِفٍ","مُتَنَاقِضٍ، مُضْطَرِبٍ فِي القُرْآنِ وَالرَّسُولِ - صلى الله عليه وسلم -."]],"51:9":[[1,2,"يُؤْفَكُ عَنْهُ","يُصْرَفُ عَنِ القُرْآنِ وَالرَّسُولِ - صلى الله عليه وسلم -."]],"51:10":[[1,2,"قُتِلَ الْخَرَّاصُونَ","قُتِلَ، وَلُعِنَ الكَذَّابُونَ، الظَّانُّونَ غَيْرَ الحَقِّ."]],"51:11":[[4,1,"غَمْرَةٍ","جَهْلٍ يَغْمُرُهُمْ."],[5,1,"سَاهُونَ","غَافِلُونَ عَنْ أَمْرِ الآخِرَةِ."]],"51:12":[[1,1,"يَسْأَلُونَ","سُؤَالَ اسْتِبْعَادٍ وَإِنْكَارٍ."],[2,3,"أَيَّانَ يَوْمُ الدِّينِ","مَتَى يَوْمُ الجَزَاءِ؟!"]],"51:13":[[5,1,"يُفْتَنُونَ","يُحْرَقُونَ، وَيُعَذَّبُونَ."]],"51:14":[[2,1,"فِتْنَتَكُمْ","عَذَابَكُمْ."]],"51:17":[[6,1,"يَهْجَعُونَ","يَنَامُونَ."]],"51:18":[[1,1,"وَبِالْأَسْحَارِ","آخِرِ اللَّيْلِ، قُبَيْلَ الفَجْرِ."]],"51:19":[[4,1,"لِّلسَّائِلِ","لِلْمُحْتَاجِ الَّذِي يَسْأَلُ النَّاسَ."],[5,1,"وَالْمَحْرُومِ","الَّذِي لَا يَسْأَلُ النَّاسَ حَيَاءً."]],"51:23":[[4,2,"إِنَّهُ لَحَقٌّ","إِنَّ مَا وَعَدَكُمْ بِهِ مِنَ الجَزَاءِ لَحَقٌّ ثَابِتٌ."]],"51:24":[[4,2,"ضَيْفِ إِبْرَاهِيمَ","أَضْيَافِهِ مِنَ المَلَائِكَةِ."]],"51:25":[[9,1,"مُّنكَرُونَ","غُرَبَاءُ لَا تُعْرَفُونَ."]],"51:26":[[1,1,"فَرَاغَ","مَالَ، وَعَدَلَ بِخُفْيَةٍ."]],"51:28":[[1,2,"فَأَوْجَسَ مِنْهُمْ","أَحَسَّ فِي نَفْسِهِ مِنْهُمِ."],[8,1,"بِغُلَامٍ","هُوَ: إِسْحَاقُ - عليه السلام -."]],"51:29":[[2,1,"امْرَأَتُهُ","هِيَ: سَارَةُ."],[4,1,"صَرَّةٍ","صَيْحَةٍ، وَضَجَّةٍ."],[5,2,"فَصَكَّتْ وَجْهَهَا","لَطَمَتْهُ بِيَدِهَا تَعَجُّبًا."],[9,1,"عَقِيمٌ","لَا يُولَدُ لِي وَلَدٌ."]]}