{"9:55":[[14,2,"وَتَزْهَقَ أَنفُسُهُمْ","تَخْرُجَ أَرْوَاحُهُمْ."]],"9:56":[[10,1,"يَفْرَقُونَ","يَخَافُونَ."]],"9:57":[[3,1,"مَلْجَأً","مَامَنًا، وَحِصْنًا."],[5,1,"مَغَارَاتٍ","كُهُوفًا فِي الجِبَالِ."],[7,1,"مُدَّخَلًا","نَفَقًا."],[11,1,"يَجْمَحُونَ","يُسْرِعُونَ."]],"9:58":[[3,1,"يَلْمِزُكَ","يَعِيبُكَ."]],"9:59":[[9,2,"حَسْبُنَا اللهُ","كَافِينَا اللهُ."]],"9:60":[[3,1,"لِلْفُقَرَاءِ","لِلَّذِينَ لَا يَمْلِكُونَ شَيْئًا."],[4,1,"وَالْمَسَاكِينِ","الَّذِينَ يَمْلِكُونَ دُونَ كِفَايَتِهِمْ."],[5,2,"وَالْعَامِلِينَ عَلَيْهَا","السُّعَاةِ الَّذِينَ يَجْمَعُونَ الزَّكَاةَ."],[7,2,"وَالْمُؤَلَّفَةِ قُلُوبُهُمْ","مَنْ يُرْجَى إِسْلَامُهُمْ، أَوْ دَفْعُ شَرِّهِمْ."],[10,1,"الرِّقَابِ","عِتْقِ الأَرِقَّاءِ، وَفَكَاكِ الأَسْرَى."],[11,1,"وَالْغَارِمِينَ","المَدِينِينَ، وَمَنْ غَرِمُوا لِإِصْلَاحِ ذَاتِ البَيْنِ."],[12,3,"وَفِي سَبِيلِ اللهِ","فِي الِجهَادِ."],[15,2,"وَابْنِ السَّبِيلِ","المُسَافِرِ، المُنْقَطِعِ."]],"9:61":[[7,1,"أُذُنٌ","يَسْتَمِعُ لِكُلِّ مَا يُقَالُ لَهُ، فَيُصَدِّقُهُ."],[14,2,"وَيُؤْمِنُ لِلْمُؤْمِنِينَ","يُصَدِّقُ المُؤْمِنِينَ فِيمَا يُخْبِرُونَهُ."]]}