{"36:14":[[6,1,"فَعَزَّزْنَا","أَيَّدْنَا، وَقَوَّيْنَا."]],"36:18":[[3,2,"تَطَيَّرْنَا بِكُمْ","تَشَاءَمْنَا بِكُمْ."]],"36:19":[[2,2,"طَائِرُكُمْ مَعَكُمْ","شُؤْمُكُمْ، وَأَعْمَالُكُمْ مِنَ الشِّرْكِ وَالشَّرِّ مَعَكُمْ، وَمَرْدُودَةٌ عَلَيْكُمْ."],[4,2,"أَئِن ذُكِّرْتُم","أَإِنْ وُعِظْتُمْ تَشَاءَمْتُمْ؟!"]],"36:20":[[6,1,"يَسْعَى","يُسْرِعُ فِي مَشْيِهِ."]],"36:22":[[6,1,"فَطَرَنِي","خَلَقَنِي."]]}