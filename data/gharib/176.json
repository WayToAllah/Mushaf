{"7:196":[[2,1,"وَلِيِّيَ","نَاصِرِي، وَحَافِظِي مِنْ كُلِّ سُوءٍ."]],"7:199":[[1,2,"خُذِ الْعَفْوَ","خُذْ مَا تَيَسَّرَ مِنْ أَخْلَاقِ النَّاسِ، وَلَا تُكَلِّفْهُمْ مَا لَا يُرِيدُونَ بَذْلَهُ لَكَ."],[4,1,"بِالْعُرْفِ","بِالْمَعْرُوفِ، وَهُوَ كُلُّ قَوْلٍ وَعَمَلٍ حَسَنٍ."],[7,1,"الْجَاهِلِينَ","السُّفَهَاءِ."]],"7:200":[[2,1,"يَنزَغَنَّكَ","يُصِيبَنَّكَ."],[5,1,"نَزْغٌ","وَسْوَسَةٌ، وَتَثْبِيطٌ عَنِ الْخَيْرِ، وَحَثٌّ عَلَى الشَّرِّ."],[6,2,"فَاسْتَعِذْ بِاللهِ","فَالْجَا مُسْتَجِيرًا بِاللهِ."]],"7:201":[[6,3,"طَائِفٌ مِّنَ الشَّيْطَانِ","عَارِضٌ مِنْ وَسْوَسَةِ الشَّيْطَانِ."]],"7:202":[[2,1,"يَمُدُّونَهُمْ","يُعِينُونَهُمْ فِي الْغَوَايَةِ."],[6,2,"لَا يُقْصِرُونَ","لَا يَدَّخِرُونَ وُسْعًا فِي غَوَايَتِهِمْ."]],"7:203":[[7,1,"اجْتَبَيْتَهَا","اخْتَلَقْتَهَا وَأَحْدَثْتَهَا."],[17,1,"بَصَائِرُ","حُجَجٌ، وَبَرَاهِينُ."]],"7:205":[[5,1,"تَضَرُّعًا","تَخَشُّعًا وَتَذّلُّلًا."],[6,1,"وَخِيفَةً","تَوَاضُعًا، وَخَوْفًا مِنْهُ."],[11,1,"بِالْغُدُوِّ","بأَوَّلِ النَّهَارِ."],[12,1,"وَالآصَالِ","آخِرِ النَّهَارِ."]],"7:206":[[9,1,"وَيُسَبِّحُونَهُ","يُنَزِّهُونَهُ عَمَّا لَا يَلِيقُ بِجَلَالِهِ."]]}