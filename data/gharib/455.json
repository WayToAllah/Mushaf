{"38:27":[[7,1,"بَاطِلًا","عَبَثًا وَلَهْوًا."],[12,1,"فَوَيْلٌ","فَهَلَاكٌ."]],"38:30":[[7,1,"أَوَّابٌ","كَثِيرُ الرُّجُوعِ إِلَى اللِه بِالتَّوْبَةِ، وَالطَّاعَةِ."]],"38:31":[[4,1,"بِالْعَشِيِّ","عَصْرًا."],[5,1,"الصَّافِنَاتُ","الخُيُولُ الوَاقِفَةُ عَلَى ثَلَاثِ قَوَائِمَ، وَتَرْفَعُ الرَّابِعَةَ؛ لِنَجَابَتِهَا وَخِفَّتِهَا."],[6,1,"الْجِيَادُ","الخُيُولُ الأَصِيلَةُ السَّرِيعَةُ."]],"38:32":[[3,3,"أَحْبَبْتُ حُبَّ الْخَيْرِ","آثَرْتُ حُبَّ المَالِ."],[10,2,"تَوَارَتْ بِالْحِجَابِ","غَابَتِ الشَّمْسُ، أَوْ غَابَتِ الخَيْلُ عَنْ عَيْنِهِ."]],"38:33":[[3,1,"فَطَفِقَ","شَرَعَ."],[4,3,"مَسْحًا بِالسُّوقِ وَالْأَعْنَاقِ","يَمْسَحُ سِيقَانَهَا وَأَعْنَاقَهَا، أَوْ يَقْطَعُهَا بِالسَّيْفِ تَقَرُّبًا إِلَى اللهِ."]],"38:34":[[2,1,"فَتَنَّا","ابْتَلَيْنَا."],[7,1,"جَسَدًا","شِقَّ إِنْسَانٍ وُلِدَ لَهُ."],[9,1,"أَنَابَ","رَجَعَ إِلَى اللهِ بِالتَّوْبَةِ."]],"38:36":[[6,1,"رُخَاءً","لَيِّنَةً طَيِّعَةً."],[7,2,"حَيْثُ أَصَابَ","حَيْثُ أَرَادَ."]],"38:38":[[2,1,"مُقَرَّنِينَ","مُوثَقِينَ."],[4,1,"الْأَصْفَادِ","الأَغْلَالِ."]],"38:39":[[3,1,"فَامْنُنْ","أَعْطِ مَنْ شَئْتَ."]],"38:40":[[4,1,"لَزُلْفَى","لَقُرْبَى وَكَرَامَةً."],[5,2,"وَحُسْنَ مَآبٍ","حُسْنَ مَرْجِعٍ فِي الآخِرَةِ."]],"38:41":[[10,1,"بِنُصْبٍ","مَشَقَّةٍ، وَتَعَبٍ."],[11,1,"وَعَذَابٍ","أَلَمٍ فِي جَسَدِيِ، وَمَالِي، وَأَهْلِي."]],"38:42":[[1,2,"ارْكُضْ بِرِجْلِكَ","اضْرِبْ بِرِجْلِكَ الأَرْضَ لِيَنْبُعَ لَكَ المَاءُ."],[4,2,"مُغْتَسَلٌ بَارِدٌ","مَاءٌ تَغْتَسِلُ بِهِ، فِيهِ شِفَاؤُكَ."]]}