{"86:1":[[2,1,"وَالطَّارِقِ","النَّجْمِ الَّذِي يَطْلُعُ لَيْلًا."]],"86:3":[[2,1,"الثَّاقِبُ","المُضِيءُ المُتَوَهِّجُ."]],"86:4":[[1,4,"إِنْ كُلُّ نَفْسٍ لَّمَّا","مَا كُلُّ نَفْسٍ إِلَّا."],[6,1,"حَافِظٌ","مَلَكٌ يَحْفَظُ أَعْمَالَهَا."]],"86:6":[[4,1,"دَافِقٍ","مُنْصَبٍّ بِسُرْعَةٍ فِي الرَّحِمِ."]],"86:7":[[4,1,"الصُّلْبِ","الظَّهْرِ."],[5,1,"وَالتَّرَائِبِ","عِظَامِ الصَّدْرِ."]],"86:8":[[3,1,"رَجْعِهِ","رَدِّهِ حَيًّا بَعْدَ المَوْتِ."]],"86:9":[[2,2,"تُبْلَى السَّرَائِرُ","تُخْتَبَرُ، وَتُكْشَفُ ضَمَائِرُ القُلُوبِ."]],"86:11":[[2,2,"ذَاتِ الرَّجْعِ","صَاحِبَةِ المَطَرِ المُتَكَرِّرِ."]],"86:12":[[2,2,"ذَاتِ الصَّدْعِ","ذَاتِ التَّشَقُّقِ بِالنَّبَاتِ."]],"86:13":[[3,1,"فَصْلٌ","فَاصِلٌ بَيْنَ الحَقِّ، وَالبَاطِلِ."]],"86:17":[[4,1,"رُوَيْدًا","قَلِيلًا."]],"87:1":[[1,3,"سَبِّحِ اسْمَ رَبِّكَ","نَزِّهْ رَبَّكَ ذَاكِرًا اسْمَهُ بِلِسَانِكَ."],[4,1,"الْأَعْلَى","الَّذِي لَهُ عُلُوُّ الذَّاتِ، وَعُلُوَّ القَدْرِ، وَعُلُوُّ القَهْرِ."]],"87:2":[[3,1,"فَسَوَّى","أَتْقَنَ خَلْقَهُ، وَأَحْسَنَهُ."]],"87:3":[[3,1,"فَهَدَى","يَسَّرَ لَهُ مَا يُنَاسِبُهُ."]],"87:4":[[3,1,"الْمَرْعَى","الكَلَأَ الأَخْضَرَ."]],"87:5":[[2,1,"غُثَاءً","هَشِيمًا جَافًّا."],[3,1,"أَحْوَى","مُتَغَيِّرًا."]],"87:7":[[1,4,"إِلَّا مَا شَاءَ اللَّهُ","إِلَّا مَا أَرادَ اللهُ أَنْ يَنْسَخَ تِلَاوَتَهُ وَحُكْمَهُ، وَيُنْسِيَكَ إِيَّاهُ."]],"87:8":[[2,1,"لِلْيُسْرَى","لِلطَّرِيقَةِ المُيَسَّرَةِ فِي شَرِيعَتِكَ، وَحَيَاتِكَ."]]}