{"7:138":[[1,1,"وَجَاوَزْنَا","عَبَرْنَا."],[8,1,"يَعْكُفُونَ","يُقِيمُونَ عَابِدِينَ."],[16,1,"إِلَهًا","صَنَمًا."]],"7:139":[[3,1,"مُتَبَّرٌ","مُهْلَكٌ."]],"7:141":[[6,1,"يَسُومُونَكُمْ","يُذِيقُونَكُمْ، وَيُكَلِّفُونَكُمْ."]],"7:143":[[4,1,"لِمِيقَاتِنَا","فِي الوَقْتِ الَّذِي وَاعَدْنَاهُ فِيهِ."],[32,1,"صَعِقًا","مَغْشِيًّا عَلَيْهِ."]]}