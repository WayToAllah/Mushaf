{"41:12":[[1,1,"فَقَضَاهُنَّ","فَخَلَقَهُنَّ، وَأَبْدَعَهُنَّ."],[14,1,"بِمَصَابِيحَ","بِنُجُومٍ مُضِيئَةٍ."],[15,1,"وَحِفْظًا","حَرَسًا مِنَ الشَّيَاطِينِ."]],"41:13":[[4,1,"أَنذَرْتُكُمْ","خَوَّفْتُكُمْ."],[5,1,"صَاعِقَةً","عَذَابًا هَائِلًا."]],"41:16":[[4,1,"صَرْصَرًا","شَدِيدَةَ البُرُودَةِ، عَالِيَةَ الصَّوْتِ."],[7,1,"نَّحِسَاتٍ","مَشْؤُومَاتٍ."],[10,1,"الْخِزْيِ","الذُّلِّ وَالهَوَانِ."]],"41:17":[[3,1,"فَهَدَيْنَاهُمْ","فَبَيَّنَّا لَهُمْ سَبِيلَ الحَقِّ."],[4,1,"فَاسْتَحَبُّوا","فَاخْتَارُوا."],[11,1,"الْهُونِ","المُهِينِ."]],"41:19":[[8,1,"يُوزَعُونَ","يُرَدُّ أَوَّلُهُمْ عَلَى آخِرِهِمْ."]]}