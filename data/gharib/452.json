{"37:154":[[1,4,"مَا لَكُمْ كَيْفَ تَحْكُمُونَ","بِئْسَ الحُكْمُ مَا تَحْكُمُونَهُ."]],"37:156":[[3,1,"سُلْطَانٌ","حُجَّةٌ."]],"37:158":[[4,1,"الْجِنَّةِ","المَلَائِكَةِ، سُمُّوا بِذَلِكَ؛ لِاجْتِنَانِهِمْ عَنِ الأَبْصَارِ."],[5,1,"نَسَبًا","قَرَابَةً."],[10,1,"لَمُحْضَرُونَ","إِنَّ الكُفَّارَ سَيُحْضَرُونَ لِلْعَذَابِ يَوْمَ القِيَامَةِ."]],"37:159":[[1,2,"سُبْحَانَ اللَّهِ","تَنْزِيهًا للهِ."]],"37:162":[[4,1,"بِفَاتِنِينَ","بِمُضِلِّينَ أَحدًا."]],"37:163":[[4,2,"صَالِ الْجَحِيمِ","مَنْ يَصْلَى الجَحِيمَ بِدُخُولِهَا وَمُقَاسَاةِ حَرِّهَا."]],"37:165":[[3,1,"الصَّافُّونَ","الوَاقِفُونَ صُفُوفًا فِي عِبَادَةِ اللهِ."]],"37:166":[[3,1,"الْمُسَبِّحُونَ","المُنَزِّهُونَ اللهَ عَنْ كُلِّ مَا لَا يَلِيقُ بِه."]],"37:168":[[4,3,"ذِكْرًا مِّنْ الْأَوَّلِينَ","كِتَابًا مِنْ كُتُبِ الأَنْبِيَاءِ السَّابِقِينَ."]],"37:174":[[1,2,"فَتَوَلَّ عَنْهُمْ","أَعْرِضْ عَمَّنْ عَانَدَ."]],"37:177":[[3,1,"بِسَاحَتِهِمْ","بِفِنَائِهِمْ."],[4,1,"فَسَاءَ","بِئْسِ."]]}