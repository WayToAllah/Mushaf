{"40:27":[[4,1,"عُذْتُ","اسْتَجَرْتُ."]],"40:28":[[38,1,"مُسْرِفٌ","مُتَجَاوِزٌ لِلْحَدِّ بِتَرْكِ الحَقِّ، وَاتِّبَاعِ البَاطِلِ."]],"40:29":[[5,1,"ظَاهِرِينَ","غَالِبِينَ عَالِينَ."],[11,2,"بَاسِ اللَّهِ","عَذَابِ اللهِ."],[17,2,"مَا أُرِيكُمْ","مَا أُشِيرُ عَلَيْكُمْ."],[23,1,"أَهْدِيكُمْ","أَدْعُوكُمْ."],[25,2,"سَبِيلَ الرَّشَادِ","طَرِيقَ الحَقِّ وَالصَّوَابِ."]],"40:30":[[10,1,"الْأَحْزَابِ","الأُمَمِ المُتَحَزِّبَةِ عَلَى أَنْبِيَائِهَا، المُعَادِيَةِ لِهُمْ."]],"40:31":[[2,3,"دَابِ قَوْمِ نُوحٍ","عَادَتِهِمْ فيِ الكُفْرِ وَالتَّكْذِيبِ."]],"40:32":[[5,2,"يَوْمَ التَّنَادِ","يَوْمَ القِيَامَةِ الَّذِي يُنَادِي النَّاسُ فِيهِ بَعْضُهُمْ بَعْضًا."]],"40:33":[[3,1,"مُدْبِرِينَ","هَارِبِينَ."],[9,1,"عَاصِمٍ","مَانِعٍ يَمْنَعُكُمْ."]]}