{"2:282":[[5,1,"تَدَايَنتُم","تَعَامَلْتُمْ بِالدُّيُونِ."],[15,2,"وَلَا يَابَ","لَا يَمْتَنِعْ."],[24,1,"وَلْيُمْلِلِ","لِيُمْلِ، وَيُقِرَّ."],[32,1,"يَبْخَسْ","يَنْقُصْ."],[40,1,"سَفِيهًا","مَحْجُورًا عَلَيْهِ؛ لِتَبْذِيرِهِ."],[42,1,"ضَعِيفًا","كَالصَّغِيرِ وَالمَجْنُونِ."],[67,1,"تَضِلَّ","تَنْسَى."],[79,1,"تَسْأَمُوْا","تَمَلُّوا."],[88,1,"أَقْسَطُ","أَعْدَلُ."],[91,2,"وَأَقْومُ لِلشَّهَادَةِ","أَعْظَمُ عَوْنًا عَلَى إِقَامَةِ الشَّهَادَةِ."],[93,1,"وَأَدْنَى","أَقْرَبُ."],[95,1,"تَرْتَابُوا","تَشُكُّوا."],[105,1,"جُنَاحٌ","حَرَجٌ."]]}