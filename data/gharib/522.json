{"51:31":[[2,2,"فَمَا خَطْبُكُمْ","مَا شَانُكُمْ؟"]],"51:34":[[1,1,"مُسَوَّمَةً","مُعَلَّمَةً بِأَنَّهَا لِعَذَابِ المُسْرِفِينَ."]],"51:37":[[2,2,"فِيهَا آيَةً","فِي قَرْيَتِهِمْ أَثَرًا مِنَ العَذَابِ بَاقِيًا؛ عَلَامَةً عَلَى قُدْرَةِ اللهِ."]],"51:38":[[1,2,"وَفِي مُوسَى","فِي إِرْسَالِنَا مُوسَى - عليه السلام -: آيَةٌ لِلَّذِينَ يَخَافُونَ العَذَابَ."],[7,2,"بِسُلْطَانٍ مُّبِينٍ","بِآيَاتٍ، وَمُعْجِزَاتٍ ظَاهِرَةٍ."]],"51:39":[[1,2,"فَتَوَلَّى بِرُكْنِهِ","أَعْرَضَ فِرْعَوْنُ؛ مُغْتَرًّا بِقُوَّتِهِ وَجَانِبِهِ."]],"51:40":[[3,3,"فَنَبَذْنَاهُمْ فِي الْيَمِّ","طَرَحْنَاهُمْ فِي البَحْرِ."],[7,1,"مُلِيمٌ","آتٍ بِمَا يُلاُم عَلَيْهِ."]],"51:41":[[7,1,"الْعَقِيمَ","الَّتِي لَا بَرَكَةَ فِيهَا، وَلَا تَاتِي بِخَيْرٍ."]],"51:42":[[1,2,"مَا تَذَرُ","مَا تَدَعُ."],[9,1,"كَالرَّمِيمِ","كَالشَّيْءِ البَالِي."]],"51:43":[[6,3,"تَمَتَّعُوا حَتَّى حِينٍ","انْتَفِعُوا بِحَيَاتِكُمْ حَتَّى تَنْتَهِيَ آجَالُكُمْ."]],"51:44":[[1,1,"فَعَتَوْا","تَكَبَّرُوا، وَعَصَوْا."],[6,1,"الصَّاعِقَةُ","الصَّيْحَةُ المُهْلِكَةُ."]],"51:45":[[3,2,"مِن قِيَامٍ","مِنْ نُهُوضٍ، وَلَا هَرَبٍ."]],"51:47":[[3,1,"بِأَيْدٍ","بِقُوَّةٍ، وَقُدْرَةٍ عَظِيمَةٍ."]],"51:48":[[2,1,"فَرَشْنَاهَا","مَهَّدْنَاهَا، وَبَسَطْنَاهَا."]],"51:49":[[5,1,"زَوْجَيْنِ","صِنْفَيْنِ، وَنَوْعَيْنِ مُخْتَلِفَيْنِ."]]}