{"87:12":[[2,2,"يَصْلَى النَّارَ","يَدْخُلُهَا، وَيُقَاسِي حَرَّهَا."]],"87:14":[[2,1,"أَفْلَحَ","فَازَ، وَظَفِرَ بِالمَطْلُوبِ."],[4,1,"تَزَكَّى","طَهَّرَ نَفْسَهُ مِنَ المَعَاصِي، وَحَلَّاهَا بِالطَّاعَةِ."]],"87:18":[[1,2,"إِنَّ هَذَا","أَيْ: مِنْ قَوْلِهِ: {قَدْ أَفْلَحَ مَن تَزَكَّى} ."]],"88:1":[[4,1,"الْغَاشِيَةِ","القِيَامَةِ تَغْشَى النَّاسَ بِأَهْوَالِهَا."]],"88:2":[[3,1,"خَاشِعَةٌ","ذَلِيلَةٌ مُنْكَسِرَةٌ."]],"88:3":[[1,2,"عَامِلَةٌ نَّاصِبَةٌ","مُجْهَدَةٌ بِالعَمَلِ وَالتَّعَبِ فِي النَّارِ."]],"88:4":[[1,2,"تَصْلَى نَارًا","تَدْخُلُ نَارًا، وَتُقَاسِي حَرَّهَا."],[3,1,"حَامِيَةً","شَدِيدَةَ التَّوَهُّجِ."]],"88:5":[[4,1,"آنِيَةٍ","شَدِيدَةِ الحَرَارَةِ."]],"88:6":[[6,1,"ضَرِيعٍ","نَبْتٍ خَبِيثٍ ذِي شَوْكٍ، لَا تَرْعَاهُ الدَّوَابُّ."]],"88:9":[[1,1,"لِسَعْيِهَا","لِعَمَلِهَا بِالطَّاعَةِ فِي الدُّنْيَا."]],"88:11":[[4,1,"لَاغِيَةً","لَا كَلِمَةَ لَغْوٍ وَاحِدَةً، وَلَا نَفْسًا تَلْغُو وَتَهْذِي."]],"88:12":[[3,1,"جَارِيَةٌ","مُتَدَفِّقَةٌ بِالمَاءِ."]],"88:14":[[2,1,"مَّوْضُوعَةٌ","مُعَدَّةٌ لِلشَّارِبِينَ."]],"88:15":[[1,1,"وَنَمَارِقُ","وَسَائِدُ."]],"88:16":[[1,2,"وَزَرَابِيُّ مَبْثُوثَةٌ","بُسُطٌ كَثِيرَةٌ مَفْرُوشَةٌ."]],"88:20":[[4,1,"سُطِحَتْ","بُسِطَتْ، وَمُهِّدَتْ."]],"88:22":[[3,1,"بِمُصَيْطِرٍ","بِمُتَسَلِّطٍ تُكْرِهُهُمْ عَلَى الإِيمَانِ."]]}