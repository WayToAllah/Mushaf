{"49:6":[[7,1,"بِنَبَأٍ","بِخَبَرٍ."],[8,1,"فَتَبَيَّنُوا","فَتَثَبَّتُوا مِنْ خَبَرِهِ."],[9,2,"أَن تُصِيبُوا","خَشْيَةَ أَنْ تُصِيبُوا."]],"49:7":[[12,1,"لَعَنِتُّمْ","لَأَدَّى إِلَى مَشَقَّتِكُمْ، وَعَنَتِكُمْ."]],"49:9":[[9,1,"بَغَتْ","اعْتَدَتْ."],[17,1,"تَفِيءَ","تَرْجِعَ إِلَى حُكْمِ اللهِ وَرَسُولِهِ."],[26,1,"وَأَقْسِطُوا","اعْدِلُوا."],[30,1,"الْمُقْسِطِينَ","العَادِلِينَ فِي أَحْكَامِهِمْ."]],"49:11":[[4,2,"لَا يَسْخَرْ","لَا يَهْزَا، وَيَنْتَقِصْ."],[6,1,"قَومٌ","رِجَالٌ."],[23,2,"وَلَا تَلْمِزُوا","لَا يَعِبْ، وَلَا يَطْعَنْ بَعْضُكُمْ بَعْضًا."],[26,3,"وَلَا تَنَابَزُوا بِالْأَلْقَابِ","لَا يَدْعُ بَعْضُكُمْ بَعْضًا بِمَا يَكْرَهُ مِنَ الأَلْقَابِ."],[29,3,"بِئْسَ الاِسْمُ الْفُسُوقُ","قَبُحَ الاِسْمُ وَالصِّفَةُ الفُسُوقُ؛ وَهُوَ: السُّخْرِيَةُ، وَاللَّمْزُ، وَالتَّنَابُزُ."],[32,2,"بَعْدَ الْإِيمَانِ","بَعْدَمَا دَخَلْتُمْ فِي الإِسْلَامِ."]]}