{"18:6":[[2,1,"بَاخِعٌ","مُهْلِكٌ."],[11,1,"أَسَفًا","حَزَنًا، وَغَمًّا."]],"18:8":[[5,2,"صَعِيدًا جُرُزًا","تُرابًا لَا نَبَاتَ فِيهِ."]],"18:9":[[6,1,"وَالرَّقِيمِ","اللَّوْحِ الَّذِي كُتِبَتْ فِيهِ أَسْمَاؤُهُمْ."]],"18:10":[[2,1,"أَوَى","الْتَجَأَ."]],"18:11":[[1,3,"فَضَرَبْنَا عَلَى آذَانِهِمْ","أَلْقَيْنَا عَلَيْهِمُ النَّوْمَ العَمِيقَ."]],"18:12":[[2,1,"بَعَثْنَاهُمْ","أَيْقَظْنَاهُمْ مِنْ نَوْمِهِمْ."],[5,1,"الْحِزْبَيْنِ","الطَّائِفَتْينِ المُتَنَازِعتَيْنِ فِي مُدَّةِ لُبْثِهِمْ."],[9,1,"أَمَدًا","مُدَّةً، وَغَايَةً."]],"18:14":[[1,3,"وَرَبَطْنَا عَلَى قُلُوبِهِمْ","قَوَّيْنَا قُلُوبَهُمْ بِالإِيمَانِ، وَشَدَدْنَا عَزِيمَتَهُمْ بِهِ."],[19,1,"شَطَطًا","جَائِرًا، بَعِيدًا عَنِ الحَقِّ."]],"18:15":[[10,2,"بِسُلْطَانٍ بَيِّنٍ","بِحُجَّةٍ وَاضِحَةٍ."],[15,1,"افْتَرَى","اخْتَلَقَ."]]}