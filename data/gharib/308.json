{"19:39":[[3,1,"الْحَسْرَةِ","النَّدَامَةِ."]],"19:41":[[7,1,"صِدِّيقًا","عَظِيمَ الصِّدْقِ لَا يَكْذِبُ."]],"19:43":[[12,2,"صِرَاطًا سَوِيًّا","طَرِيقًا لَا عِوَجَ فِيهِ."]],"19:45":[[11,1,"وَلِيًّا","قَرِينًا فِي النَّارِ."]],"19:46":[[12,1,"مَلِيًّا","زَمَنًا طَوِيلًا."]],"19:47":[[10,1,"حَفِيًّا","رَحِيمًا بِحَالِي يُكْرِمُنِي وَيُجِيبُنِي إِذَا دَعَوْتُهُ."]],"19:50":[[7,3,"لِسَانَ صِدْقٍ عَلِيًّا","ذِكْرًا حَسَنًا، وَثَنَاءً بَاقِيًا فِي النَّاسِ."]],"19:51":[[7,1,"مُخْلَصًا","مُصْطَفًى مُخْتَارًا."]]}