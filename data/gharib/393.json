{"28:61":[[17,1,"الْمُحْضَرِينَ","مِمَّنْ أُحْضِرُوا لِلنَّارِ."]],"28:63":[[9,1,"أَغْوَيْنَا","دَعَوْنَاهُمْ لِلْغَوَايَةِ فَاتَّبَعُونَا."]],"28:66":[[1,1,"فَعَمِيَتْ","فَخَفِيَتْ."],[3,1,"الْأَنبَاءُ","الحُجَجُ."]],"28:68":[[5,1,"وَيَخْتَارُ","يَصْطَفِي."],[9,1,"الْخِيَرَةُ","الاِخْتِيَارُ."]],"28:69":[[4,1,"تُكِنُّ","تُخْفِي."]]}