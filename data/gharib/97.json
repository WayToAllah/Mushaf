{"4:114":[[6,1,"نَّجْوَاهُمْ","حَدِيثَهُمْ سِرًّا."]],"4:115":[[2,1,"يُشَاقِقِ","يُخَالِفْ عِنَادًا."],[14,3,"نُوَلِّهِ مَا تَوَلَّى","نَتْرُكْهُ، وَمَا تَوَجَّهَ إِلَيْهِ."]],"4:117":[[6,1,"إِنَاثًا","أَصْنَامًا؛ كَاللَّاتِ وَالعُزَّى وَمَنَاةَ."],[11,1,"مَّرِيدًا","مُتَمَرِّدًا عَاتِيًا."]],"4:118":[[7,2,"نَصِيبًا مَّفْرُوضًا","جُزْءًا مَعْلُومًا."]],"4:119":[[4,1,"فَلَيُبَتِّكُنَّ","فَلَيُقَطِّعُنَّ وَلَيُشَقِّقُنَّ."]],"4:121":[[7,1,"مَحِيصًا","مَحِيدًا، وَمَهْرَبًا."]]}