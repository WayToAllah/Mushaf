{"38:63":[[1,2,"أَتَّخَذْنَاهُمْ سِخْرِيًّا","هَلْ تَحْقِيرُنَا لَهُمْ خَطَأٌ؟"],[4,1,"زَاغَتْ","مَالَتْ، فَلَمْ تَقَعْ عَلَيْهِمْ."]],"38:64":[[4,1,"تَخَاصُمُ","جِدَالُ."]],"38:67":[[3,2,"نَبَأٌ عَظِيمٌ","القُرْآنُ خَبَرٌ عَظِيمُ النَّفْعِ."]],"38:69":[[6,2,"بِالْمَلَإِ الْأَعْلَى","المَلَائِكَةِ."],[9,1,"يَخْتَصِمُونَ","يَتَجَادَلُونَ فِي شَانِ خَلْقِ آدَمَ - عليه السلام -."]],"38:72":[[2,1,"سَوَّيْتُهُ","خَلَقْتُ جَسَدَهُ كَامِلًا مُتَنَاسِقَ الأَعْضَاءِ."],[9,1,"سَاجِدِينَ","سُجُودَ تَحِيَّةٍ وَإِكْرَامٍ، لَا سُجُودَ عِبَادَةٍ وَتَعْظِيمٍ."]],"38:77":[[5,1,"رَجِيمٌ","مَرْجُومٌ مَطْرُودٌ مِنْ رَحْمَةِ اللهِ."]],"38:78":[[3,1,"لَعْنَتِي","طَرْدِي، وَإِبْعَادِي."]],"38:79":[[3,1,"فَأَنظِرْنِي","أَخِّرْنِي."]],"38:82":[[2,1,"فَبِعِزَّتِكَ","بِسُلْطَانِكَ، وَعَظَمَتِكَ."],[3,1,"لَأُغْوِيَنَّهُمْ","لَأُضِلَّنَّهُمْ."]],"38:83":[[4,1,"الْمُخْلَصِينَ","الَّذِينَ أَخْلَصْتَهُمْ، وَاصْطَفَيْتَهُمْ لِعِبَادَتِكَ."]]}