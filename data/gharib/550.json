{"60:6":[[9,2,"يَرْجُو اللَّهَ","يَطْمَعُ فِي الخَيْرِ مِنَ اللهِ."],[14,1,"يَتَوَلَّ","يُعْرِضْ عَنِ الاِقْتِدَاءِ بِالأَنْبِيَاءِ، وَيُوَالِ أَعْدَاءَ اللهِ."],[19,1,"الْحَمِيدُ","المَحْمُودُ فِي ذَاتِهِ، وَصِفَاتِهِ، وَأَفْعَالِهِ."]],"60:7":[[10,1,"مَّوَدَّةً","مَحَبَّةً."]],"60:8":[[15,1,"تَبَرُّوهُمْ","تُكْرِمُوهُمْ."],[16,1,"وَتُقْسِطُوا","تَعْدِلُوا فِيهِمْ."],[21,1,"الْمُقْسِطِينَ","العَادِلِينَ."]],"60:9":[[12,1,"وَظَاهَرُوا","عَاوَنُوا."],[15,2,"أَن تَوَلَّوْهُمْ","أَنْ تَنْصُرُوهُمْ، وَتَوَدُّوهُمْ."]],"60:10":[[8,1,"فَامْتَحِنُوهُنَّ","فَاخْتَبِرُوهُنَّ؛ لِتَعْلَمُوا صِدْقَ إِيمَانِهِنَّ."],[27,3,"وَآتُوهُم مَّا أَنفَقُوا","وَأَعْطُوا أَزْوَاجَ اللَّاتِي أَسْلَمْنَ مِثْلَ مَا أَنْفَقُوا عَلَيْهِنَّ مِنَ المُهُورِ."],[31,1,"جُنَاحَ","إِثْمَ."],[37,1,"أُجُورَهُنَّ","مُهُورَهُنَّ."],[40,2,"بِعِصَمِ الْكَوَافِرِ","بِعُقُودِ نِكَاحِ زَوْجَاتِكُمُ الكَافِرَاتِ."],[42,3,"وَاسْأَلُوا مَا أَنفَقْتُمْ","وَاطْلُبُوا مِنَ المُشْرِكِينَ مُهُورَ نِسَائِكُمُ المُرْتَدَّاتِ اللَّوَاتِي لَحِقْنَ بِهِمْ."]],"60:11":[[1,5,"وَإِن فَاتَكُمْ شَيْءٌ مِّنْ أَزْوَاجِكُمْ","انْفَلَتَتْ وَاحِدَةٌ بِرِدَّةٍ."],[8,1,"فَعَاقَبْتُمْ","فَظَفِرْتُمْ بِالكُفَّارِ، وَغَنِمْتُمْ مِنْهُمْ."]]}