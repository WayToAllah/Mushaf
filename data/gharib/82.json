{"4:24":[[1,1,"وَالْمُحْصَنَاتُ","المُتَزَوِّجَاتُ."],[5,3,"مَا مَلَكَتْ أَيْمَانُكُمْ","المَسْبِيَّاتُ، وَهُنَّ المَاخُوذَاتُ مِنْ نِسَاءِ الكُفَّارِ فِي الجِهَادِ."],[17,1,"تَبْتَغُوا","تَطْلُبُوا."],[19,1,"مُّحْصِنِينَ","أَعِفَّاءَ عَنِ الحَرَامِ."],[21,1,"مُسَافِحِينَ","زَانِينَ."],[27,1,"أُجُورَهُنَّ","مُهُورَهُنَّ."]],"4:25":[[5,1,"طَوْلًا","غِني، وَسَعَةً."],[8,1,"الْمُحْصَنَاتِ","الحَرَائِرَ."],[15,1,"فَتَيَاتِكُمُ","إِمَائِكُمْ."],[29,1,"مُحْصَنَاتٍ","عَفِيفَاتٍ."],[33,2,"مُتَّخِذَاتِ أَخْدَانٍ","مَصَاحِبَاتِ أَصْدِقَاءَ لِلزِّنَا سِرًّا."],[50,1,"الْعَنَتَ","الوُقُوعَ فِي الزِّنَا."]]}