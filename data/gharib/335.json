{"22:24":[[8,2,"صِرَاطِ الْحَمِيدِ","طَرِيقِ الإِسْلَامِ المَحْمُودِ."]],"22:25":[[14,2,"الْعَاكِفُ فِيهِ","المُقِيمُ فِيهِ."],[16,1,"وَالْبَادِ","القَادِمُ إِلَيْهِ."],[18,1,"يُرِدْ","يَهُمَّ."],[20,2,"بِإِلْحَادٍ بِظُلْمٍ","بِمَيْلٍ عَنِ الحَقِّ ظُلْمًا."]],"22:26":[[2,1,"بَوَّانَا","هَيَّانَا، وَبَيَّنَّا."]],"22:27":[[1,1,"وَأَذِّنْ","نادِ وَأَعْلِمْ رَافِعًا صَوْتَكَ."],[6,1,"رِجَالًا","يَمْشُونَ عَلَى أَقْدَامِهِمْ؛ جَمْعُ رَاجِلٍ."],[9,1,"ضَامِرٍ","البَعِيرِ خَفِيفِ اللَّحْمِ مِنَ الأَعْمَالِ لَا مِنَ الهُزَالِ."],[13,2,"فَجٍّ عَمِيقٍ","طَرِيقٍ بَعِيدٍ."]],"22:28":[[8,2,"أَيَّامٍ مَّعْلُومَاتٍ","هِيَ: عَشْرُ ذِي الحِجَّةِ، وَثَلَاثَةُ أَيَّامٍ بَعْدَهُ."],[19,2,"الْبَائِسَ الْفَقِيرَ","الَّذِي اشْتَدَّ فَقْرُهُ."]],"22:29":[[2,2,"لْيَقْضُوا تَفَثَهُمْ","لِيُكْمِلُوا حَجَّهُمْ بِإِحْلَالِهِمْ مِنْ إِحْرَامِهِمْ وَإِزَالَةِ وَسَخِ أَبْدَانِهِمْ."],[5,1,"نُذُورَهُمْ","الحَجَّ، وَالعُمْرَةَ، وَالهَدَايَا."],[8,1,"الْعَتِيقِ","القَدِيمِ الَّذِي أَعْتَقَهُ اللهُ، مِنْ تَسَلُّطِ الجَبَّارِينَ عَلَيْهِ."]],"22:30":[[4,2,"حُرُمَاتِ اللَّهِ","شَعَائِرَ الدِّينِ، وَمَنَاسِكَ الحَجِّ."],[19,3,"الرِّجْسَ مِنَ الْأَوْثَانِ","القَذَارَةَ الَّتِي هِيَ: الأَوْثَانُ."],[23,2,"قَوْلَ الزُّورِ","الكَذِبَ وَالاِفْتِرَاءَ عَلَى اللهِ."]]}