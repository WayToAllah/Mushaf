{"94:3":[[2,1,"أَنقَضَ","أَثْقَلَ."]],"94:7":[[2,1,"فَرَغْتَ","مِنْ أَشْغَالِ الدُّنْيَا."],[3,1,"فَانصَبْ","فَجِدَّ فيِ العِبَادَةِ."]],"94:8":[[3,1,"فَارْغَبْ","فَتَوَجَّهْ، وَاطْلُبْ، وَتَضَرَّعْ."]],"95:2":[[1,2,"وَطُورِ سِينِينَ","جَبَلِ طُورِ سَيْنَاءَ الَّذِي كَلَّمَ اللهُ عَلَيْهِ مُوسَى - عليه السلام -."]],"95:3":[[1,2,"وَهَذَا الْبَلَدِ","مَكَّةَ."]],"95:4":[[6,1,"تَقْوِيمٍ","صُورَةٍ."]],"95:5":[[3,2,"أَسْفَلَ سَافِلِينَ","النَّارَ؛ إِنْ لَمْ يُطِعِ اللهَ."]],"95:6":[[8,2,"غَيْرُ مَمْنُونٍ","غَيْرُ مَقْطُوعٍ، وَلَا مَنْقُوصٍ."]],"95:7":[[4,1,"بِالدِّينِ","بِالبَعْثِ، وَالجَزَاءِ."]],"96:2":[[4,1,"عَلَقٍ","قِطْعَةِ دَمٍ غَلِيظٍ."]],"96:6":[[1,1,"كَلَّا","حَقًّا."],[4,1,"لَيَطْغَى","لَيَتَجَاوُزُ الحَدَّ فِي العِصْيَانِ، وَالكِبْرِ."]],"96:7":[[1,3,"أَنْ رَّآهُ اسْتَغْنَى","بِسَبَبِ أَنْ رَأَى نَفْسَهُ مُسْتَغِنيًا بِمَالِهِ."]],"96:8":[[4,1,"الرُّجْعَى","الرُّجُوعَ، وَالمَصِيرَ."]],"96:9":[[1,1,"أَرَأَيْتَ","أَلَا تَعْجَبُ!!"]]}