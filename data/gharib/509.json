{"47:20":[[18,1,"مَّرَضٌ","شَكٌّ، وَنِفَاقٌ."],[22,2,"الْمَغْشِيِّ عَلَيْهِ","المُغْمَى عَلَيْهِ مِنْ شِدَّةِ الخَوْفِ."]],"47:21":[[5,2,"عَزَمَ الْأَمْرُ","وَجَبَ القِتَالُ."]],"47:22":[[1,2,"فَهَلْ عَسَيْتُمْ","لَعَلَّكُمْ."],[4,1,"تَوَلَّيْتُمْ","أَعْرَضْتُمْ عَنِ الإِيمَانِ."]],"47:24":[[4,1,"أَمْ","بَلْ."],[7,1,"أَقْفَالُهَا","مُغْلَقَةٌ؛ فَلَا تَفْهَمُ القُرْآنَ."]],"47:25":[[3,3,"ارْتَدُّوا عَلَى أَدْبَارِهِم","رَجَعُوا كُفَّارًا."],[13,2,"سَوَّلَ لَهُمْ","زَيَّنَ لَهُمْ خَطَايَاهُمْ."],[15,2,"وَأَمْلَى لَهُمْ","مَدَّ لَهُمْ فِي الأَمِلِ."]],"47:26":[[4,2,"لِلَّذِينَ كَرِهُوا","هُمُ اليَهُودُ."],[15,1,"إِسْرَارَهُمْ","مَا يُخْفُونَهُ، وَيُسِرُّونَهُ."]],"47:28":[[9,2,"فَأَحْبَطَ أَعْمَالَهُمْ","أَبْطَلَ ثَوَابَ أَعْمَالِهِمْ."]],"47:29":[[1,2,"أَمْ حَسِبَ","بَلْ ظَنَّ."],[6,1,"مَّرَضٌ","نِفَاقٌ، وَشَكٌّ."],[11,1,"أَضْغَانَهُمْ","أَحْقَادَهُمْ."]]}