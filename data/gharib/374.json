{"26:166":[[11,1,"عَادُونَ","مُتَجَاوِزُونَ مَا أَبَاحَهُ اللهُ لَكُمْ مِنَ الحَلَالِ إِلَى الحَرَامِ."]],"26:167":[[8,1,"الْمُخْرَجِينَ","المَطْرُودِينَ مِنْ بِلَادِنَا."]],"26:168":[[5,1,"الْقَالِينَ","المُبْغِضِينَ لِعَمَلِكُمْ بُغْضًا شَدِيدًا."]],"26:171":[[4,1,"الْغَابِرِينَ","البَاقِينَ فيِ العَذَابِ."]],"26:173":[[4,1,"فَسَاءَ","قَبُحَ."]],"26:176":[[2,2,"أَصْحَابُ الْأَيْكَةِ","أَصْحَابُ الأَرْضِ ذَاتِ الشَّجَرِ المُلْتَفِّ؛ وَهُمْ قَوْمُ شُعَيْبٍ."]],"26:181":[[6,1,"الْمُخْسِرِينَ","النَّاقِصِينَ لِحُقُوقِ النَّاسِ."]],"26:182":[[2,1,"بِالْقِسْطَاسِ","بِالمِيزَانِ."],[3,1,"الْمُسْتَقِيمِ","العَدْلِ السَّوِيِّ."]],"26:183":[[1,2,"وَلَا تَبْخَسُوا","لَا تَنْقُصُوا."],[5,2,"وَلَا تَعْثَوْا","لَا تُكْثِرُوا الفَسَادَ."]]}