{"16:44":[[2,1,"وَالزُّبُرِ","الكُتُبِ السَّمَاوِيَّةِ."]],"16:45":[[3,2,"مَكَرُوا السَّيِّئَاتِ","دَبَّرُوا المَكَايِدَ."]],"16:46":[[4,1,"تَقَلُّبِهِمْ","أَسْفَارِهِمْ، وَتَصَرُّفَاتِهِمْ."]],"16:47":[[4,1,"تَخَوُّفٍ","حَالِ خَوْفٍ، وَنَقْصٍ فِي الأَمْوَالِ وَالأَنْفُسِ."]],"16:48":[[9,1,"يَتَفَيَّأُ","يَمِيلُ."],[17,1,"دَاخِرُونَ","خَاضِعُونَ لِعَظَمَةِ اللهِ."]],"16:51":[[12,1,"فَارْهَبُونِ","فَخَافُونِي."]],"16:52":[[6,2,"وَلَهُ الدِّينُ","لَهُ العِبَادَةُ وَالطَّاعَةُ وَحْدَهُ."],[8,1,"وَاصِبًا","دَائِمًا."]],"16:53":[[12,1,"تَجْأَرُونَ","تَضِجُّونَ بِالدُّعَاءِ."]]}