{"56:52":[[5,1,"زَقُّومٍ","الزَّقُّومُ: أَقْبَحُ الشَّجَرِ فِي النَّارِ."]],"56:54":[[4,1,"الْحَمِيمِ","مَاءٍ مُتَنَاهٍ فِي الحَرَارَةِ."]],"56:55":[[2,2,"شُرْبَ الْهِيمِ","كَشُرْبِ الإِبِلِ العِطَاشِ الَّتِي لَا تَرْوَى لِدَاءٍ يُصِيبُهَا."]],"56:56":[[2,1,"نُزُلُهُمْ","مَا أُعِدَّ لَهُمْ مِنَ الجَزَاءِ."],[3,2,"يَوْمَ الدِّينِ","يَوْمَ الجَزَاءِ، وَالحِسَابِ."]],"56:57":[[3,2,"فَلَوْلَا تُصَدِّقُونَ","هَلَّا تُصَدِّقُونَ بِالبَعْثِ؟!"]],"56:58":[[2,2,"مَّا تُمْنُونَ","النُّطَفَ الَّتِي تَقْذِفُونَهَا فِي أَرْحَامِ نِسَائِكُمْ."]],"56:60":[[7,1,"بِمَسْبُوقِينَ","بِعَاجِزِينَ."]],"56:65":[[4,1,"حُطَامًا","هَشِيمًا؛ لَا يُنْتَفَعُ بِهِ فِي مَطْعَمٍ."],[5,1,"فَظَلْتُمْ","أَصْبَحْتُمْ."],[6,1,"تَفَكَّهُونَ","تَتَعَجَّبُونَ مِمَّا نَزَلَ بِزَرْعِكُمْ."]],"56:66":[[1,2,"إِنَّا لَمُغْرَمُونَ","تَقُولُونَ: إِنَّا لَخَاسِرُونَ مُعَذَّبُونَ."]],"56:69":[[4,1,"الْمُزْنِ","السَّحَابِ."]],"56:70":[[4,1,"أُجَاجًا","شَدِيدَ المُلُوحَةِ؛ لَا يُنْتَفَعُ بِهِ فِي شُرْبٍ، وَلَا زَرْعٍ."]],"56:71":[[4,1,"تُورُونَ","تُوقِدُونَ، وَتَقْدَحُونَ الزِّنَادَ لِاسْتِخْرَاجِهَا."]],"56:72":[[2,1,"أَنشَاتُمْ","أَوْجَدْتُّمْ."],[3,1,"شَجَرَتَهَا","الشَّجَرَةَ الَّتِي تَقْدَحُ مِنْهَا النَّارُ؛ كَالمَرْخِ والعِفَارِ."]],"56:73":[[3,1,"تَذْكِرَةً","تَذْكِيرًا لَكُمْ بِنَارِ جَهَنَّمَ."],[4,2,"وَمَتَاعًا لِّلْمُقْوِينَ","مَنْفَعَةً لِلْمُسَافِرِينَ."]],"56:74":[[1,3,"فَسَبِّحْ بِاسْمِ رَبِّكَ","نَزِّهُ رَبَّكَ ذَاكِرًا اسْمَهُ."]],"56:75":[[1,2,"فَلَا أُقْسِمُ","أُقْسِمُ وَأَحْلِفُ، وَ (لَا) : تَوْكِيدٌ لِلْقَسَمِ."],[3,2,"بِمَوَاقِعِ النُّجُومِ","بِمَسَاقِطِهَا فِي مَغَارِبِهَا فِي السَّمَاءِ."]]}