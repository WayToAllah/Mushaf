{"67:27":[[2,2,"رَأَوْهُ زُلْفَةً","رَأَوْا عَذَابَ اللهِ قَرِيبًا."],[4,1,"سِيئَتْ","ذَلَّتْ، وَاسْوَدَّتْ."],[13,1,"تَدَّعُونَ","تَطْلُبُونَ أَنْ يُعَجَّلَ لَكُمْ مِنَ العَذَابِ اسْتِهْزَاءً."]],"67:28":[[11,1,"يُجِيرُ","يَحْمِي."]],"67:30":[[2,1,"أَرَأَيْتُمْ","أَخْبِرُونِي."],[6,1,"غَوْرًا","ذَاهِبًا فِي الأَرْضِ لَا تَصِلُونَ إِلَيْهِ بِوَسِيلَةٍ."],[10,1,"مَّعِينٍ","جَارٍ عَلَى وَجْهِ الأَرْضِ، ظَاهِرٍ لِلْعُيُونِ."]],"68:1":[[2,1,"وَالْقَلَمِ","قَسَمٌ بِالقَلَمِ الَّذِي تَكْتُبُ بِهِ المَلَائِكَةُ، وَالنَّاسُ."],[3,2,"وَمَا يَسْطُرُونَ","وَالَّذِي يَكْتُبُونَهُ بِالقَلَمِ."]],"68:3":[[5,1,"مَمْنُونٍ","مَنْقُوصٍ، وَلَا مُنْقَطِعٍ."]],"68:6":[[1,2,"بِأَييِّكُمُ الْمَفْتُونُ","فَي أَيِّ الفَرِيقَيْنِ الفِتْنَةُ، وَالجُنُونُ؟"]],"68:9":[[3,1,"تُدْهِنُ","تُلَايِنُ، وَتُصَانِعُ."]],"68:10":[[4,1,"حَلَّافٍ","كَثِيرِ الحَلِفِ."],[5,1,"مَّهِينٍ","كَذَّابٍ، حَقِيرٍ."]],"68:11":[[1,1,"هَمَّازٍ","مُغْتَابٍ لِلنَّاسِ."],[2,2,"مَّشَّاءٍ بِنَمِيمٍ","يَمْشِي بِالنَّمِيمَةِ، وَهِيَ: نَقْلُ الحَدِيثِ بَيْنَ النَّاسِ عَلَى وَجْهِ الإِفْسَادِ."]],"68:13":[[1,1,"عُتُلٍّ","فَاحِشٍ، لَئِيمٍ، غَلِيظٍ فيِ كُفْرِهِ."],[4,1,"زَنِيمٍ","مَنْسُوبٍ لِغَيْرِ أَبِيهِ."]],"68:14":[[1,2,"أَن كَانَ","مِنْ أَجْلِ أَنَّهُ كَانَ."]],"68:15":[[6,2,"أَسَاطِيرُ الْأَوَّلِينَ","أَبَاطِيلُهُمْ، وَخُرَافَاتُهُمْ."]],"68:16":[[1,1,"سَنَسِمُهُ","سَنَجْعَلُ لَهُ عَلَامَةً لَا تُفَارِقُهُ."],[3,1,"الْخُرْطُومِ","أَنْفِهِ."]]}