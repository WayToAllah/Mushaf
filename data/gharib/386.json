{"28:7":[[12,1,"الْيَمِّ","النَّهْرِ، وَهُوَ نَهْرُ النِّيلِ."]],"28:8":[[13,1,"خَاطِئِينَ","آثِمِينَ."]],"28:9":[[4,3,"قُرَّتُ عَيْنٍ لِّي","مَصْدَرُ سُرُورٍ لِي."]],"28:10":[[5,1,"فَارِغًا","خَالِيًا مِنْ كُلِّ شَيْءٍ إِلَّا هَمَّ مُوسَى - عليه السلام -."],[8,2,"لَتُبْدِي بِهِ","فَتُصَرِّحُ بِأَنَّهُ ابْنُهَا."]],"28:11":[[3,1,"قُصِّيهِ","تَتَبَّعِي أَثَرَهُ."],[6,2,"عَن جُنُبٍ","عَنْ بُعْدٍ."]],"28:12":[[12,2,"يَكْفُلُونَهُ لَكُمْ","يَقُومُونَ بِتَرْبِيَتِهِ وَإِرْضَاعِهِ."]]}