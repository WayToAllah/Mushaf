{"26:84":[[3,2,"لِسَانَ صِدْقٍ","ثَنَاءً حَسَنًا."],[6,1,"الْآخِرِينَ","مَنْ يَاتُونَ بَعْدِي إِلَى يَوْمِ القِيَامَةِ."]],"26:89":[[6,1,"سَلِيمٍ","سَالِمٍ مِنَ الشِّرْكِ وَالنِّفَاقِ وَالضَّغِينَةِ."]],"26:90":[[1,1,"وَأُزْلِفَتِ","قُرِّبَتْ."]],"26:91":[[1,1,"وَبُرِّزَتِ","أُظْهِرَتْ."]],"26:94":[[1,1,"فَكُبْكِبُوا","فَجُمِعُوا، وَأُلْقُوا."]],"26:101":[[3,1,"حَمِيمٍ","مُشْفِقٍ يَهْتَمُّ بِأَمْرِنَا."]],"26:102":[[4,1,"كَرَّةً","رَجْعَةً إِلَى الدُّنْيَا."]],"26:111":[[5,1,"الْأَرْذَلُونَ","السَّفَلَةُ مِنَ النَّاسِ."]]}