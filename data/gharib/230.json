{"11:72":[[2,2,"يَا وَيْلَتَى","كَلِمَةُ تَعَجُّبٍ."],[7,1,"بَعْلِي","زَوْجِي."]],"11:73":[[13,1,"حَمِيدٌ","مَحْمُودُ الصِّفَاتِ وَالأَفْعَالِ."],[14,1,"مَّجِيدٌ","ذُو عَظَمَةٍ."]],"11:74":[[5,1,"الرَّوْعُ","الخَوْفُ."]],"11:75":[[4,1,"أَوَّاهٌ","كَثِيرُ التَّضَرُّعِ وَالدُّعَاءِ."],[5,1,"مُّنِيبٌ","تَائِبٌ يَرْجِعُ إِلَى اللهِ فِي أُمُورِهِ كُلِّهَا."]],"11:77":[[5,2,"سِيءَ بِهِمْ","سَاءَهُ مَجِيئُهُمْ."],[7,3,"وَضَاقَ بِهِمْ ذَرْعًا","ضَاقَ صَدْرُهْ، وَاغْتَمَّ لِمَجِيئِهِمْ؛ خَوْفًا عَلَيْهِمْ مِنْ قَوْمِهِ."],[13,1,"عَصِيبٌ","شَدِيدٌ."]],"11:78":[[3,1,"يُهْرَعُونَ","يُسْرِعُونَ."],[19,2,"وَلَا تُخْزُونِ","لَا تَفْضَحُونِي."],[26,1,"رَّشِيدٌ","يَامُرُ بِالمَعْرُوفِ، وَيَنْهَى عَنِ المُنْكَرِ."]],"11:79":[[8,2,"مِنْ حَقٍّ","مِنْ حَاجَةٍ، أَوْ رَغْبَةٍ."]],"11:81":[[9,1,"فَأَسْرِ","فَاخْرُجْ."],[11,3,"بِقِطْعٍ مِّنَ اللَّيْلِ","بِبَقِيَّةٍ مِنَ اللَّيْلِ."]]}