{"15:52":[[9,1,"وَجِلُونَ","فَزِعُونَ، خَائِفُونَ."]],"15:55":[[7,1,"الْقَانِطِينَ","اليَائِسِينَ."]],"15:57":[[2,2,"فَمَا خَطْبُكُمْ","فَمَا شَانُكُمُ الخَطِيرُ؟"]],"15:60":[[3,1,"قَدَّرْنَا","قَضَيْنَا."],[6,1,"الْغَابِرِينَ","البَاقِينَ فِي العَذَابِ."]],"15:62":[[4,1,"مُّنكَرُونَ","غَيْرُ مَعْرُوفِينَ لِي."]],"15:63":[[7,1,"يَمْتَرُونَ","يَشُكُّونَ."]],"15:65":[[3,1,"بِقِطْعٍ","بِجُزْءٍ."],[6,2,"وَاتَّبِعْ أَدْبَارَهُمْ","سِرْ وَرَاءَهُمْ."],[12,1,"وَامْضُوا","سِيرُوا."]],"15:66":[[1,1,"وَقَضَيْنَا","أَوْحَيْنَا."],[6,1,"دَابِرَ","آخِرَ."],[8,1,"مَقْطُوعٌ","مُهْلَكٌ بِالعَذَابِ."]]}