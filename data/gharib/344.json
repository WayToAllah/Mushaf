{"23:30":[[7,1,"لَمُبْتَلِينَ","لَمُخْتَبِرِينَ."]],"23:31":[[5,1,"قَرْنًا","جِيلًا."]],"23:33":[[2,3,"الْمَلَأُ مِن قَوْمِهِ","أَشْرَافُ قَوْمِ هُودٍ، وَوُجَهَاؤُهُمْ."]],"23:36":[[1,1,"هَيْهَاتَ","بَعِيدًا حَقًّا."]],"23:40":[[2,2,"عَمَّا قَلِيلٍ","بَعْدَ زَمَنٍ قَرِيبٍ."]],"23:41":[[5,1,"غُثَاءً","كَغُثَاءِ السَّيْلِ الَّذِي يَطْفُو عَلَى المَاءِ."],[6,1,"فَبُعْدًا","فَهَلَاكًا وَإِبْعَادًا مِنَ الرَّحْمَةِ."]],"23:42":[[5,1,"قُرُونًا","أُمَمًا وَأَجْيَالًا."]]}