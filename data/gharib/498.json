{"44:41":[[2,3,"لَا يُغْنِي مَوْلًى","لَا يَدْفَعُ صَاحِبٌ."]],"44:44":[[2,1,"الْأَثِيمِ","صَاحِبُ الآثَامِ الكَبِيرَةِ."]],"44:45":[[1,1,"كَالْمُهْلِ","كَالمَعْدَنِ المُذَابِ."]],"44:46":[[2,1,"الْحَمِيمِ","المَاءِ الَّذِي بَلَغَ الغَايَةَ فيِ الحَرَارَةِ."]],"44:47":[[2,1,"فَاعْتِلُوهُ","جُرُّوهُ وَسُوقُوهُ بِعُنْفٍ."],[4,2,"سَوَاءِ الْجَحِيمِ","وَسَطِ الجَحِيمِ."]],"44:49":[[3,3,"أَنتَ الْعَزِيزُ الْكَرِيمُ","عَلَى وَجْهِ التَّهَكُّمِ، وَالتَّوْبِيخِ لَهُمْ."]],"44:50":[[6,1,"تَمْتَرُونَ","تَشُكُّونَ."]],"44:51":[[4,2,"مَقَامٍ أَمِينٍ","مَوْضِعٍ يُؤْمَنُ فِيهِ الخَوْفُ، وَالآفَاتُ، وَالأَحْزَانُ."]],"44:53":[[3,1,"سُندُسٍ","هُوَ: الرَّقِيقُ مِنَ الدِّيبَاجِ."],[4,1,"وَإِسْتَبْرَقٍ","هُوَ: الغَلِيظُ مِنَ الدِّيبَاجِ."]],"44:54":[[3,2,"بِحُورٍ عِينٍ","نِسَاءِ الجَنَّةِ الحِسَانِ، الوَاسِعَاتِ الأَعْيُنِ."]],"44:55":[[1,2,"يَدْعُونَ فِيهَا","يَطْلُبُونَ فِيهَا."]],"44:56":[[6,2,"الْمَوْتَةَ الْأُولَى","الَّتِي ذَاقُوهَا فِي الدُّنْيَا."]],"44:59":[[1,1,"فَارْتَقِبْ","انْتَظِرْ نَصْرَكَ، وَهَلَاكَهُمْ."],[3,1,"مُّرْتَقِبُونَ","مُنْتَظِرُونَ مَوْتَكَ، وَهَزِيمَتَكَ."]]}