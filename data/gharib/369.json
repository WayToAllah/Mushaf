{"26:44":[[5,2,"بِعِزَّةِ فِرْعَوْنَ","أَقْسَمُوا بِعِزَّتِهِ، وَقُوَّتِهِ."]],"26:45":[[6,1,"تَلْقَفُ","تَبْتَلِعُ بِسُرْعَةٍ."],[7,2,"مَا يَافِكُونَ","مَا يَفْعَلُونَهُ مِنَ الكَذِبِ وَالتَّزْوِيرِ."]],"26:49":[[18,2,"مِّنْ خِلَافٍ","بِقَطْعِ اليَدِ اليُمْنَى وَالرِّجْلِ اليُسْرَى، أَوْ عَكْسَ ذَلِكَ."]],"26:50":[[2,2,"لَا ضَيْرَ","لَا ضَرَرَ."],[7,1,"مُنقَلِبُونَ","رَاجِعُونَ."]],"26:53":[[5,1,"حَاشِرِينَ","جَامِعِينَ لِلْجَيْشِ مِنَ المَدَائِنِ."]],"26:54":[[3,1,"لَشِرْذِمَةٌ","لَطَائِفَةٌ حَقِيرَةٌ."]],"26:58":[[1,1,"وَكُنُوزٍ","خَزَائِنِ الأَمْوَالِ."],[2,2,"وَمَقَامٍ كَرِيمٍ","مَنَازِلَ حِسَانٍ."]],"26:60":[[2,1,"مُّشْرِقِينَ","وَقْتَ شُرُوقِ الشَّمْسِ."]]}