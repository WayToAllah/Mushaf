{"51:53":[[1,2,"أَتَوَاصَوْا بِهِ","هَلْ وَصَّى بَعْضُهُمْ بَعْضًا بِالتَّكْذِيبِ؟"],[6,1,"طَاغُونَ","مُتَجَاوِزُونَ الحَدَّ فِي الكُفْرِ."]],"51:59":[[4,1,"ذَنُوبًا","نَصِيبًا مِنَ العَذَابِ سَيَنْزِلُ بِهِمْ."]],"52:1":[[1,1,"وَالطُّورِ","قَسَمٌ بِالجَبَلِ الَّذِي كَلَّمَ اللهُ عَلَيْهِ مُوسَى - عليه السلام -."]],"52:2":[[1,2,"وَكِتَابٍ مَّسْطُورٍ","قَسَمٌ بِالقُرْآنِ المَكْتُوبِ."]],"52:3":[[1,3,"فِي رَقٍّ مَّنشُورٍ","فَي صُحُفٍ مَنْشُورَةٍ، مَبْسُوطَةٍ."]],"52:4":[[1,2,"وَالْبَيْتِ الْمَعْمُورِ","قَسَمٌ بِالبَيْتِ المَعْمُورِ بِالمَلَائِكَةِ الَّذِينَ يَطُوفُونَ بِهِ دَائِمًا، وَهُوَ فيِ السَّمَاءِ بِحِذَاءِ الكَعْبَةِ، يَطُوفُ بِهِ كُلَّ يَوْمٍ سَبْعُونَ أَلْفَ مَلَكٍ."]],"52:5":[[1,2,"وَالسَّقْفِ الْمَرْفُوعِ","قَسَمٌ بِالسَّمَاءِ."]],"52:6":[[2,1,"الْمَسْجُورِ","المَمْلُوءِ بِالمَاءِ."]],"52:9":[[2,1,"تَمُورُ","تَتَحَرَّكُ، وَتَضْطَرِبُ."]],"52:13":[[2,1,"يُدَعُّونَ","يُدْفَعُونَ بِعُنْفٍ وَشِدَّةٍ."]]}