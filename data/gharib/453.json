{"38:1":[[3,2,"ذِي الذِّكْرِ","المُشْتَمِلِ عَلَى تَذْكِيرِ النَّاسِ بِمَا هُمْ عَنْهُ غَافِلُونَ."]],"38:2":[[5,1,"عِزَّةٍ","تَكَبُّرٍ، وَحَمِيَّةٍ."],[6,1,"وَشِقَاقٍ","مُخَالَفَةٍ، وَعِنَادٍ."]],"38:3":[[1,2,"كَمْ أَهْلَكْنَا","كَثِيرًا مِنَ الأُمَمِ أَهْلَكْنَا."],[6,1,"قَرْنٍ","أُمَّةٍ سَابِقَةٍ."],[8,3,"وَلَاتَ حِينَ مَنَاصٍ","لَيْسَ الوَقْتُ وَقْتَ فِرَارٍ وَخَلَاصٍ."]],"38:5":[[8,1,"عُجَابٌ","عَجِيبٌ."]],"38:6":[[2,1,"الْمَلَأُ","الأَشْرَافُ، وَكِبَارُ القَوْمِ."],[5,1,"امْشُوا","اسْتَمِرُّوا عَلَى دِينِكُمْ، وَشِرْكِكُمْ."],[11,2,"لَشَيْءٌ يُرَادُ","مُدَبَّرٌ يُقْصَدُ مِنْهُ التَّرَؤُسُ، وَالسِّيَادَةُ."]],"38:7":[[5,2,"الْمِلَّةِ الْآخِرَةِ","دِينِ آبَائِنَا وَدِينِ النَّصَارَى."],[10,1,"اخْتِلَاقٌ","كَذِبٌ، وَافْتِرَاءٌ."]],"38:10":[[8,3,"فَلْيَرْتَقُوا فِي الْأَسْبَابِ","فَلْيَاخُذُوا بِالأَسْبَابِ المُوصِلَةِ إِلَى السَّمَاءِ، وَلْيَمْنُعوا الوَحْيَ."]],"38:11":[[1,2,"جُندٌ مَّا","جُنُودٌ قَلِيلُونَ حَقِيرُونَ."]],"38:12":[[7,2,"ذُو الْأَوْتَادِ","صَاحِبُ الجُنُودِ، وَالقُوَّةِ العَظِيمَةِ."]],"38:13":[[4,2,"وَأَصْحَابُ الأَيْكَةِ","أَصْحَابُ الأَشْجَارِ وَالبَسَاتِينِ؛ وَهُمْ قَوْمُ شُعَيْبٍ - عليه السلام -."]],"38:14":[[6,2,"فَحَقَّ عِقَابِ","فَوَجَبَ العِقَابُ عَلَيْهِمْ."]],"38:15":[[1,2,"وَمَا يَنظُرُ","مَا يَنْتَظِرُ."],[5,2,"صَيْحَةً وَاحِدَةً","نَفْخَةَ القِيَامَةِ."],[10,1,"فَوَاقٍ","رُجُوعٍ."]],"38:16":[[5,1,"قِطَّنَا","نَصِيبَنَا مِنَ العَذَابِ."]]}