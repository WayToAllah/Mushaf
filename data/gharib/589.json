{"83:36":[[2,1,"ثُوِّبَ","جُوزِيَ."]],"84:1":[[3,1,"انشَقَّتْ","تَصَدَّعَتْ، وَتَفَطَّرَتْ بِالغَمَامِ يَوْمَ القِيَامَةِ."]],"84:2":[[1,2,"وَأَذِنَتْ لِرَبِّهَا","أَطَاعَتْ لِأَمْرِ رَبِّهَا."],[3,1,"وَحُقَّتْ","وَحُقَّ لَهَا أَنْ تُطِيعَ."]],"84:3":[[3,1,"مُدَّتْ","بُسِطَتْ، وَوُسِّعَتْ، وَدُكَّتْ جِبَالُهَا."]],"84:4":[[1,1,"وَأَلْقَتْ","قَذَفَتْ مَا فِي بَطْنِهَا مِنَ الأَمْوَاتِ."]],"84:6":[[4,3,"كَادِحٌ إِلَى رَبِّكَ","سَاعٍ إِلَى اللهِ، وَعَامِلٌ بِالخَيْرِ أَوِ الشَّرِّ."]],"84:7":[[4,1,"كِتَابَهُ","صَحِيفَةَ عَمَلِهِ."]],"84:11":[[2,2,"يَدْعُو ثُبُورًا","يَدْعُو بِالهَلَاكِ قَائِلًا: وَاثُبُورَاهْ!"]],"84:12":[[1,2,"وَيَصْلَى سَعِيرًا","يَدْخُلُ النَّارَ يُقَاسِي حَرَّهَا."]],"84:14":[[4,2,"لَّن يَحُورَ","لَنْ يَرْجِعَ إِلَى اللهِ لِيُحَاسِبَهُ."]],"84:16":[[1,2,"فَلَا أُقْسِمُ","أُقْسِمُ، وَ (لَا) : لِتَاكِيدِ القَسَمِ."],[3,1,"بِالشَّفَقِ","بِاحْمِرَارِ الأُفُقِ عِنْدَ الغُرُوبِ."]],"84:17":[[3,1,"وَسَقَ","جَمَعَ."]],"84:18":[[3,1,"اتَّسَقَ","تَكَامَلَ نُورُهُ، وَأَبْدَرَ."]],"84:19":[[2,3,"طَبَقًا عَن طَبَقٍ","أَطْوَارًا مُتَعَدِّدَةً، وَأَحْوَالًا مُتَبَايِنَةً: نُطْفَةً، ثُمَ عَلَقَةً، وَهَكَذَا."]],"84:23":[[4,1,"يُوعُونَ","يَكْتُمُونَ فيِ صُدُورِهِمْ مِنَ العِنَادِ، وَالتَّكْذِيبِ."]]}