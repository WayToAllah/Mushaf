{"29:17":[[7,2,"وَتَخْلُقُونَ إِفْكًا","تَفْتَرُونَ كَذِبًا."],[19,1,"فَابْتَغُوا","الْتَمِسُوا وَاطْلُبُوا."]],"29:20":[[7,2,"بَدَأَ الْخَلْقَ","أَنْشَأَهُ."]],"29:21":[[8,1,"تُقْلَبُونَ","تُرَدُّونَ، وَتُرْجَعُونَ."]],"29:22":[[3,1,"بِمُعْجِزِينَ","فَائِتِينَ مِنْ عَذَابِهِ بِالهَرَبِ وَغَيْرِهِ."]]}