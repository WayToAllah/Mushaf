{"67:15":[[6,1,"ذَلُولًا","سَهْلَةً، مُمَهَّدَةً تَسْتَقِرُّونَ عَلَيْهَا."],[9,1,"مَنَاكِبِهَا","نَوَاحِيهَا، وَجَوَانِبِهَا."],[13,2,"وَإِلَيْهِ النُّشُورُ","إِلَيْهِ تُبْعَثُونَ مِنْ قُبُورِكُمْ لِلْجَزَاءِ وَالحِسَابِ."]],"67:16":[[2,3,"مَّن فِي السَّمَاء","اللهَ الَّذِي فِي العُلُوِّ."],[11,1,"تَمُورُ","تَضْطَرِبُ بِكُمْ حَتَّى تَهْلِكُوا."]],"67:17":[[9,1,"حَاصِبًا","رِيحًا تَرْجُمُكُمْ بِالحِجَارَةِ الصَّغِيرَةِ."],[12,1,"نَذِيرِ","تَحْذِيرِي لَكُمْ."]],"67:18":[[8,1,"نَكِيرِ","إِنْكَارِي عَلَيْهِمْ، وَتَغْيِيرُ مَا بِهِمْ مِنَ النِّعْمَةِ."]],"67:19":[[6,1,"صَافَّاتٍ","بَاسِطَاتٍ أَجْنِحَتَهَا عِنْدَ طَيَرَانِهَا فِي الهَوَاءِ."],[7,1,"وَيَقْبِضْنَ","يَضْمُمْنَهَا إِلَى جُنُوبِهَا أَحْيانًا."]],"67:20":[[15,1,"غُرُورٍ","خِدَاعٍ وَضَلَالٍ مِنَ الشَّيْطَانِ."]],"67:21":[[9,1,"لَّجُّوا","اسْتَمَرُّوا، وَتَمَادَوْا."],[11,1,"عُتُوٍّ","مُعَانَدَةٍ، وَاسْتِكْبَارٍ."],[12,1,"وَنُفُورٍ","شُرُودٍ وَتَبَاعُدٍ عَنِ الحَقِّ."]],"67:22":[[3,1,"مُكِبًّا","مُنَكَّسًا."],[9,1,"سَوِيًّا","مُسْتَوِيًا، مُنْتَصِبَ القَامَةِ سَالِمًا."],[11,2,"صِرَاطٍ مُّسْتَقِيمٍ","طَرِيقٍ وَاضِحٍ لَا اعْوِجَاجَ فِيهِ."]],"67:23":[[4,1,"أَنشَأَكُمْ","أَوْجَدَكُمْ."]],"67:24":[[4,1,"ذَرَأَكُمْ","خَلَقَكُمْ، وَنَشَرَكُمْ فِي الأَرْضِ."]]}