{"75:22":[[3,1,"نَّاضِرَةٌ","مُشْرِقَةٌ، حَسَنَةٌ."]],"75:23":[[3,1,"نَاظِرَةٌ","تَرَى رَبَّهَا فِي الجَنَّةِ."]],"75:24":[[3,1,"بَاسِرَةٌ","عَابِسَةٌ، كَالِحَةٌ."]],"75:25":[[5,1,"فَاقِرَةٌ","مُصِيبَةٌ عَظِيمَةٌ تَقْصِمُ فَقَارَ الظَّهْرِ."]],"75:26":[[1,1,"كَلَّا","حَقًّا."],[3,2,"بَلَغَتْ التَّرَاقِيَ","وَصَلَتِ الرُّوحُ إِلَى أَعَالِي الصَّدْرِ."]],"75:27":[[2,2,"مَنْ رَاقٍ","هَلْ مِنْ رَاقٍ يَرْقِيهِ، وَيَشْفِيهِ؟"]],"75:28":[[1,1,"وَظَنَّ","أَيْقَنَ المُحْتَضِرُ."]],"75:29":[[1,3,"وَالْتَفَّتِ السَّاقُ بِالسَّاقِ","اتَّصَلَتْ شِدَّةُ آخِرِ الدُّنْيَا بِشِدَّةِ أَوَّلِ الآخِرَةِ، وَالْتَفَّتْ إِحْدَى سَاقَيْهِ بِالأُخْرَى عِنْدَ المَوْتِ."]],"75:30":[[4,1,"الْمَسَاقُ","سَوْقُ العِبَادِ لِلْجَزَاءِ."]],"75:32":[[3,1,"وَتَوَلَّى","أَعْرَضَ عَنِ الإِيمَانِ."]],"75:33":[[5,1,"يَتَمَطَّى","يَتَبَخْتَرُ فِي مِشْيَتِهِ مُخْتَالًا."]],"75:34":[[1,3,"أَوْلَى لَكَ فَأَوْلَى","كَلِمَةُ وَعِيدٍ، أَيْ: هَلَاكٌ لِكَ فَهَلَاكٌ."]],"75:36":[[5,1,"سُدًى","هَمَلًا لَا يُؤْمَرُ، وَلَا يُحَاسَبُ."]],"75:37":[[6,1,"يُمْنَى","يُصَبُّ فِي الرَّحِمِ."]],"75:38":[[3,1,"عَلَقَةً","قِطْعَةً مِنْ دَمٍ جَامِدٍ."],[5,1,"فَسَوَّى","عَدَّلَ خَلْقَهُ، وَأَعْضَاءَهُ."]],"76:1":[[1,2,"هَلْ أَتَى","قَدْ مَضَى."],[5,1,"حِينٌ","زَمَنٌ طَوِيلٌ."]],"76:2":[[6,1,"أَمْشَاجٍ","مُخْتَلِطَةٍ مِنْ مَاءِ الرَّجُلِ وَمَاءِ المَرْأَةِ."],[7,1,"نَّبْتَلِيهِ","نَخْتَبِرُهُ بِالأَوَامِرِ، وَالنَّوَاهِي."]],"76:3":[[2,2,"هَدَيْنَاهُ السَّبِيلَ","بَيَّنَّا لَهُ طَرِيقَ الخَيْرِ، وَالشَّرِّ."]],"76:4":[[4,1,"سَلَاسِلَا","قُيُودًا مِنْ حَدِيدٍ تُشَدُّ بِهَا أَرْجُلُهُمْ."],[5,1,"وَأَغْلَالًا","تُغَلُّ وَتُجْمَعُ بِهَا أَيْدِيهِمْ إِلَى أَعْنَاقِهِمْ."],[6,1,"وَسَعِيرًا","نَارًا يُحْرَقُونَ بِهَا."]],"76:5":[[5,1,"كَاسٍ","إِنَاءِ شُرْبِ الخَمْرِ، وَفِيهَا خَمْرٌ."],[7,2,"مِزَاجُهَا كَافُورًا","مَخْلُوطَةً بِأَحْسَنِ أَنْوَاعِ الطِّيبِ، وَهُوَ مَاءُ الكَافُورِ."]]}