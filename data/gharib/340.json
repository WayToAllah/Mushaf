{"22:65":[[10,1,"وَالْفُلْكَ","السُّفُنَ."]],"22:67":[[4,1,"مَنسَكًا","شَرِيعَةً، وَعِبَادَةً."]],"22:70":[[12,2,"فِي كِتَابٍ","هُوَ اللَّوْحُ المَحْفُوظُ."]],"22:71":[[9,1,"سُلْطَانًا","حُجَّةً، وَبُرْهَانًا."]],"22:72":[[11,1,"الْمُنكَرَ","الكَرَاهَةَ ظَاهِرَةً عَلَى وُجُوهِهِمْ."],[13,1,"يَسْطُونَ","يَبْطِشُونَ."],[29,1,"الْمَصِيرُ","المَكَانُ الَّذِي يَصِيرُونَ إِلَيْهِ."]]}