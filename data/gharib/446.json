{"37:1":[[1,1,"وَالصَّافَّاتِ","قَسَمٌ بِالمَلَائِكَةِ حِينَ تَصُفُّ فيِ عِبَادَتِهَا."]],"37:2":[[1,1,"فَالزَّاجِرَاتِ","قَسَمٌ بِالمَلَائِكَةِ حِينَ تَزْجُرُ السَّحَابَ، وَتَسُوقُهُ."]],"37:3":[[1,1,"فَالتَّالِيَاتِ","قَسَمٌ بِالمَلَائِكَةِ حِينَ تَتْلُو ذِكْرَ اللهِ، وَكَلَامَهُ."]],"37:7":[[5,1,"مَّارِدٍ","جِنِّيًّ مُتَمَرِّدٍ، خَارجٍ عَنِ الطَّاعَةِ."]],"37:8":[[6,1,"وَيُقْذَفُونَ","يُرْجَمُونَ."]],"37:9":[[1,1,"دُحُورًا","طَرْدًا لِلشَّيَاطِينِ عَنِ الاِسْتِمَاعِ."],[4,1,"وَاصِبٌ","دَائِمٌ مُوجِعٌ."]],"37:10":[[3,2,"خَطِفَ الْخَطْفَةَ","اخْتَلَسَ الكَلِمَةَ؛ مُسَارَقَةً بِسُرْعَةٍ."],[6,1,"شِهَابٌ","مَا يُرَى كَالكَوْكَبِ يَنْقَضُّ مِنَ السَّمَاءِ بِسُرْعَةٍ."],[7,1,"ثَاقِبٌ","مُضِيءٌ."]],"37:11":[[9,1,"خَلَقْنَاهُم","خَلَقْنَا أَبَاهُمْ آدَمَ - عليه السلام -."],[12,1,"لَّازِبٍ","لَزِجٍ يَلْتَصِقُ بَعْضُهُ بِبَعْضٍ."]],"37:18":[[4,1,"دَاخِرُونَ","صَاغِرُونَ، أَذِلَّاءُ."]],"37:19":[[3,1,"زَجْرَةٌ","نَفْخَةٌ."]],"37:22":[[1,1,"احْشُرُوا","اجْمَعُوا."],[4,1,"وَأَزْوَاجَهُمْ","نُظَرَاءَهُمْ، وَقُرَنَاءَهُمْ فيِ الدُّنْيَا."]],"37:23":[[4,1,"فَاهْدُوهُمْ","سُوقُوهُمْ سَوْقًا عَنِيفًا."]],"37:24":[[1,1,"وَقِفُوهُمْ","احْبِسُوهُمْ قَبْلَ أَنْ يَصِلُوا إِلَى جَهَنَّمَ."]]}