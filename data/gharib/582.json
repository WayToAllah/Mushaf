{"78:1":[[1,1,"عَمَّ","عَنْ أَيِّ شَيْءٍ"]],"78:2":[[2,2,"النَّبَإِ الْعَظِيمِ","الخَبَرِ العَظِيمِ؛ وَهُوَ القُرْآنُ الَّذِي فِيهِ خَبَرُ البَعْثِ."]],"78:6":[[4,1,"مِهَادًا","مُمَهَّدَةً كَالفِرَاشِ."]],"78:7":[[2,1,"أَوْتَادًا","تُثَبِّتُ الأَرْضَ."]],"78:8":[[2,1,"أَزْوَاجًا","أَصْنَافًا: ذُكُورًا وَإِنَاثًا."]],"78:9":[[3,1,"سُبَاتًا","رَاحَةً لِأَبْدَانِكُمْ، وَقَطْعًا لأَعْمَالِكُمْ."]],"78:10":[[3,1,"لِبَاسًا","سَاتِرًا لَكُمْ بِظُلْمَتِهِ؛ كَاللِّبَاسِ."]],"78:11":[[3,1,"مَعَاشًا","تُحَصِّلُونَ فِيهِ مَا تَعِيشُونَ بِهِ."]],"78:13":[[2,2,"سِرَاجًا وَهَّاجًا","مِصْبَاحًا وَقَّادًا، مُضِيئًا."]],"78:14":[[3,1,"الْمُعْصِرَاتِ","السُّحُبِ المُمْطِرَةِ."],[5,1,"ثَجَّاجًا","مُنْصَبًّا بِكَثْرَةٍ."]],"78:16":[[1,2,"وَجَنَّاتٍ أَلْفَافًا","بَسَاتِينَ مُلْتَفَّةً أَشْجَارُهَا."]],"78:17":[[5,1,"مِيقَاتًا","وَقْتًا، وَمِيعَادًا لِلفَصْلِ بَيْنَ الخَلْقِ."]],"78:18":[[4,1,"الصُّورِ","القَرْنِ الَّذِي يَنْفُخُ فِيهِ إِسْرَافِيلُ - عليه السلام -."]],"78:19":[[4,1,"أَبْوَابًا","ذَاتَ أَبْوَابٍ كَثِيرَةٍ؛ لِنُزُولِ المَلَائِكَةِ."]],"78:20":[[1,1,"وَسُيِّرَتِ","نُسِفَتْ بَعْدَ ثُبُوتِهَا."],[4,1,"سَرَابًا","كَالسَّرَابِ الَّذِي لَا حَقِيقَةَ لَهُ."]],"78:21":[[4,1,"مِرْصَادًا","تَرْصُدُ أَهْلَهَا، وَتَرْقُبُهُمْ."]],"78:23":[[3,1,"أَحْقَابًا","دُهُورًا لَا تَنْقَطِعُ."]],"78:24":[[4,1,"بَرْدًا","مَا يُبَرِّدُ حَرَّ النَّارِ عَلَى أَجْسَادِهِمْ."]],"78:25":[[2,1,"حَمِيمًا","مَاءً حَارًّا بَالِغًا نِهَايَةَ الحَرَارَةِ."],[3,1,"وَغَسَّاقًا","صَدِيدَ أَهْلِ النَّارِ."]],"78:26":[[2,1,"وِفَاقًا","عَادِلًا، مُوَافِقًا لِأَعْمَالِهِمْ."]],"78:27":[[3,2,"لَا يَرْجُونَ","لَا يَخَافُونَ."]],"78:29":[[3,1,"أَحْصَيْنَاهُ","حَفِظْنَاهُ، وَضَبَطْنَاهُ مَكْتُوبًا فِي اللَّوْحِ المَحْفُوظِ."]]}