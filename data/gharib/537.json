{"56:77":[[3,1,"كَرِيمٌ","عَظِيمُ المَنَافِعِ، كَثِيرُ الخَيْرِ، غَزِيرُ العِلْمِ."]],"56:78":[[3,1,"مَّكْنُونٍ","مَسْتُورٍ مَصُونٍ."]],"56:81":[[2,1,"الْحَدِيثِ","القُرْآنِ."],[4,1,"مُّدْهِنُونَ","مُكَذِّبُونَ."]],"56:82":[[1,2,"وَتَجْعَلُونَ رِزْقَكُمْ","تَجْعَلُونَ شُكْرَ نِعَمِ اللهِ عَلَيْكُمْ."]],"56:83":[[3,2,"بَلَغَتِ الْحُلْقُومَ","وَصَلَتِ الرُّوحُ الحُلْقُومَ عِنْدَ المَوْتِ."]],"56:86":[[4,2,"غَيْرَ مَدِينِينَ","غَيْرَ مَجْزِيِّينَ، وَمُحَاسَبِينَ."]],"56:87":[[1,1,"تَرْجِعُونَهَا","تَرُدُّونَ الرُّوحَ إِلَى الجَسَدِ."]],"56:89":[[1,1,"فَرَوْحٌ","رَحْمَةٌ وَاسِعَةٌ، وَاسْتِرَاحَةٌ، وَفَرَحٌ."],[2,1,"وَرَيْحَانٌ","رِزْقٌ حَسَنٌ، وَرَائِحَةٌ طَيِّبَةٌ، وَجَمِيعُ مَا تَطِيبُ بِهِ نَفْسُهُ."]],"56:91":[[1,2,"فَسَلَامٌ لَّكَ","يُقَالُ لَهُ: سَلَامَةٌ لَكَ، وَأَمْنٌ."],[3,3,"مِنْ أَصْحَابِ الْيَمِينِ","لِكَوْنِكَ مِنْ أَصْحَابِ اليَمِينِ."]],"56:93":[[1,1,"فَنُزُلٌ","ضِيَافَةٌ."],[3,1,"حَمِيمٍ","شَرَابِ جَهَنَّمَ المُتَنَاهِي فِي الحَرَارَةِ."]],"56:94":[[1,2,"وَتَصْلِيَةُ جَحِيمٍ","يَدْخُلُ فِيهَا، وَيُقَاسِي حَرَّهَا."]],"56:95":[[4,2,"حَقُّ الْيَقِينِ","لَا مِرْيَةَ فِيهِ."]],"57:1":[[1,2,"سَبَّحَ لِلَّهِ","نَزَّهَ اللهَ عَمَّا لَا يَلِيقُ بِهِ جَلَّ جَلَالُهُ."]],"57:3":[[2,1,"الْأَوَّلُ","الَّذِي لَيْسَ قَبْلَهُ شَيْءٌ."],[3,1,"وَالْآخِرُ","الَّذِي لَيْسَ بَعْدَهُ شَيْءٌ."],[4,1,"وَالظَّاهِرُ","الَّذِي لَيْسَ فَوْقَهُ شَيْءٌ."],[5,1,"وَالْبَاطِنُ","الَّذِي لَيْسَ دُونَهُ شَيْءٌ."]]}