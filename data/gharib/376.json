{"26:212":[[3,1,"السَّمْعِ","اسْتِمَاعِ القُرْآنِ مِنَ السَّمَاءِ."],[4,1,"لَمَعْزُولُونَ","لَمَحْجُوبُونَ مَرْجُومُونَ بِالشُّهُبِ."]],"26:215":[[1,2,"وَاخْفِضْ جَنَاحَكَ","أَلِنْ جَانِبَكَ وَكَلامَكَ تَوَاضُعًا."]],"26:218":[[3,2,"حِينَ تَقُومُ","تُصَلِّي اللَّيْلَ وَحْدَكَ."]],"26:222":[[4,1,"أَفَّاكٍ","كَذَّابٍ."],[5,1,"أَثِيمٍ","كَثِيرِ الآثَامِ."]],"26:223":[[1,2,"يُلْقُونَ السَّمْعَ","تُلْقِي الشَّيَاطِينُ إِلَى الكُهَّانِ مَا يَسْتَرِقُونَ مِنَ المَلَأِ الأَعْلَى."]],"26:225":[[6,1,"وَادٍ","فَنٍّ مِنْ فُنُونِ البَاطِلِ، وَالكَذِبِ."],[7,1,"يَهِيمُونَ","يَخُوضُونَ."]],"26:227":[[18,1,"مُنقَلَبٍ","مَرْجِعٍ."]]}