{"10:71":[[11,1,"كَبُرَ","عَظُمَ."],[20,1,"فَأَجْمِعُوا","اعْزِمُوا، وَأَعِدُّوا."],[28,1,"غُمَّةً","مُسْتَتِيرًا."],[30,2,"اقْضُوا إِلَيَّ","اقْضُوا عَلَيَّ بِالعُقُوبَةِ."],[33,1,"تُنظِرُونِ","تُمْهِلُونِ."]],"10:73":[[6,1,"الْفُلْكِ","السَّفِينَةِ."],[8,1,"خَلَائِفَ","يَخْلُفُونَ الُمَكَذِّبِينَ فِي الأَرْضِ."]],"10:74":[[19,1,"نَطْبَعُ","نَخْتِمُ."]],"10:75":[[9,1,"وَمَلَئِهِ","أَشْرَافِ قَوْمِهِ."]],"10:78":[[3,1,"لِتَلْفِتَنَا","لِتَصْرِفَنَا."],[10,1,"الْكِبْرِيَاءُ","العَظَمَةُ، وَالسُّلْطَانُ."]]}