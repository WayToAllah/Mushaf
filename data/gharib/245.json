{"12:79":[[2,2,"مَعَاذَ اللهِ","نَعْتَصِمُ بِاللهِ، وَنَسْتَجِيرُ بِهِ."]],"12:80":[[2,1,"اسْتَيْأَسُوا","يَئِسُوا وَانْقَطَعَ رَجَاؤُهُم."],[4,2,"خَلَصُوا نَجِيًّا","انْفَرَدُوا يَتَشَاوَرُونَ."],[15,1,"مَّوْثِقًا","عَهْدًا مُؤَكَّدًا."],[21,1,"فَرَّطتُمْ","قَصَّرْتُمْ."],[25,1,"أَبْرَحَ","أُفَارِقَ."]],"12:82":[[6,1,"وَالْعِيْرَ","القَافِلَةَ."]],"12:83":[[3,1,"سَوَّلَتْ","زَيَّنَتْ."]],"12:84":[[12,1,"كَظِيمٌ","شَدِيدُ الكِتْمَانِ لِحُزْنِهِ."]],"12:85":[[3,1,"تَفْتَأُ","مَا تَزَالُ."],[8,1,"حَرَضًا","تُشْرِفُ عَلَى الهَلَاكِ."]],"12:86":[[4,1,"بَثِّي","هَمِّي."]]}