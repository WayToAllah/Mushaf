{"34:33":[[6,4,"بَلْ مَكْرُ اللَّيْلِ وَالنَّهَارِ","بَلْ تَدْبِيرُ الشَّرِّ لَنَا بِاللَّيْلِ وَالنَّهَارِ هُوَ الَّذِي أَهْلَكَنَا."],[19,1,"النَّدَامَةَ","التَّحَسُّرَ."]],"34:36":[[4,1,"يَبْسُطُ","يُوسِعُ."],[8,1,"وَيَقْدِرُ","يُضَيِّقُ."]],"34:37":[[8,1,"زُلْفَى","قُرْبَى."],[16,2,"جَزَاءُ الضِّعْفِ","الثَّوَابُ المُضَاعَفُ."],[22,1,"الْغُرُفَاتِ","المَنَازِلِ الرَّفِيعَةِ فِي الجَنَّةِ."]],"34:38":[[2,3,"يَسْعَوْنَ فِي آيَاتِنَا","يَجْهَدُونَ فِي إِبْطَالِ حُجَجِنَا."],[5,1,"مُعَاجِزِينَ","مُشَاقِّينَ يَظُنُّونَ أَنَّهُمْ يَفُوتُونَنَا."],[9,1,"مُحْضَرُونَ","تُحْضِرُهُمُ الزَّبَانِيَةُ إِلَى جَهَنَّمَ."]],"34:39":[[10,2,"وَيَقْدِرُ لَهُ","يُضَيِّقُهُ عَلَيْهِ."]]}