{"83:7":[[3,2,"كِتَابَ الفُجَّارِ","كِتَابَ أَعْمَالِهِمْ، أَوْ مَصِيرَهُمِ."],[6,1,"سِجِّينٍ","سِجْنٍ، وَضِيقٍ."]],"83:9":[[2,1,"مَّرْقُومٌ","مَكْتُوبٌ كَالرَّقْمِ فِي الثَّوْبِ لَا يُمْحَى."]],"83:12":[[6,1,"مُعْتَدٍ","ظَالِمِ مُتَجَاوِزٍ لِلْحَدِّ."],[7,1,"أَثِيمٍ","كَثِيرِ الإِثْمِ."]],"83:13":[[6,1,"أَسَاطِيرُ","أَبَاطِيلُ"]],"83:14":[[3,1,"رَانَ","غَطَّى."]],"83:15":[[6,1,"لَّمَحْجُوبُونَ","مَحْرُومُونَ مِنْ رُؤْيَةِ رَبِّهِمْ."]],"83:16":[[3,2,"لَصَالُوا الْجَحِيمِ","لَدَاخِلُو النَّارِ يُقَاسُونَ حَرَّهَا."]],"83:18":[[5,2,"لَفِي عِلِّيِّينَ","لَفِي مَرْتَبَةٍ، وَمَكَانٍ عَالٍ."]],"83:23":[[2,1,"الْأَرَائِكِ","الأَسِرَّةِ المُزَيَّنَةِ بِالسُّتُورِ، وَالثِّيَابِ."]],"83:24":[[4,1,"نَضْرَةَ","بَهْجَةَ."]],"83:25":[[3,1,"رَّحِيقٍ","خَمْرٍ صَافِيَةٍ."]],"83:26":[[1,2,"خِتَامُهُ مِسْكٌ","آخِرُهُ رَائِحَةُ المِسْكِ."]],"83:27":[[1,1,"وَمِزَاجُهُ","خَلْطُهُ."],[3,1,"تَسْنِيمٍ","عَيْنٍ فيِ أَعْلَى الجَنَّةِ."]],"83:28":[[2,2,"يَشْرَبُ بِهَا","يَشْرَبُونَ مُتَلَذِّذِينَ بِهَا."]],"83:30":[[4,1,"يَتَغَامَزُونَ","يَغْمِزُ بَعْضُهُمْ بَعْضًا بِأَعْيُنِهِمُ اسْتِهْزَاءً."]],"83:31":[[2,1,"انقَلَبُوا","رَجَعُوا."],[6,1,"فَكِهِينَ","مُتَلَذِّذِينَ بِسُخْرِيَتِهِمْ مِنَ المَؤْمِنِينَ."]],"83:33":[[4,1,"حَافِظِينَ","رُقَبَاءَ يُحْصُونَ أَعْمَالَهُمْ."]]}