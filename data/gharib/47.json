{"2:275":[[10,1,"يَتَخَبَّطُهُ","يَصْرَعُهُ."],[13,1,"الْمَسِّ","الْجُنُونِ."]],"2:276":[[1,1,"يَمْحَقُ","يَنْقُصُ، وَيُذْهِبُ البَرَكَةَ."],[4,1,"وَيُرْبِي","يَزِيدُ، وَيُنَمِّي."]],"2:279":[[4,1,"فَاذَنُوا","اسْتَيْقِنُوا."]],"2:280":[[3,2,"ذُو عُسْرَةٍ","غَيْرُ قَادِرٍ عَلَى السَّدَادِ."],[5,1,"فَنَظِرَةٌ","إِمْهَالٌ."]]}