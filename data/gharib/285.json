{"17:29":[[12,1,"مَلُومًا","يَلُومُكَ النَّاسُ، وَيَذُمُّونَكَ."],[13,1,"مَّحْسُورًا","فَارغَ اليَدِ نَادِمًا، عَلَى تَبْذِيرِكَ."]],"17:30":[[7,1,"وَيَقْدِرُ","يُضَيِّقُ."]],"17:31":[[5,1,"إِمْلاقٍ","فَقْرٍ."],[12,1,"خِطْئًا","ذَنْبًا."]],"17:32":[[8,1,"سَبِيلًا","طَرِيقًا."]],"17:33":[[14,1,"لِوَلِيِّهِ","مَنْ تَوَلَّى أَمْرَ القَتِيلِ مِنْ وَارِثٍ، أَوْ حَاكِمٍ."],[15,1,"سُلْطَانًا","حُجَّةً."]],"17:34":[[4,1,"الْيَتِيمِ","مَنْ مَاتَ أَبُوهُ قَبْلَ البُلُوغِ."]],"17:35":[[6,2,"بِالقِسْطَاسِ الْمُسْتَقِيمِ","بِالمِيزَانِ السَّوِيِّ."],[11,1,"تَاوِيلًا","عَاقِبَةً عِنْدَ اللهِ فِي الآخِرَةِ."]],"17:36":[[1,2,"وَلَا تَقْفُ","لَا تَتْبَعْ."]],"17:37":[[5,1,"مَرَحًا","مُخْتالًا، مُتَكَبِّرًا."]]}