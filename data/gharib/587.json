{"82:1":[[3,1,"انفَطَرَتْ","انْشَقَّتْ."]],"82:2":[[3,1,"انتَثَرَتْ","تَسَاقَطَتْ."]],"82:3":[[3,1,"فُجِّرَتْ","امْتَلَأَتْ، وَفَاضَتْ، فَانْفَجَرَتْ، وَسَالَتْ مِيَاهُهَا."]],"82:4":[[3,1,"بُعْثِرَتْ","قُلِبَتْ بِبَعْثِ مَنْ كَانَ مَقْبُورًا فِيهَا."]],"82:6":[[3,3,"مَا غَرَّكَ بِرَبِّكَ","مَا خَدَعَكَ، وَجَرَّأَكَ عَلَى الكُفْرِ بِهِ، وَعِصْيَانِهِ؟"]],"82:7":[[3,1,"فَسَوَّاكَ","جَعَلَكَ مُسْتَوِيَ الخِلْقَة سَالِمَ الأَعْضَاءِ."],[4,1,"فَعَدَلَكَ","جَعَلَكَ مُعْتَدِلَ الخَلْقِ مُتَنَاسِبَ الأَعْضَاءِ."]],"82:9":[[4,1,"بِالدِّينِ","يَوْمِ الجَزَاءِ، وَالحِسَابِ."]],"82:10":[[3,1,"لَحَافِظِينَ","لَمَلَائِكَةً رُقَبَاءَ يَكْتُبُونَ أَعْمَالَكُم."]],"82:16":[[4,1,"بِغَائِبِينَ","فَلَا يَخْرُجُونَ مِنْ جَهَنَّمَ، وَلَا يَمُوتُونَ."]],"83:1":[[1,1,"وَيْلٌ","عَذَابٌ شَدِيدٌ."],[2,1,"لِّلْمُطَفِّفِينَ","الَّذِينَ يَبْخَسُونَ المِكْيَالَ، وَالمِيزَانَ."]],"83:3":[[5,1,"يُخْسِرُونَ","يَنْقُصُونَ فيِ المِكْيَالِ، وَالمِيزَانَ."]],"83:4":[[2,1,"يَظُنُّ","يَعتَقِدُ."]]}