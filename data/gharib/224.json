{"11:20":[[4,1,"مُعْجِزِينَ","فَائِتِينَ مِنْ عَذَابِ اللهِ بِالهَرَبِ."]],"11:21":[[5,1,"وَضَلَّ","ذَهَبَ."]],"11:22":[[1,2,"لَا جَرَمَ","حَقًّا."]],"11:23":[[6,1,"وَأَخْبَتُوا","خَضَعُوا لِلهِ."]],"11:24":[[4,1,"وَالأَصَمِّ","الَّذِي لَا يَسْمَعُ."]],"11:27":[[2,1,"الْمَلأُ","رُؤَسَاءُ الكُفْرِ."],[18,1,"أَرَاذِلُنَا","أَسَافِلُنَا."],[19,2,"بَادِيَ الرَّايِ","مِنْ غَيْرِ تَفَكُّرٍ، وَلَا رَوِيَّةٍ."]],"11:28":[[14,2,"فَعُمِّيَتْ عَلَيْكُمْ","فَأُخْفِيَتْ عَلَيْكُمْ."],[16,1,"أَنُلْزِمُكُمُوهَا","أَنُجْبِرُكم عَلَى قَبُولِهَا."]]}