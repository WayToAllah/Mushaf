{"55:70":[[2,1,"خَيْرَاتٌ","زَوْجَاتٌ طَيِّبَاتُ الأَخْلَاقِ."]],"55:72":[[1,1,"حُورٌ","نِسَاءٌ بِيضٌ حِسَانٌ."],[2,1,"مَّقْصُورَاتٌ","مَسْتُورَاتٌ مَصُونَاتٌ."]],"55:74":[[2,1,"يَطْمِثْهُنَّ","يَطَاهُنَّ."]],"55:76":[[3,2,"رَفْرَفٍ خُضْرٍ","وَسَائِدَ ذَوَاتِ أَغْطِيَةٍ خُضْرٍ."],[5,1,"وَعَبْقَرِيٍّ","فُرُشٍ، وَبُسُطٍ."]],"55:78":[[1,1,"تَبَارَكَ","كَثُرَتْ بَرَكَتُهُ، وَخَيْرُهُ."]],"56:1":[[3,1,"الْوَاقِعَةُ","القِيَامَةُ."]],"56:2":[[1,2,"لَيْسَ لِوَقْعَتِهَا","لَيْسَ لِوُقُوعِهَا، وَقِيَامِهَا."],[3,1,"كَاذِبَةٌ","نَفْسٌ تُكَذِّبُ بِذَلِكَ."]],"56:3":[[1,2,"خَافِضَةٌ رَّافِعَةٌ","تَخْفِضُ الكُفَّارَ فِي النَّارِ، وَتَرْفَعُ المُؤْمِنِينَ فِي الجَنَّةِ."]],"56:4":[[2,1,"رُجَّتِ","حُرِّكَتْ."],[4,1,"رَجًّا","تَحْرِيكًا شَدِيدًا."]],"56:5":[[1,1,"وَبُسَّتِ","فُتِّتَتْ."]],"56:6":[[2,2,"هَبَاءً مُّنبَثًّا","غُبَارًا مُتَطَايِرًا فِي الجَوِّ."]],"56:7":[[2,1,"أَزْوَاجًا","أَصْنَافًا."]],"56:9":[[2,1,"الْمَشْأَمَةِ","الشِّمَالِ."]],"56:10":[[1,1,"وَالسَّابِقُونَ","الَّذِينَ يَسْبِقُونَ إِلَى الخَيْرَاتِ، وَيُسَارِعُونَ لِلطَّاعَاتِ."],[2,1,"السَّابِقُونَ","الَّذِينَ يَسْبِقُونَ إِلَى المَنَازِلِ العَالِيَةِ فِي الجَنَّةِ."]],"56:13":[[1,1,"ثُلَّةٌ","جَمَاعَةٌ كَثِيرَةٌ."],[3,1,"الْأَوَّلِينَ","صَدْرِ هَذِهِ الأُمَّةِ وَغَيْرِهِمْ مِنَ الأُمَمِ الأُخْرَى."]],"56:14":[[3,1,"الْآخِرِينَ","آخِرِ هَذِهِ الأُمَّةِ."]],"56:15":[[3,1,"مَّوْضُونَةٍ","مَنْسُوجَةٍ بِالذَّهَبِ."]]}