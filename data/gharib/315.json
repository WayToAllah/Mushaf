{"20:53":[[5,1,"مَهْدًا","مُيَسَّرَةً لِلِانْتِفَاعِ بِهَا."],[9,1,"سُبُلًا","طُرُقًا."],[16,1,"أَزْوَاجًا","أَنْوَاعًا مُخْتَلِفَةً."]],"20:54":[[8,2,"لِّأُوْلِي النُّهَى","لِذَوِي العُقُولِ السَّلِيمَةِ."]],"20:58":[[14,1,"سُوًى","مُسْتَوِيًا مُعْتَدِلًا."]],"20:59":[[3,2,"يَوْمُ الزِّينَةِ","يَوْمُ العِيدِ."],[6,1,"يُحْشَرَ","يُجْمَعَ."]],"20:60":[[4,1,"كَيْدَهُ","المُرَادُ: سَحَرَتُهُ الَّذِينَ يَكِيدُ بِهِمْ."]],"20:61":[[5,2,"لَا تَفْتَرُوا","لَا تَخْتَلِقُوا."],[10,1,"فَيُسْحِتَكُمْ","فَيَسْتَاصِلَكُمْ."]],"20:63":[[12,2,"بِطَرِيقَتِكُمُ الْمُثْلَى","طَرِيقَةِ السِّحْرِ العَظِيمَةِ."]],"20:64":[[1,2,"فَأَجْمِعُوا كَيْدَكُمْ","فأَحْكِمُوا كَيْدَكُمْ، وَاعْزِمُوا عَلَيْهِ، وَلَا تَخْتَلِفُوا."]]}