{"2:164":[[9,1,"وَالْفُلْكِ","السُّفُنِ."],[29,1,"وَبَثَّ","نَشَرَ."],[34,2,"وَتَصْرِيفِ الرِّيَاحِ","تَقَلِيبِهَا، وَتَوْجِيهِهَا."]],"2:166":[[12,1,"الأَسْبَابُ","الصِّلَاتُ."]],"2:167":[[17,1,"حَسَرَاتٍ","نَدَامَاتٍ."]],"2:169":[[3,1,"بِالسُّوءِ","الذَّنْبِ القَبِيحِ."],[4,1,"وَالْفَحْشَاءِ","المَعْصِيَةِ الْبَالِغَةِ القُبْح."]]}