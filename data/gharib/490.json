{"43:11":[[6,1,"بِقَدَرٍ","بِمِقْدَارٍ، وَوَزْنٍ مَعْلُومٍ."],[7,1,"فَأَنشَرْنَا","أَحْيَيْنَا."],[10,1,"مَّيْتًا","مُقْفِرَةً مِنَ النَّبَاتِ."]],"43:12":[[3,1,"الْأَزْوَاجَ","الأَصْنَافَ؛ مِنْ نَبَاتٍ، وَحَيَوَانٍ."],[8,1,"الْفُلْكِ","السُّفُنِ."]],"43:13":[[20,1,"مُقْرِنِينَ","مُطِيقِينَ."]],"43:15":[[5,1,"جُزْءًا","نَصِيبًا."],[8,1,"لَكَفُورٌ","لَجَحُودٌ لِنِعَمِ رَبِّهِ."]],"43:16":[[6,1,"وَأَصْفَاكُم","خَصَّكُمْ."]],"43:17":[[4,4,"بِمَا ضَرَبَ لِلرَّحْمَنِ مَثَلًا","بِالأُنْثَى الَّتِي نَسَبَهَا لِلرَّحْمَنِ؛ حِينَ زَعَمَ أَنَّ المَلَائِكَةَ بَنَاتُ اللهِ."],[8,1,"ظَلَّ","صَارَ."],[12,1,"كَظِيمٌ","مُمْتَلِئٌ حُزْنًا، وَغَمًّا."]],"43:18":[[2,1,"يُنَشَّأُ","يُرَبَّى."],[4,1,"الْحِلْيَةِ","الزِّينَةِ."],[7,1,"الْخِصَامِ","الجِدَالِ."],[8,2,"غَيْرُ مُبِينٍ","غَيْرُ وَاضِحٍ، وَبَيِّنٍ."]],"43:20":[[15,1,"يَخْرُصُونَ","يَتَقَوَّلُونَ عَلَى اللهِ الكَذِبَ."]],"43:22":[[7,1,"أُمَّةٍ","طَرِيقَةٍ، وَدِينٍ."]]}