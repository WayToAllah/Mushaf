{"54:50":[[3,2,"إِلَّا وَاحِدَةٌ","إِلَّا قَوْلَةٌ وَاحِدَةٌ، وَهِيَ: «كُنْ» ."],[5,2,"كَلَمْحٍ بِالْبَصَرِ","سَرِيعٍ لَا يَتَأَخَّرُ كَطَرْفَةِ العَيْنِ."]],"54:51":[[3,1,"أَشْيَاعَكُمْ","أَشْبَاهَكُمْ فِي الكُفْرِ."],[6,1,"مُّدَّكِرٍ","مُتَّعِظٍ."]],"54:52":[[4,2,"فِي الزُّبُرِ","مَكْتُوبٌ فيِ الكُتُبِ الَّتِي بِيَدِ الحَفَظَةِ."]],"54:53":[[4,1,"مُسْتَطَرٌ","مَسْطُورٌ مَكْتُوبٌ فِي صَحَائِفِ أَعْمَالِهِمْ."]],"54:54":[[5,1,"وَنَهَرٍ","أَنْهَارٍ."]],"54:55":[[2,2,"مَقْعَدِ صِدْقٍ","مَجْلِسِ حَقٍّ؛ لَا لَغْوَ فِيهِ، وَلَا تَاثِيمَ."]],"55:4":[[2,1,"الْبَيَانَ","النُّطْقَ بِأَنْ يُبِينَ عَمَّا فِي نَفْسِهِ بِالنُّطْقِ."]],"55:5":[[3,1,"بِحُسْبَانٍ","يَجْرِيَانِ مُتَعَاقِبَيْنِ، بِحِسَابٍ مُتْقَنٍ لَا يَضْطَرِبُ."]],"55:6":[[1,1,"وَالنَّجْمُ","الكَوْكَبُ فِي السَّمَاءِ."]],"55:7":[[3,2,"وَوَضَعَ الْمِيزَانَ","وَضَعَ فِي الأَرْضِ العَدْلَ."]],"55:8":[[1,2,"أَلَّا تَطْغَوْا","لِئَلَّا تَعْتَدُوا، وَتَخُونُوا."]],"55:9":[[3,1,"بِالْقِسْطِ","بِالعَدْلِ."],[4,2,"وَلَا تُخْسِرُوا","وَلَا تَنْقُصُوا."]],"55:10":[[2,2,"وَضَعَهَا لِلْأَنَامِ","مَهَّدَهَا؛ لِيَسْتَقِرَّ عَلَيْهَا الخَلْقُ."]],"55:11":[[5,1,"الْأَكْمَامِ","الأَوْعِيَةِ الَّتِي يَكُونُ مِنْهَا التَّمْرُ."]],"55:12":[[1,3,"وَالْحَبُّ ذُو الْعَصْفِ","وَفِيهَا الحَبُّ ذُو القِشْرِ وَالتِّبْنِ؛ رِزْقًا لَكُمْ وَلِأَنْعَامِكُمْ."],[4,1,"وَالرَّيْحَانُ","كُلُّ نَبْتٍ طَيِّبِ الرَّائِحَةِ."]],"55:14":[[2,1,"الْإِنسَانَ","آدَمَ - عليه السلام -."],[4,1,"صَلْصَالٍ","طِينٍ يَابِسٍ يُسْمَعُ لَهُ صَلْصَلَةٌ."],[5,1,"كَالْفَخَّارِ","هُوَ الطِّينُ الَّذِي يُطْبَخُ لِيَتَحَجَّرَ."]],"55:15":[[2,1,"الْجَانَّ","إِبْلِيسَ."],[4,3,"مَّارِجٍ مِّن نَّارٍ","لَهَبِ النَّارِ المُخْتَلِطِ بَعْضُهُ بِبَعْضٍ."]],"55:16":[[2,2,"آلَاءِ رَبِّكُمَا","نِعَمِ رَبِّكُمَا."],[4,1,"تُكَذِّبَانِ","يَا مَعْشَرَ الإِنْسِ وَالِجنِّ."]],"55:17":[[2,1,"الْمَشْرِقَيْنِ","مَشْرِقِ الشَّمْسِ؛ فِي الشِّتَاءِ، وَالصَّيْفِ."],[4,1,"الْمَغْرِبَيْنِ","مَغْرِبِ الشَّمْسِ؛ فِي الشِّتَاءِ، وَالصَّيْفِ."]]}