{"39:75":[[3,1,"حَافِّينَ","مُحْدِقِينَ، وَمُحِيطِينَ."],[10,3,"وَقُضِيَ بَيْنَهُم بِالْحَقِّ","حُكِمَ بَيْنَ الخَلَائِقِ بِالعَدْلِ."]],"40:3":[[7,2,"ذِي الطَّوْلِ","صَاحِبِ الإِنْعَامِ وَالتَّفَضُّلِ."],[14,1,"الْمَصِيرُ","المَرْجِعُ."]],"40:4":[[9,2,"فَلَا يَغْرُرْكَ","فَلَا يَخْدَعْكَ."],[11,1,"تَقَلُّبُهُمْ","تَنَقُّلُهُمْ وَتَرَدُّدُهُمْ بِأَنْوَاعِ التِّجَارَاتِ وَالنَّعِيمِ."]],"40:5":[[5,1,"وَالْأَحْزَابُ","الأُمَمُ المُتَحَزِّبَةُ عَلَى رُسُلِهِمْ، مُعْلِنِينَ الحَرْبَ عَلَيْهِمْ."],[12,1,"لِيَاخُذُوهُ","لِيَقْتُلُوهُ."],[15,1,"لِيُدْحِضُوا","لِيُبْطِلُوا."]],"40:6":[[2,1,"حَقَّتْ","وَجَبَتْ."]],"40:7":[[24,1,"سَبِيلَكَ","طَرِيقَكَ؛ وَهُوَ الإِسْلَامُ."],[25,1,"وَقِهِمْ","جَنِّبْهُمْ."]]}