{"84:25":[[8,2,"غَيْرُ مَمْنُونٍ","غَيْرُ مَقْطُوعٍ، وَلَا مَنْقُوصٍ."]],"85:1":[[2,2,"ذَاتِ الْبُرُوجِ","ذَاتِ المَنَازِلِ الَّتِي تَمُرُّ بِهَا الشَّمْسُ، وَالقَمَرُ."]],"85:2":[[1,2,"وَالْيَوْمِ الْمَوْعُودِ","هُوَ: يَوْمُ القِيَامَةِ."]],"85:3":[[1,2,"وَشَاهِدٍ وَمَشْهُودٍ","أَقْسَمَ اللهُ بِكُلِّ شَاهِدٍ يَشْهَدُ، وَبِكُلِّ مَنْ يُشْهَدُ عَلَيْهِ."]],"85:4":[[1,1,"قُتِلَ","لُعِنَ، وَعُذِّبَ، وَهَلَكَ."],[2,2,"أَصْحَابُ الْأُخْدُودِ","الَّذِينَ شَقُّوا فِي الأَرْضِ شَقًّا عَظِيمًا؛ لِإِحْرَاقِ المُؤْمِنِينَ."]],"85:5":[[3,1,"الْوَقُودِ","مَا تُشْعَلُ وَتُوقَدُ بِهِ النَّارُ."]],"85:7":[[6,1,"شُهُودٌ","حُضُورٌ."]],"85:10":[[3,1,"فَتَنُوا","حَرَّقُوا بِالنَّارِ."],[13,2,"عَذَابُ الْحَرِيقِ","العَذَابُ المُحْرِقُ."]],"85:12":[[2,1,"بَطْشَ","انْتِقَامَ."]],"85:13":[[3,1,"يُبْدِئُ","يَخْلُقُ الخَلْقَ ابْتِدَاءً."],[4,1,"وَيُعِيدُ","يُحْيِيهِمْ بَعْدَ مَوْتِهِمْ."]],"85:14":[[3,1,"الْوَدُودُ","المُحِبُّ لِأَوْلِيَائِهِ، المَحْبُوبُ لَهُمْ."]],"85:15":[[3,1,"الْمَجِيدُ","العَظِيمُ."]]}