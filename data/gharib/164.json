{"7:105":[[1,1,"حَقِيقٌ","جَدِيرٌ."]],"7:107":[[5,2,"ثُعْبَانٌ مُّبِينٌ","حَيَّةٌ عَظِيمَةٌ."]],"7:108":[[1,2,"وَنَزَعَ يَدَهُ","نَزَعَهَا مِنْ جَيْبِهِ، أَوْ جَنَاحِهِ."]],"7:111":[[2,1,"أَرْجِهْ","أَخِّرْهُ."]],"7:116":[[8,1,"وَاسْتَرْهَبُوهُمْ","خَوَّفُوهُمْ، وَأَرْهَبُوهُمْ."]],"7:119":[[3,1,"وَانقَلَبُوا","انْصَرَفُوا."],[4,1,"صَاغِرِينَ","أَذِلَّاءَ، مَقْهُورِينَ."]]}