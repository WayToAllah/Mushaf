{"11:54":[[4,1,"اعْتَرَاكَ","أَصَابَكَ."],[7,1,"بِسُوَءٍ","بِجُنُونٍ."]],"11:55":[[3,1,"فَكِيدُونِي","فَاجْتَهِدُوا فِي إِيصَالِ الضُّرِّ إِلَيَّ."],[5,3,"ثُمَّ لَا تُنْظِرُونِ","لَا تُمْهِلُونِي."]],"11:56":[[12,2,"آخِذٌ بِنَاصِيَتِهَا","مَالِكُهَا، وَالمُتَصَرِّفُ فِيهَا."]],"11:57":[[9,1,"وَيَسْتَخْلِفُ","يَاتِي بِقَوْمٍ آخَرِينَ يَخْلُفُونَكُمْ فِي دِيَارِكُمْ."],[21,1,"حَفِيظٌ","يَحْفَظُ مِنْ كُلِّ سُوءٍ."]],"11:58":[[14,1,"غَلِيظٍ","شَدِيدٍ."]],"11:59":[[11,1,"جَبَّارٍ","مُسْتَكْبِرٍ."],[12,1,"عَنِيدٍ","لَا يَقْبَلُ الحَقَّ."]],"11:61":[[15,1,"أَنشَأَكُمْ","ابْتَدَأَ خَلْقَكُمْ."],[18,2,"وَاسْتَعْمَرَكُمْ فِيهَا","جَعَلَكُمْ عُمَّارًا لَهَا."]],"11:62":[[4,3,"كُنتَ فِينَا مَرْجُوًّا","كُنَّا نَرْجُو أَنْ تَكُونَ سَيِّدًا."],[21,1,"مُرِيبٍ","مُوقِعٍ فِي الرَّيْبِ وَالشَّكِّ."]]}