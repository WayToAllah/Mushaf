{"4:20":[[9,1,"قِنطَارًا","مَالًا كَثِيرًا."],[15,1,"بُهْتَانًا","كَذِبًا، وَظُلْمًا."]],"4:21":[[4,1,"أَفْضَى","اسْتَمْتَعَ بِالْجِمَاعِ."]],"4:22":[[15,1,"وَمَقْتًا","بَغِيضًا يَمْقُتُ اللهُ فَاعِلَهُ."],[17,1,"سَبِيلًا","طَرِيقًا."]],"4:23":[[20,1,"وَرَبَائِبُكُمُ","بَنَاتُ نِسَائِكُمُ اللَّاتِي يَتَرَبَّيْنَ غَالِبًا فِي بُيُوتِكُمْ."],[37,1,"وَحَلَائِلُ","زَوْجَاتُ."]]}