{"23:75":[[8,1,"لَّلَجُّوا","لَتَمَادَوْا."],[11,1,"يَعْمَهُونَ","يَتَحَيَّرُونَ وَيَتَخَبَّطُونَ."]],"23:76":[[5,1,"اسْتَكَانُوا","خَضَعُوا."]],"23:77":[[12,1,"مُبْلِسُونَ","آيِسُونَ مِنْ كُلِّ خَيْرٍ مُتَحَيِّرُونَ."]],"23:79":[[3,1,"ذَرَأَكُمْ","خَلَقَكُمْ، وَبَثَّكُمْ."]],"23:88":[[8,1,"يُجِيرُ","يَحْمِي وَيُغِيثُ مَنْ يَشَاءُ."],[9,3,"وَلَا يُجَارُ عَلَيْهِ","لَا يُغَاثُ أَحَدٌ وَيُحْمَى مِنْهُ."]],"23:89":[[4,2,"فَأَنَّى تُسْحَرُونَ","فَكَيْفَ تَذْهَبُ عُقُولُكُمْ وَتُخْدَعُونَ عَنْ تَوْحِيدِهِ؟!"]]}