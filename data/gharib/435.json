{"35:5":[[7,2,"فَلَا تَغُرَّنَّكُمُ","لَا تَخْدَعَنَّكُمْ، وَلَا تُلْهِيَنَّكُمْ."],[14,1,"الْغَرُورُ","الشَّيْطَانُ."]],"35:6":[[9,1,"حِزْبَهُ","أَتْبَاعَهُ."]],"35:8":[[16,3,"فَلَا تَذْهَبْ نَفْسُكَ","فَلَا تُهْلِكْهَا."],[20,1,"حَسَرَاتٍ","حُزْنًا عَلَى كُفْرِ هَؤْلَاءِ الضَّالِّينَ."]],"35:9":[[5,1,"فَتُثِيرُ","تُحَرِّكُ."],[10,1,"مَّيِّتٍ","مُجْدِبٍ."]],"35:10":[[4,1,"الْعِزَّةَ","الشَّرَفَ، وَالمَنَعَةَ."],[10,2,"الْكَلِمُ الطَّيِّبُ","الكَلَامُ الحَسَنُ؛ وَهُوَ ذِكْرُ اللهِ."],[24,1,"يَبُورُ","يَفْسُدُ، وَيَبْطُلُ."]],"35:11":[[10,1,"أَزْوَاجًا","ذُكُورًا وَإِنَاثًا."],[22,1,"مُّعَمَّرٍ","طَوِيلِ العُمُرِ."],[28,2,"فِي كِتَابٍ","هُوَ: اللَّوْحُ المَحْفُوظُ."]]}