{"34:41":[[2,1,"سُبْحَانَكَ","نُنَزِّهُكَ."],[3,2,"أَنتَ وَلِيُّنَا","أَنْتَ الَّذِي نُوَالِيهِ وَنَعْبُدُهُ."]],"34:43":[[22,2,"إِفْكٌ مُّفْتَرًى","كَذِبٌ مُخْتَلَقٌ."]],"34:44":[[5,1,"يَدْرُسُونَهَا","يَقْرَؤُونَهَا."]],"34:45":[[7,3,"مِعْشَارَ مَا آتَيْنَاهُمْ","عُشْرَ مَا أَعْطَيْنَاهُمْ مِنَ القُوَّةِ وَالنِّعَمِ."],[14,1,"نَكِيرِ","إِنْكَارِي عَلَيهِمْ."]],"34:46":[[4,1,"بِوَاحِدَةٍ","بِخَصْلَةٍ وَاحِدَةٍ."],[8,1,"مَثْنَى","اثْنَيْنِ اثْنَيْنِ."],[15,1,"جِنَّةٍ","جُنُونٍ."]],"34:48":[[4,2,"يَقْذِفُ بِالْحَقِّ","يَرْمِي بِحُجَجِ الحَقِّ عَلَى البَاطِلِ؛ فَيَدْمَغُهُ."]]}