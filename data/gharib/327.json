{"21:58":[[2,1,"جُذَاذًا","قِطَعًا صَغِيرَةً."]],"21:61":[[4,3,"عَلَى أَعْيُنِ النَّاسِ","بِمَرْأًى مِنَ النَّاسِ."]],"21:65":[[2,3,"نُكِسُوا عَلَى رُؤُوسِهِمْ","رَجَعُوا إِلَى عِنَادِهِمْ."]],"21:67":[[1,2,"أُفٍّ لَّكُمْ","قُبْحًا لَكُمْ."]],"21:71":[[4,4,"الْأَرْضِ الَّتِي بَارَكْنَا فِيهَا","أَرْضِ الشَّامِ."]],"21:72":[[5,1,"نَافِلَةً","زِيَادَةً عَمَّا سَأَلَ."]]}