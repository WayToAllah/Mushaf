{"72:1":[[6,1,"نَفَرٌ","جَمَاعَةٌ."],[13,1,"عَجَبًا","يُتَعَجَّبُ مِنْهُ فِي فَصَاحَتِهِ، وَبَلَاغَتِهِ، وَمَعَانِيهِ."]],"72:2":[[3,1,"الرُّشْدِ","الحَقِّ، وَالهُدَى."]],"72:3":[[3,2,"جَدُّ رَبِّنَا","عَظَمَةُ رَبِّنَا، وَجَلَالُهُ، وَغِنَاهُ."],[7,1,"صَاحِبَةً","زَوْجَةً."]],"72:4":[[4,1,"سَفِيهُنَا","إِبْلِيسُ"],[7,1,"شَطَطًا","قَوْلًا بَعِيدًا عَنِ الحَقِّ مِنْ دَعْوَى الصَّاحِبَةِ وَالوَلَدِ."]],"72:6":[[6,1,"يَعُوذُونَ","يَسْتَجِيرُونَ، وَيَسْتَعِيذُونَ."],[11,1,"رَهَقًا","طُغْيانًا، وَسَفَهًا."]],"72:7":[[1,2,"وَأَنَّهُمْ ظَنُّوا","وَأَنَّ كُفَّارَ الإِنْسِ حَسِبُوا."]],"72:8":[[2,2,"لَمَسْنَا السَّمَاءَ","طَلَبْنَا بُلُوغَ السَّمَاءِ؛ لِاسْتِرَاقِ السَّمْعِ."],[8,1,"وَشُهُبًا","نُجُومًا مُحْرِقَةً؛ وَذَلِكَ لَمَّا بُعِثَ النَّبِيُّ - صلى الله عليه وسلم -."]],"72:9":[[5,2,"مَقَاعِدَ لِلسَّمْعِ","مَوَاضِعَ؛ لِنَسْتَمِعَ إِلَى أَخْبَارِهَا."],[13,1,"رَّصَدًا","أُرْصِدَ لَهُ؛ لِيُرْمَى بِهِ."]],"72:10":[[13,1,"رَشَدًا","خَيْرًا، وَصَلَاحًا، وَرَحْمَةً."]],"72:11":[[8,2,"طَرَائِقَ قِدَدًا","فِرَقًا وَمَذَاهِبَ مُخْتَلِفَةً."]],"72:12":[[2,1,"ظَنَنَّا","أَيْقَنَّا."],[4,3,"لَّن نُّعجِزَ اللَّهَ","لَنْ نَفُوتَهُ، وَنُفْلِتَ مِنْ قَبْضَتِهِ."]],"72:13":[[12,1,"بَخْسًا","نُقْصَانًا مِنْ حَسَنَاتِهِ."],[13,2,"وَلَا رَهَقًا","وَلَا ظُلْمًا يَلْحَقُهُ بِزِيَادَةٍ فِي سَيِّئَاتِهِ."]]}