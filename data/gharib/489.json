{"42:52":[[4,1,"رُوحًا","قُرْآنًا، سُمِّيَ القُرْآنُ رُوحًا؛ لِأَنَّهُ حَيَاةُ القُلُوبِ."],[26,2,"صِرَاطٍ مُّسْتَقِيمٍ","هُوَ: الإِسْلَامُ."]],"42:53":[[14,1,"تَصِيرُ","تَرْجِعُ إِلَيْهِ، فَيُجَازِيكُمْ عَلَيْهَا."]],"43:4":[[3,2,"أُمِّ الْكِتَابِ","اللَّوْحِ المَحْفُوظِ."],[6,1,"لَعَلِيٌّ","رَفِيعُ الشَّانِ."],[7,1,"حَكِيمٌ","مُحْكَمٌ، وَذُو حِكْمَةٍ بَالِغَةٍ."]],"43:5":[[1,4,"أَفَنَضْرِبُ عَنكُمُ الذِّكْرَ صَفْحًا","أَفَنُعْرِضُ عَنْكُمْ، وَنَتْرُكُ تَذْكِيرَكُمْ بِالقُرْآنِ؟!"],[5,2,"أَن كُنتُمْ","بِسَبَبِ أَنْ كُنْتُمْ."]],"43:6":[[1,2,"وَكَمْ أَرْسَلْنَا","كَثِيرًا مِنَ الأَنْبِيَاءِ أَرْسَلْنَا."]],"43:8":[[4,1,"بَطْشًا","قُوَّةً."],[5,3,"وَمَضَى مَثَلُ الْأَوَّلِينَ","سَبَقَ فيِ القُرْآنِ أَحَادِيثُ إِهْلَاكِهِمْ."]],"43:10":[[5,1,"مَهْدًا","فِرَاشًا مُمَهَّدًا."],[9,1,"سُبُلًا","طُرُقًا لِمَعَاشِكُمْ تَسْلُكُونَهَا."]]}