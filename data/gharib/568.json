{"69:36":[[5,1,"غِسْلِينٍ","صَدِيدِ أَهْلِ النَّارِ."]],"69:37":[[4,1,"الْخَاطِئُونَ","المُذْنِبُونَ، المُصِرُّونَ عَلَى الكُفْرِ."]],"69:38":[[1,2,"فَلَا أُقْسِمُ","أُقْسِمُ، وَ (لَا) : لِتَاكِيدِ القَسَمِ."]],"69:42":[[2,2,"بِقَوْلِ كَاهِنٍ","بِسَجْعٍ كَسَجَعِ الكُهَّانِ الَّذِينَ يَدَّعُونَ عِلْمَ المُغَيَّبَاتِ."]],"69:44":[[2,1,"تَقَوَّلَ","اخْتَلَقَ، وَافْتَرى عَلَيْنَا."]],"69:46":[[4,1,"الْوَتِينَ","نِيَاطَ القَلْبِ، وَهُوَ: عِرْقٌ مُتَّصِلٌ بِهِ إِذَا قُطِعَ مَاتَ صَاحِبُهُ."]],"69:47":[[6,1,"حَاجِزِينَ","مَانِعِينَ الهَلَاكَ وَالعِقَابَ عَنْهُ."]],"69:50":[[2,1,"لَحَسْرَةٌ","لَنَدَامَةٌ عَظِيمَةٌ."]],"69:52":[[1,3,"فَسَبِّحْ بِاسْمِ رَبِّكَ","فَنَزِّهْ رَبَّكَ عَمَّا لَا يَلِيقُ بِهِ ذَاكِرًا اسْمَهُ."]],"70:1":[[1,2,"سَأَلَ سَائِلٌ","دَعَا دَاعٍ."],[3,2,"بِعَذَابٍ وَاقِعٍ","بِوُقُوعِ العَذَابِ عَلَيْهِمْ."]],"70:3":[[3,2,"ذِي الْمَعَارِجِ","صَاحِبِ العُلُوِّ وَالجَلَالِ."]],"70:4":[[1,1,"تَعْرُجُ","تَصْعَدُ."],[3,1,"وَالرُّوحُ","جِبْرِيلُ - عليه السلام -."]],"70:5":[[2,2,"صَبْرًا جَمِيلًا","لَا جَزَعَ فِيهِ، وَلَا شَكْوَى مِنْهُ لِغَيْرِ اللهِ."]],"70:8":[[4,1,"كَالْمُهْلِ","مِثْلَ حُثَالَةِ الزَّيْتِ."]],"70:9":[[3,1,"كَالْعِهْنِ","كَالصُّوفِ المَصْبُوغِ المَنْفُوشِ الَّذِي ذَرَتْهُ الرِّيحُ."]],"70:10":[[3,1,"حَمِيمٌ","قَرِيبٌ."]]}