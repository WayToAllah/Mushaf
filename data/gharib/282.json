{"17:1":[[1,1,"سُبْحَانَ","تَنْزِيهًا للِه، وَتَعَجُّبَا مِنْ قُدْرَتِهِ."]],"17:2":[[12,1,"وَكِيلًا","مَعْبُودًا تُفَوِّضُونَ أُمُورَكُمْ إِلَيْهِ."]],"17:4":[[1,1,"وَقَضَيْنَا","أَخْبَرْنَا، وَأَوْحَيْنَا."]],"17:5":[[9,2,"أُوْلِي بَاسٍ","ذَوِي شَجَاعَةٍ وَقُوَّةٍ."],[12,1,"فَجَاسُوا","فَطَافُوا."],[13,2,"خِلَالَ الدِّيَارِ","وَسَطَهَا."]],"17:6":[[4,1,"الْكَرَّةَ","الغَلَبَةَ وَالظُّهُورَ."],[11,1,"نَفِيرًا","عَدَدًا."]],"17:7":[[10,2,"وَعْدُ الآخِرَةِ","مَوْعِدُ الإِفْسَادِ الثَّانِي."],[12,1,"لِيَسُوؤُوا","لِيُذِلُّوا، وَيُهِينُوا."],[15,1,"الْمَسْجِدَ","بَيْتَ المَقْدِسِ."],[20,1,"وَلِيُتَبِّرُوا","لِيُدَمِّرُوا."],[21,2,"مَا عَلَوْا","مَا وَقَعَ تَحْتَ أَيْدِيهِمْ."],[23,1,"تَتْبِيرًا","تَدْمِيرًا كَامِلًا."]]}