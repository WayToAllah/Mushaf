{"38:43":[[4,2,"وَمِثْلَهُم مَّعَهُمْ","زِدْنَاهُ مِثْلَهُمْ مَعَهُمْ."],[9,2,"لِأُوْلِي الْأَلْبَابِ","لِأَصْحَابِ العُقُولِ السَّلِيمَةِ."]],"38:44":[[3,1,"ضِغْثًا","حُزْمَةَ شَمَارِيخَ أَوْ قَبْضَةَ حَشِيشٍ."],[6,2,"وَلَا تَحْنَثْ","لَا تَنْقُضْ يَمِينَكَ الَّتِي حَلَفْتَهَا بِضَرْبِ زَوْجَتِكَ."],[14,1,"أَوَّابٌ","رَجَّاعٌ إِلَى طَاعَةِ اللهِ."]],"38:45":[[6,2,"أُوْلِي الْأَيْدِي","أَصْحَابَ القُوَّةِ فيِ الطَّاعَةِ."],[8,1,"وَالْأَبْصَارِ","البَصِيرَةِ فيِ الدِّينِ."]],"38:46":[[2,2,"أَخْلَصْنَاهُم بِخَالِصَةٍ","خَصَصْنَاهُمْ بِخَصْلَةٍ عَظِيمَةٍ."],[4,2,"ذِكْرَى الدَّارِ","تَذَكُّرُ الآخِرَةِ فيِ قُلُوبِهِمْ."]],"38:47":[[4,1,"الْمُصْطَفَيْنَ","المُخْتَارِينَ."]],"38:49":[[5,2,"لَحُسْنَ مَآبٍ","حُسْنَ مَرْجِعٍ فيِ الآخِرَةِ."]],"38:52":[[2,2,"قَاصِرَاتُ الطَّرْفِ","لَا يَنْظُرْنَ إِلَى غَيْرِ أَزْوَاجِهِنَّ."],[4,1,"أَتْرَابٌ","مُتَسَاوِيَاتُ السِّنِّ."]],"38:54":[[7,1,"نَّفَادٍ","انْقِطَاعٍ."]],"38:55":[[4,2,"لَشَرَّ مَآبٍ","أَسْوَأَ مَرْجعٍ فِي الآخِرَةِ."]],"38:56":[[2,1,"يَصْلَوْنَهَا","يَدْخُلُونَهَا وَيُقَاسُونَ حَرَّهَا."],[4,1,"الْمِهَادُ","الفِرَاشُ."]],"38:57":[[3,1,"حَمِيمٌ","مَاءٌ شَدِيدُ الحَرَارَةِ."],[4,1,"وَغَسَّاقٌ","صَدِيدٌ سَائِلٌ مِنْ أَجْسَادِ أَهْلِ النَّارِ."]],"38:58":[[1,1,"وَآخَرُ","عَذَابٌ آخَرُ."],[2,2,"مِن شَكْلِهِ","مِنْ مِثْلِهِ."],[4,1,"أَزْوَاجٌ","أَصْنَافٌ، وَأَلْوَانٌ."]],"38:59":[[2,1,"فَوْجٌ","جَمَاعَةٌ مِنْ أَهْلِ النَّارِ."],[3,2,"مُّقْتَحِمٌ مَّعَكُمْ","دَاخِلَةٌ النَّارَ مَعَكُمْ."],[5,3,"لَا مَرْحَبًا بِهِمْ","لَا رَحَّبَتْ بِهِمْ النَّارُ؛ وَلَا اتَّسَعَتْ مَنَازِلُهُمْ فِيهَا."],[9,2,"صَالُوا النَّارِ","مُقَاسُو حَرِّهَا."]],"38:60":[[11,1,"الْقَرَارُ","المَقَرُّ."]],"38:61":[[9,1,"ضِعْفًا","مُضَاعَفًا."]]}