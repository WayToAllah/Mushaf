{"4:80":[[12,1,"حَفِيظًا","حَافِظًا، رَقِيبًا."]],"4:81":[[7,2,"بَيَّتَ طَائِفَةٌ","دَبَّرَتْ بِلَيْلٍ."]],"4:83":[[8,2,"أَذَاعُوا بِهِ","أَفْشَوْهُ."]],"4:84":[[22,1,"تَنكِيلًا","عُقُوبَةً."]],"4:85":[[15,1,"كِفْلٌ","نَصِيبٌ مِنْ وِزْرِهَا."],[22,1,"مُّقِيتًا","شَاهِدًا، وَحَفِيظًا."]],"4:86":[[15,1,"حَسِيبًا","مُجَازِيًا، وَمُحَاسِبًا."]]}