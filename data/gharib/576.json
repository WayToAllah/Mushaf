{"74:19":[[1,1,"فَقُتِلَ","غُلِبَ وَقُهِرَ."]],"74:21":[[2,1,"نَظَرَ","تَأَمَّلَ فِيمَا هَيَّأَ مِنَ الطَّعْنِ."]],"74:22":[[2,1,"عَبَسَ","قَطَّبُ وَجْهَهُ."],[3,1,"وَبَسَرَ","اشْتَدَّ فيِ العُبُوسِ لَمَّا ضَاقَتْ عَلَيْهِ الحِيَلُ فِي الطَّعْنِ."]],"74:23":[[2,1,"أَدْبَرَ","رَجَعَ مُعْرِضًا عَنِ الحَقِّ."]],"74:24":[[6,1,"يُؤْثَرُ","يُنْقَلُ عَنِ الأَوَّلِينَ."]],"74:26":[[1,2,"سَأُصْلِيهِ سَقَرَ","سَأُدْخِلُهُ جَهَنَّمَ؛ كَيْ يَصْلَى حَرَّهَا."]],"74:28":[[1,2,"لَا تُبْقِي","لَا تَتْرُكُ لَحْمًا."],[3,2,"وَلَا تَذَرُ","لَا تَتْرُكُ عَظْمًا."]],"74:29":[[1,2,"لَوَّاحَةٌ لِّلْبَشَرِ","مُحْرِقَةٌ لِلْجُلُودِ، مُغَيِّرَةٌ لِلْبَشَرَةِ."]],"74:31":[[11,1,"فِتْنَةً","اخْتِبَارًا لِلْكُفَّارِ."],[22,2,"وَلَا يَرْتَابَ","لَا يَشُكَّ."],[32,1,"مَّرَضٌ","نِفَاقٌ."],[49,2,"جُنُودَ رَبِّكَ","مَلَائِكَتَهُ."]],"74:35":[[1,3,"إِنَّهَا لَإِحْدَى الْكُبَرِ","إِنَّ النَّارَ لَإِحْدَى العَظَائِمِ."]],"74:38":[[5,1,"رَهِينَةٌ","مَحْبُوسَةٌ بِعَمَلِهَا."]],"74:42":[[1,2,"مَا سَلَكَكُمْ","مَا أَدْخَلَكُمْ."]],"74:45":[[2,1,"نَخُوضُ","نَتَحَدَّثُ بِالبَاطِلِ."]],"74:47":[[3,1,"الْيَقِينُ","المُوْتُ."]]}